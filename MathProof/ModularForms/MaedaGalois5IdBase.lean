theorem theta_e1 {K : Type*} [CommRing K] (x : Fin 5 → K) :
    (theta x ![4,0,1,2,3]) * (theta x ![3,4,0,1,2]) + (theta x ![4,0,3,1,2]) * (theta x
    ![2,4,1,0,3]) + (theta x ![4,2,0,1,3]) * (theta x ![3,0,4,2,1]) + (theta x ![4,2,3,0,1]) *
    (theta x ![1,3,0,4,2]) + (theta x ![4,3,0,2,1]) * (theta x ![1,2,4,0,3]) + (theta x
    ![4,3,1,0,2]) * (theta x ![2,0,3,4,1]) = -(-4 * va x * vc x + 10 * vd x) := by
  calc (theta x ![4,0,1,2,3]) * (theta x ![3,4,0,1,2]) + (theta x ![4,0,3,1,2]) * (theta x
    ![2,4,1,0,3]) + (theta x ![4,2,0,1,3]) * (theta x ![3,0,4,2,1]) + (theta x ![4,2,3,0,1]) *
    (theta x ![1,3,0,4,2]) + (theta x ![4,3,0,2,1]) * (theta x ![1,2,4,0,3]) + (theta x
    ![4,3,1,0,2]) * (theta x ![2,0,3,4,1]) = PEval e1LHS x := (e1lhs_eval x).symm
    _ = PEval e1RHS x := by rw [e1dec]
    _ = ((vd x) * ((-10 : K))) + (va x) * ((vc x) * ((4 : K))) := e1rhs_eval x
    _ = -(-4 * va x * vc x + 10 * vd x) := by ring

