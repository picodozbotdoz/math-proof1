/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [65, 30, 49, 3, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 83)) = RabinCert.toPoly 83 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((1048411007280 : ℤ) : ZMod 83) = (3 : ZMod 83) from by decide +kernel,
      show ((-43904188642057665884936352 : ℤ) : ZMod 83) = (49 : ZMod 83) from by decide +kernel,
      show ((-61295736917693756611101325132020430080 : ℤ) : ZMod 83)
           = (30 : ZMod 83) from by decide +kernel,
      show ((155994269592549015372230825386472486974700379115776 : ℤ) : ZMod 83)
           = (65 : ZMod 83) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 83 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 83 fr).natDegree = 4 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 83 ^ 4 < 2 ^ 26 := by norm_num

lemma h1 : RabinCert.zpxw 83 fr (RabinCert.bitsOf 26 (83 ^ 4)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 83 w fr
      (RabinCert.zpxwsubX 83 fr 26 (83 ^ (4 / 2))) = [1] :=
  ⟨9, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 4 → ∃ w : ℕ,
      RabinCert.zpgcd 83 w fr
      (RabinCert.zpxwsubX 83 fr 26 (83 ^ (4 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 4 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
