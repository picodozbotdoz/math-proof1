  | 0, 0 => (1342116 : ℂ)
  | 0, 1 => (-172348484038848 : ℂ)
  | 0, 2 => (1570039466323267875325917456 : ℂ)
  | 0, 3 => (-2247001925408094557980228608 : ℂ)
