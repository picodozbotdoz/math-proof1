  eval_det

/-- `det (t·1 − M)` at `t = 2`, by the certified Bareiss echelon decomposition. -/
theorem det_2 : (Matrix.scalar (Fin 3) (2 : ℤ) - M).det = -21175292394292767530041000 := by
