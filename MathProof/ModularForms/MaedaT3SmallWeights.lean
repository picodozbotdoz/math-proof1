/-- The basis as an ℕ-indexed function (concrete indices reduce by `rfl`; the
catch-all is never used: `charpoly_dimN` only reads `fb i` for `i < n`). -/
noncomputable def fb : ℕ → CuspForm 𝒮ℒ ((44 : ℕ) : ℤ)
  | 0 => f1
  | 1 => f2
  | 2 => f3
  | _ => 0

/-- `Atab i j` = coefficient of `q^(j+1)` in `f i` for `i < j` (0 elsewhere). -/
def Atab : ℕ → ℕ → ℂ
  | 0, 1 => (1896 : ℂ)
  | 0, 2 => (1584252 : ℂ)
  | 1, 2 => (1152 : ℂ)
  | _, _ => 0

/-- `Xtab i m` = coefficient of `q^(m+1)` in `T₃ (f i)`. -/
def Xtab : ℕ → ℕ → ℂ
  | 0, 0 => (1584252 : ℂ)
  | 0, 1 => (47324878173792 : ℂ)
  | 0, 2 => (355377631469328063504 : ℂ)
  | 1, 0 => (1152 : ℂ)
  | 1, 1 => (13881322620 : ℂ)
  | 1, 2 => (-82636458992640 : ℂ)
  | 2, 0 => (1 : ℂ)
  | 2, 1 => (-2270208 : ℂ)
  | 2, 2 => (7904835576 : ℂ)
  | _, _ => 0

lemma finrank_eq : Module.finrank ℂ (CuspForm 𝒮ℒ ((44 : ℕ) : ℤ)) = 3 := by
  apply Module.finrank_eq_of_rank_eq
  rw [CuspForm.discriminantEquiv.rank_eq]
  have h := ModularForm.dimension_level_one 32 (by decide)
  norm_num [Nat.ModEq] at h
  exact_mod_cast h

/-- `charpoly_dimN` hypothesis: the basis is in echelon form (zeros). -/
lemma hzero : ∀ (i m : ℕ), i < 3 → 1 ≤ m → m ≤ i →
    (qExpansion 1 (fb i)).coeff m = (0 : ℂ) := by
  intro i m hi h1 h2
  interval_cases i
  · simp only [fb]
    exact (by omega : False).elim
  · simp only [fb]
    interval_cases m
    · rw [c2, seqP_getD (N := 10) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c3, seqP_getD (N := 10) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c3, seqP_getD (N := 10) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]

/-- `charpoly_dimN` hypothesis: the diagonal is `1`. -/
lemma hone : ∀ i : ℕ, i < 3 → (qExpansion 1 (fb i)).coeff (i + 1) = (1 : ℂ) := by
  intro i hi
  interval_cases i
  · simp only [fb]
    exact q1_1
  · simp only [fb]
    exact q2_2
  · simp only [fb]
    exact q3_3

/-- `charpoly_dimN` hypothesis: the strict upper coefficients. -/
lemma hA : ∀ (i j : ℕ), i < j → j < 3 →
    (qExpansion 1 (fb i)).coeff (j + 1) = Atab i j := by
  intro i j hij hjn
  have hib : i < 3 := by omega
  interval_cases i
  · simp only [fb]
    interval_cases j
    · rw [c1, seqP_getD (N := 10) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
    · rw [c1, seqP_getD (N := 10) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
  · simp only [fb]
    interval_cases j
    · rw [c2, seqP_getD (N := 10) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
  · simp only [fb]
    interval_cases j

/-- `charpoly_dimN` hypothesis: the T₃-image coefficients. -/
lemma hX : ∀ (i m : ℕ), i < 3 → m < 3 →
    (qExpansion 1 (T3 (fb i))).coeff (m + 1) = Xtab i m := by
  intro i m hi hm
  interval_cases i
  · simp only [fb]
    interval_cases m
    · rw [t1_1]
      rfl
    · rw [t1_2]
      rfl
    · rw [t1_3]
      rfl
  · simp only [fb]
    interval_cases m
    · rw [t2_1]
      rfl
    · rw [t2_2]
      rfl
    · rw [t2_3]
      rfl
  · simp only [fb]
    interval_cases m
    · rw [t3_1]
      rfl
    · rw [t3_2]
      rfl
    · rw [t3_3]
      rfl

/-- The matrix of `T₃` in the echelon basis (census data, regression-checked). -/
def M : Matrix (Fin 3) (Fin 3) ℤ :=
      !![1584252, 1152, 1;
      47321874432000, 13879138428, -2272104;
      355323114160128000000, -98627051520000, 10520715132]

/-- The translated matrices `t·1 − M`, as an explicit literal (symbolic in `t`). -/
def MT (t : ℤ) : Matrix (Fin 3) (Fin 3) ℤ :=
      !![t - 1584252, (-1152), (-1);
      (-47321874432000), t - 13879138428, (2272104);
      (-355323114160128000000), (98627051520000), t - 10520715132]

/-- One-time symbolic bridge, reused by all determinant lemmas. -/
theorem scalar_sub_M (t : ℤ) : Matrix.scalar (Fin 3) t - M = MT t := by
  ext a b
  simp only [Matrix.scalar_apply, Matrix.diagonal_apply, Matrix.sub_apply, M, MT]
  fin_cases a <;> fin_cases b <;> simp

/-- The characteristic polynomial of `T₃` (descending literal). -/
noncomputable def P : ℤ[X] :=
  C (1) * (X : ℤ[X]) ^ 3 + - C (24401437812) * (X : ℤ[X]) ^ 2 +
      - C (433411430030887314384) * (X : ℤ[X]) ^ 1 + C (5866988517623967326564020435008)

theorem P_natDegree : P.natDegree = 3 := by unfold P; compute_degree!

theorem P_monic : P.Monic := by unfold P; monicity!

/-- `det (t·1 − M)` at `t = 0`, by the certified Bareiss echelon decomposition. -/
theorem det_0 : (Matrix.scalar (Fin 3) (0 : ℤ) - M).det = 5866988517623967326564020435008 := by
  rw [scalar_sub_M]
  simp only [MT]
  eval_det

/-- `det (t·1 − M)` at `t = 1`, by the certified Bareiss echelon decomposition. -/
theorem det_1 : (Matrix.scalar (Fin 3) (1 : ℤ) - M).det = 5866988517190555896508731682813 := by
  rw [scalar_sub_M]
  simp only [MT]
  eval_det

/-- `det (t·1 − M)` at `t = 2`, by the certified Bareiss echelon decomposition. -/
theorem det_2 : (Matrix.scalar (Fin 3) (2 : ℤ) - M).det = 5866988516757144466404640055000 := by
  rw [scalar_sub_M]
  simp only [MT]
  eval_det

/-- `det (t·1 − M)` at `t = 3`, by the certified Bareiss echelon decomposition. -/
theorem det_3 : (Matrix.scalar (Fin 3) (3 : ℤ) - M).det = 5866988516323733036251745551575 := by
  rw [scalar_sub_M]
  simp only [MT]
  eval_det

theorem ev_0 : P.eval (0 : ℤ) = 5866988517623967326564020435008 := by
  norm_num [P, Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_mul,
      Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_neg]

theorem ev_1 : P.eval (1 : ℤ) = 5866988517190555896508731682813 := by
  norm_num [P, Polynomial.eval_add, Polynomial.eval_sub, Polynomial.eval_mul,
      Polynomial.eval_pow, Polynomial.eval_C, Polynomial.eval_X, Polynomial.eval_neg]

