/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [2, 37, 0, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 41)) = RabinCert.toPoly 41 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((10820953044 : ℤ) : ZMod 41) = (0 : ZMod 41) from by decide +kernel,
      show ((-2801484230995686096 : ℤ) : ZMod 41) = (37 : ZMod 41) from by decide +kernel,
      show ((-203212914080074439921138332224 : ℤ) : ZMod 41)
           = (2 : ZMod 41) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 41 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 41 fr).natDegree = 3 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 41 ^ 3 < 2 ^ 17 := by norm_num

lemma h1 : RabinCert.zpxw 41 fr (RabinCert.bitsOf 17 (41 ^ 3)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_3 : ∃ w : ℕ, RabinCert.zpgcd 41 w fr
      (RabinCert.zpxwsubX 41 fr 17 (41 ^ (3 / 3))) = [1] :=
  ⟨8, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 3 → ∃ w : ℕ,
      RabinCert.zpgcd 41 w fr
      (RabinCert.zpxwsubX 41 fr 17 (41 ^ (3 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 3 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact h2_3

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [25, 38, 23, 1]

lemma h1_2 : RabinCert.zpxw 47 fr2 (RabinCert.bitsOf 17 (47 ^ 3)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 41) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

