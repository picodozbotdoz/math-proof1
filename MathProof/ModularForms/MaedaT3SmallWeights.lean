  | 0 => f1
  | 1 => f2
  | 2 => f3
  | _ => 0

/-- `Atab i j` = coefficient of `q^(j+1)` in `f i` for `i < j` (0 elsewhere). -/
def Atab : ℕ → ℕ → ℂ
  | 0, 1 => (912 : ℂ)
  | 0, 2 => (112356 : ℂ)
  | 1, 2 => (168 : ℂ)
  | _, _ => 0

/-- `Xtab i m` = coefficient of `q^(m+1)` in `T₃ (f i)`. -/
def Xtab : ℕ → ℕ → ℂ
  | 0, 0 => (112356 : ℂ)
  | 0, 1 => (-24743751611328 : ℂ)
  | 0, 2 => (27844897531666430736 : ℂ)
  | 1, 0 => (168 : ℂ)
  | 1, 1 => (-7334312220 : ℂ)
  | 1, 2 => (-3498533173440 : ℂ)
  | 2, 0 => (1 : ℂ)
  | 2, 1 => (-231936 : ℂ)
  | 2, 2 => (-3525606072 : ℂ)
  | _, _ => 0

lemma finrank_eq : Module.finrank ℂ (CuspForm 𝒮ℒ ((42 : ℕ) : ℤ)) = 3 := by
  apply Module.finrank_eq_of_rank_eq
  rw [CuspForm.discriminantEquiv.rank_eq]
  have h := ModularForm.dimension_level_one 30 (by decide)
  norm_num [Nat.ModEq] at h
  exact_mod_cast h

/-- `charpoly_dimN` hypothesis: the basis is in echelon form (zeros). -/
lemma hzero : ∀ (i m : ℕ), i < 3 → 1 ≤ m → m ≤ i →
    (qExpansion 1 (fb i)).coeff m = (0 : ℂ) := by
  intro i m hi h1 h2
  interval_cases i
  · simp only [fb]
    exact (by omega : False).elim
  · simp only [fb]
    interval_cases m
    · rw [c2, seqP_getD (N := 10) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c3, seqP_getD (N := 10) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c3, seqP_getD (N := 10) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]

/-- `charpoly_dimN` hypothesis: the diagonal is `1`. -/
lemma hone : ∀ i : ℕ, i < 3 → (qExpansion 1 (fb i)).coeff (i + 1) = (1 : ℂ) := by
  intro i hi
  interval_cases i
  · simp only [fb]
    exact q1_1
  · simp only [fb]
    exact q2_2
  · simp only [fb]
    exact q3_3

/-- `charpoly_dimN` hypothesis: the strict upper coefficients. -/
lemma hA : ∀ (i j : ℕ), i < j → j < 3 →
    (qExpansion 1 (fb i)).coeff (j + 1) = Atab i j := by
  intro i j hij hjn
  have hib : i < 3 := by omega
  interval_cases i
  · simp only [fb]
    interval_cases j
    · rw [c1, seqP_getD (N := 10) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
    · rw [c1, seqP_getD (N := 10) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
  · simp only [fb]
    interval_cases j
    · rw [c2, seqP_getD (N := 10) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
  · simp only [fb]
    interval_cases j

/-- `charpoly_dimN` hypothesis: the T₃-image coefficients. -/
lemma hX : ∀ (i m : ℕ), i < 3 → m < 3 →
    (qExpansion 1 (T3 (fb i))).coeff (m + 1) = Xtab i m := by
  intro i m hi hm
  interval_cases i
  · simp only [fb]
    interval_cases m
    · rw [t1_1]
      rfl
    · rw [t1_2]
      rfl
    · rw [t1_3]
      rfl
  · simp only [fb]
    interval_cases m
    · rw [t2_1]
      rfl
    · rw [t2_2]
      rfl
    · rw [t2_3]
      rfl
  · simp only [fb]
    interval_cases m
    · rw [t3_1]
      rfl
    · rw [t3_2]
      rfl
    · rw [t3_3]
      rfl

