noncomputable def fb : ℕ → CuspForm 𝒮ℒ ((50 : ℕ) : ℤ)
  | 0 => f1
  | 1 => f2
  | 2 => f3
  | _ => 0

/-- `Atab i j` = coefficient of `q^(j+1)` in `f i` for `i < j` (0 elsewhere). -/
def Atab : ℕ → ℕ → ℂ
  | 0, 1 => (1392 : ℂ)
  | 0, 2 => (612036 : ℂ)
  | 1, 2 => (648 : ℂ)
  | _, _ => 0

/-- `Xtab i m` = coefficient of `q^(m+1)` in `T₃ (f i)`. -/
def Xtab : ℕ → ℕ → ℂ
  | 0, 0 => (612036 : ℂ)
  | 0, 1 => (-83773915149888 : ℂ)
  | 0, 2 => (238947475016275968673296 : ℂ)
  | 1, 0 => (648 : ℂ)
  | 1, 1 => (-56445600060 : ℂ)
  | 1, 2 => (-10466589188905920 : ℂ)
  | 2, 0 => (1 : ℂ)
  | 2, 1 => (-24220416 : ℂ)
  | 2, 2 => (-286203921912 : ℂ)
  | _, _ => 0

lemma finrank_eq : Module.finrank ℂ (CuspForm 𝒮ℒ ((50 : ℕ) : ℤ)) = 3 := by
  apply Module.finrank_eq_of_rank_eq
  rw [CuspForm.discriminantEquiv.rank_eq]
  have h := ModularForm.dimension_level_one 38 (by decide)
