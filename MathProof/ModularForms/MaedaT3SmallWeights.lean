/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [48, 27, 60, 32, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 61)) = RabinCert.toPoly 61 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((-37475862172560 : ℤ) : ZMod 61) = (32 : ZMod 61) from by decide +kernel,
      show ((-2841515223367147210277887392 : ℤ) : ZMod 61) = (60 : ZMod 61) from by decide +kernel,
      show ((59356715181086244192938240812987791087360 : ℤ) : ZMod 61)
           = (27 : ZMod 61) from by decide +kernel,
      show ((2406648527648979886412974225475142562522832602755522816 : ℤ) : ZMod 61)
           = (48 : ZMod 61) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 61 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 61 fr).natDegree = 4 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 61 ^ 4 < 2 ^ 24 := by norm_num

lemma h1 : RabinCert.zpxw 61 fr (RabinCert.bitsOf 24 (61 ^ 4)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 61 w fr
      (RabinCert.zpxwsubX 61 fr 24 (61 ^ (4 / 2))) = [1] :=
  ⟨9, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 4 → ∃ w : ℕ,
      RabinCert.zpgcd 61 w fr
      (RabinCert.zpxwsubX 61 fr 24 (61 ^ (4 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 4 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [74, 98, 82, 32, 1]

lemma h1_2 : RabinCert.zpxw 103 fr2 (RabinCert.bitsOf 27 (103 ^ 4)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 61) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

