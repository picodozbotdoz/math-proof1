/-- The basis as an ℕ-indexed function (concrete indices reduce by `rfl`; the
catch-all is never used: `charpoly_dimN` only reads `fb i` for `i < n`). -/
noncomputable def fb : ℕ → CuspForm 𝒮ℒ ((62 : ℕ) : ℤ)
  | 0 => f1
  | 1 => f2
  | 2 => f3
  | 3 => f4
  | _ => 0

/-- `Atab i j` = coefficient of `q^(j+1)` in `f i` for `i < j` (0 elsewhere). -/
def Atab : ℕ → ℕ → ℂ
  | 0, 1 => (2112 : ℂ)
  | 0, 2 => (1793556 : ℂ)
  | 0, 3 => (641646592 : ℂ)
  | 1, 2 => (1368 : ℂ)
  | 1, 3 => (578880 : ℂ)
  | 2, 3 => (624 : ℂ)
  | _, _ => 0

/-- `Xtab i m` = coefficient of `q^(m+1)` in `T₃ (f i)`. -/
def Xtab : ℕ → ℕ → ℂ
  | 0, 0 => (1793556 : ℂ)
  | 0, 1 => (-212344464169728 : ℂ)
  | 0, 2 => (127173466632430817292624245136 : ℂ)
  | 0, 3 => (-12149691926322399546021838848 : ℂ)
  | 1, 0 => (1368 : ℂ)
  | 1, 1 => (-175714019820 : ℂ)
  | 1, 2 => (-2954065641140312640 : ℂ)
  | 1, 3 => (-437222417637458611885824 : ℂ)
  | 2, 0 => (1 : ℂ)
  | 2, 1 => (-163019136 : ℂ)
  | 2, 2 => (-368104312083672 : ℂ)
  | 2, 3 => (-938761720794853184 : ℂ)
  | 3, 0 => (0 : ℂ)
  | 3, 1 => (-189864 : ℂ)
  | 3, 2 => (-19284989328 : ℂ)
  | 3, 3 => (-217648250923500 : ℂ)
  | _, _ => 0

lemma finrank_eq : Module.finrank ℂ (CuspForm 𝒮ℒ ((62 : ℕ) : ℤ)) = 4 := by
  apply Module.finrank_eq_of_rank_eq
  rw [CuspForm.discriminantEquiv.rank_eq]
  have h := ModularForm.dimension_level_one 50 (by decide)
  norm_num [Nat.ModEq] at h
  exact_mod_cast h

/-- `charpoly_dimN` hypothesis: the basis is in echelon form (zeros). -/
lemma hzero : ∀ (i m : ℕ), i < 4 → 1 ≤ m → m ≤ i →
    (qExpansion 1 (fb i)).coeff m = (0 : ℂ) := by
  intro i m hi h1 h2
  interval_cases i
  · simp only [fb]
    exact (by omega : False).elim
  · simp only [fb]
    interval_cases m
    · rw [c2, seqP_getD (N := 13) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c3, seqP_getD (N := 13) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c3, seqP_getD (N := 13) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c4, seqP_getD (N := 13) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c4, seqP_getD (N := 13) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c4, seqP_getD (N := 13) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]

/-- `charpoly_dimN` hypothesis: the diagonal is `1`. -/
lemma hone : ∀ i : ℕ, i < 4 → (qExpansion 1 (fb i)).coeff (i + 1) = (1 : ℂ) := by
  intro i hi
  interval_cases i
  · simp only [fb]
    exact q1_1
  · simp only [fb]
    exact q2_2
  · simp only [fb]
    exact q3_3
  · simp only [fb]
    exact q4_4

/-- `charpoly_dimN` hypothesis: the strict upper coefficients. -/
lemma hA : ∀ (i j : ℕ), i < j → j < 4 →
    (qExpansion 1 (fb i)).coeff (j + 1) = Atab i j := by
  intro i j hij hjn
  have hib : i < 4 := by omega
  interval_cases i
  · simp only [fb]
    interval_cases j
    · rw [c1, seqP_getD (N := 13) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
