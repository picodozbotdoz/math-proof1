      -488415066455015424000000, 86191873376256000, 16677170905686516]

/-- The translated matrices `t·1 − M`, as an explicit literal (symbolic in `t`). -/
def MT (t : ℤ) : Matrix (Fin 5) (Fin 5) ℤ :=
      !![t - 2869236, (-1848), (-1), (0), (0);
      (214351847424000), t - -176768081676, (162818208), (185544), (384);
      (-834385168297798202617233408000000), (17470030538833920000), t - -7228770682244364,
      (863013399696), (318024306);
      (921161397875179765786214400000000000), (27843267827261767680000000),
      (320815007453859840000), t - -14306305785045516, (2112460391520);
      (-98600646790447628808093696000000000000), (1011248420504406589440000000000),
      (488415066455015424000000), (-86191873376256000), t - 16677170905686516]

/-- One-time symbolic bridge, reused by all determinant lemmas. -/
theorem scalar_sub_M (t : ℤ) : Matrix.scalar (Fin 5) t - M = MT t := by
  ext a b
  simp only [Matrix.scalar_apply, Matrix.diagonal_apply, Matrix.sub_apply, M, MT]
  fin_cases a <;> fin_cases b <;> simp

/-- The characteristic polynomial of `T₃` (descending literal). -/
noncomputable def P : ℤ[X] :=
  C (1) * (X : ℤ[X]) ^ 5 + C (4858082326815804) * (X : ℤ[X]) ^ 4 +
      - C (1915613281556425582477347629185632) * (X : ℤ[X]) ^ 3 +
      - C (5089861561903852913606890923227977390900202060928) * (X : ℤ[X]) ^ 2 +
      C (588767632901406766512742584766534642825722292894186273496859776256) * (X : ℤ[X]) ^ 1 +
      C (4485392922422337487778050561906074850956456082567835293937269407391757432571546624)

theorem P_natDegree : P.natDegree = 5 := by unfold P; compute_degree!

theorem P_monic : P.Monic := by unfold P; monicity!

/-- `det (t·1 − M)` at `t = 0`, by the certified Bareiss echelon decomposition. -/
theorem det_0 : (Matrix.scalar (Fin 5) (0 : ℤ) - M).det
     = 448539292242233748777805056190607485095645608256783529393726 * 10 ^ 22
      + 9407391757432571546624 := by
  rw [scalar_sub_M]
  simp only [MT]
  eval_det
  norm_num

