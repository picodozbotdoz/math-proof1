/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [50, 19, 16, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 53)) = RabinCert.toPoly 53 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((-5359866876 : ℤ) : ZMod 53) = (16 : ZMod 53) from by decide +kernel,
      show ((-4996455773706825446736 : ℤ) : ZMod 53) = (19 : ZMod 53) from by decide +kernel,
      show ((-79278971638132306383324561324864 : ℤ) : ZMod 53)
           = (50 : ZMod 53) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 53 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 53 fr).natDegree = 3 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 53 ^ 3 < 2 ^ 18 := by norm_num

lemma h1 : RabinCert.zpxw 53 fr (RabinCert.bitsOf 18 (53 ^ 3)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_3 : ∃ w : ℕ, RabinCert.zpgcd 53 w fr
      (RabinCert.zpxwsubX 53 fr 18 (53 ^ (3 / 3))) = [1] :=
  ⟨8, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 3 → ∃ w : ℕ,
      RabinCert.zpgcd 53 w fr
      (RabinCert.zpxwsubX 53 fr 18 (53 ^ (3 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 3 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact h2_3

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [29, 36, 55, 1]

lemma h1_2 : RabinCert.zpxw 61 fr2 (RabinCert.bitsOf 18 (61 ^ 3)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 53) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

