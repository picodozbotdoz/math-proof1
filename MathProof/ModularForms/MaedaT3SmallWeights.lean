  | 0, 1 => (-882400608 : ℂ)
  | 1, 0 => (-48 : ℂ)
  | 1, 1 => (143820 : ℂ)
  | _, _ => 0

lemma finrank_eq : Module.finrank ℂ (CuspForm 𝒮ℒ ((24 : ℕ) : ℤ)) = 2 := by
