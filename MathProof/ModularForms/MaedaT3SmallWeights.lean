      RabinCert.zpgcd 29 w fr
      (RabinCert.zpxwsubX 29 fr 10 (29 ^ (2 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 2 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
