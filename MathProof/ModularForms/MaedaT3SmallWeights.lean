    (qExpansion 1 (fb i)).coeff (j + 1) = Atab i j := by
  intro i j hij hjn
  have hib : i < 2 := by omega
  interval_cases i
  · simp only [fb]
    interval_cases j
    · rw [c1, seqP_getD (N := 7) (by norm_num), L1]
