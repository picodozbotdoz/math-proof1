lemma finrank_eq : Module.finrank ℂ (CuspForm 𝒮ℒ ((56 : ℕ) : ℤ)) = 4 := by
  apply Module.finrank_eq_of_rank_eq
  rw [CuspForm.discriminantEquiv.rank_eq]
  have h := ModularForm.dimension_level_one 44 (by decide)
  norm_num [Nat.ModEq] at h
  exact_mod_cast h

/-- `charpoly_dimN` hypothesis: the basis is in echelon form (zeros). -/
lemma hzero : ∀ (i m : ℕ), i < 4 → 1 ≤ m → m ≤ i →
    (qExpansion 1 (fb i)).coeff m = (0 : ℂ) := by
  intro i m hi h1 h2
  interval_cases i
  · simp only [fb]
    exact (by omega : False).elim
  · simp only [fb]
    interval_cases m
    · rw [c2, seqP_getD (N := 13) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c3, seqP_getD (N := 13) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c3, seqP_getD (N := 13) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c4, seqP_getD (N := 13) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c4, seqP_getD (N := 13) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c4, seqP_getD (N := 13) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]

/-- `charpoly_dimN` hypothesis: the diagonal is `1`. -/
lemma hone : ∀ i : ℕ, i < 4 → (qExpansion 1 (fb i)).coeff (i + 1) = (1 : ℂ) := by
  intro i hi
  interval_cases i
  · simp only [fb]
    exact q1_1
  · simp only [fb]
    exact q2_2
  · simp only [fb]
    exact q3_3
  · simp only [fb]
    exact q4_4

/-- `charpoly_dimN` hypothesis: the strict upper coefficients. -/
lemma hA : ∀ (i j : ℕ), i < j → j < 4 →
    (qExpansion 1 (fb i)).coeff (j + 1) = Atab i j := by
  intro i j hij hjn
  have hib : i < 4 := by omega
  interval_cases i
  · simp only [fb]
    interval_cases j
    · rw [c1, seqP_getD (N := 13) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
    · rw [c1, seqP_getD (N := 13) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
    · rw [c1, seqP_getD (N := 13) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
  · simp only [fb]
    interval_cases j
    · rw [c2, seqP_getD (N := 13) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
    · rw [c2, seqP_getD (N := 13) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
  · simp only [fb]
    interval_cases j
    · rw [c3, seqP_getD (N := 13) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
  · simp only [fb]
    interval_cases j

/-- `charpoly_dimN` hypothesis: the T₃-image coefficients. -/
lemma hX : ∀ (i m : ℕ), i < 4 → m < 4 →
    (qExpansion 1 (T3 (fb i))).coeff (m + 1) = Xtab i m := by
