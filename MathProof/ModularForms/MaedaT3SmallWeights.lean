noncomputable def fb : ℕ → CuspForm 𝒮ℒ ((48 : ℕ) : ℤ)
  | 0 => f1
  | 1 => f2
  | 2 => f3
  | 3 => f4
  | _ => 0

/-- `Atab i j` = coefficient of `q^(j+1)` in `f i` for `i < j` (0 elsewhere). -/
def Atab : ℕ → ℕ → ℂ
  | 0, 1 => (2136 : ℂ)
  | 0, 2 => (2041452 : ℂ)
  | 0, 3 => (1148911168 : ℂ)
  | 1, 2 => (1392 : ℂ)
  | 1, 3 => (808920 : ℂ)
  | 2, 3 => (648 : ℂ)
  | _, _ => 0

/-- `Xtab i m` = coefficient of `q^(m+1)` in `T₃ (f i)`. -/
def Xtab : ℕ → ℕ → ℂ
  | 0, 0 => (2041452 : ℂ)
  | 0, 1 => (105266268509472 : ℂ)
  | 0, 2 => (26757694199902201724304 : ℂ)
  | 0, 3 => (5165526896366740508295936 : ℂ)
