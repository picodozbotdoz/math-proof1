/-- The matrix of `T₃` in the echelon basis (census data, regression-checked). -/
def M : Matrix (Fin 4) (Fin 4) ℤ :=
      !![948276, 888, 1, 0;
      -126498226176000, -96136430796, -70603488, 36216;
      19382018610888179712000000, -162877603921920000, 1589588643636, 184341744;
      -3079882633774104576000000000, 250641490378752000000, -20397256704000, -2541864168396]

/-- The translated matrices `t·1 − M`, as an explicit literal (symbolic in `t`). -/
def MT (t : ℤ) : Matrix (Fin 4) (Fin 4) ℤ :=
      !![t - 948276, (-888), (-1), (0);
      (126498226176000), t - -96136430796, (70603488), (-36216);
      (-19382018610888179712000000), (162877603921920000), t - 1589588643636, (-184341744);
      (3079882633774104576000000000), (-250641490378752000000), (20397256704000),
      t - -2541864168396]

/-- One-time symbolic bridge, reused by all determinant lemmas. -/
theorem scalar_sub_M (t : ℤ) : Matrix.scalar (Fin 4) t - M = MT t := by
  ext a b
  simp only [Matrix.scalar_apply, Matrix.diagonal_apply, Matrix.sub_apply, M, MT]
  fin_cases a <;> fin_cases b <;> simp

/-- The characteristic polynomial of `T₃` (descending literal). -/
noncomputable def P : ℤ[X] :=
  C (1) * (X : ℤ[X]) ^ 4 + C (1048411007280) * (X : ℤ[X]) ^ 3 +
      - C (43904188642057665884936352) * (X : ℤ[X]) ^ 2 +
      - C (61295736917693756611101325132020430080) * (X : ℤ[X]) ^ 1 +
      C (155994269592549015372230825386472486974700379115776)

theorem P_natDegree : P.natDegree = 4 := by unfold P; compute_degree!

