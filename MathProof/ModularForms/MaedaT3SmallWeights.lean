lemma hmon' : (RabinCert.toPoly 67 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 67 fr).natDegree = 4 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 67 ^ 4 < 2 ^ 25 := by norm_num

lemma h1 : RabinCert.zpxw 67 fr (RabinCert.bitsOf 25 (67 ^ 4)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 67 w fr
      (RabinCert.zpxwsubX 67 fr 25 (67 ^ (4 / 2))) = [1] :=
  ⟨9, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 4 → ∃ w : ℕ,
      RabinCert.zpgcd 67 w fr
      (RabinCert.zpxwsubX 67 fr 25 (67 ^ (4 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 4 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [28, 15, 37, 29, 1]

lemma h1_2 : RabinCert.zpxw 73 fr2 (RabinCert.bitsOf 25 (73 ^ 4)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 67) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

