  intro i m hi h1 h2
  interval_cases i
  · simp only [fb]
    exact (by omega : False).elim
  · simp only [fb]
    interval_cases m
    · rw [c2, seqP_getD (N := 16) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c3, seqP_getD (N := 16) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c3, seqP_getD (N := 16) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
