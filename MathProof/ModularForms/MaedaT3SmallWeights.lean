/-- Assembly: the n+1 evaluation points, discharged per case. -/
theorem hevals : ∀ i : Fin 4, P.eval ((i : ℕ) : ℤ)
      = (Matrix.scalar (Fin 3) ((i : ℕ) : ℤ) - M).det := by
  intro i
  fin_cases i
  · change P.eval (0 : ℤ)
      = (Matrix.scalar (Fin 3) (0 : ℤ) - M).det
    rw [ev_0, det_0]
  · change P.eval (1 : ℤ)
      = (Matrix.scalar (Fin 3) (1 : ℤ) - M).det
    rw [ev_1, det_1]
  · change P.eval (2 : ℤ)
      = (Matrix.scalar (Fin 3) (2 : ℤ) - M).det
    rw [ev_2, det_2]
  · change P.eval (3 : ℤ)
      = (Matrix.scalar (Fin 3) (3 : ℤ) - M).det
    rw [ev_3, det_3]

