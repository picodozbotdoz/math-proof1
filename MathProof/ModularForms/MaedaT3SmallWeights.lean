/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [38, 45, 8, 66, 51, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 83)) = RabinCert.toPoly 83 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((-84016631749932 : ℤ) : ZMod 83) = (51 : ZMod 83) from by decide +kernel,
      show ((-48122321338884847008549188448 : ℤ) : ZMod 83)
           = (66 : ZMod 83) from by decide +kernel,
      show ((2043828233451849395600764022607299561425536 : ℤ) : ZMod 83)
           = (8 : ZMod 83) from by decide +kernel,
      show ((561308988679981697997214317651183361505714718375326827776 : ℤ) : ZMod 83)
           = (45 : ZMod 83) from by decide +kernel,
      show ((4464954114186561308564009112039849595712585439098492877487704724128768 : ℤ)
          : ZMod 83) = (38 : ZMod 83) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 83 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 83 fr).natDegree = 5 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 83 ^ 5 < 2 ^ 32 := by norm_num

lemma h1 : RabinCert.zpxw 83 fr (RabinCert.bitsOf 32 (83 ^ 5)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_5 : ∃ w : ℕ, RabinCert.zpgcd 83 w fr
      (RabinCert.zpxwsubX 83 fr 32 (83 ^ (5 / 5))) = [1] :=
  ⟨10, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 5 → ∃ w : ℕ,
      RabinCert.zpgcd 83 w fr
      (RabinCert.zpxwsubX 83 fr 32 (83 ^ (5 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 5 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact h2_5

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [5, 75, 26, 35, 14, 1]

lemma h1_2 : RabinCert.zpxw 89 fr2 (RabinCert.bitsOf 33 (89 ^ 5)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 83) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

