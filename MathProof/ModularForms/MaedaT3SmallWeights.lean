/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [49, 33, 36, 45, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 53)) = RabinCert.toPoly 53 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((-38461494960 : ℤ) : ZMod 53) = (45 : ZMod 53) from by decide +kernel,
      show ((-43901999211956882774688 : ℤ) : ZMod 53) = (36 : ZMod 53) from by decide +kernel,
      show ((3474388821526833258958496037776640 : ℤ) : ZMod 53)
           = (33 : ZMod 53) from by decide +kernel,
      show ((87427872789307389490432696190456228659835136 : ℤ) : ZMod 53)
           = (49 : ZMod 53) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 53 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 53 fr).natDegree = 4 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 53 ^ 4 < 2 ^ 23 := by norm_num

lemma h1 : RabinCert.zpxw 53 fr (RabinCert.bitsOf 23 (53 ^ 4)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 53 w fr
      (RabinCert.zpxwsubX 53 fr 23 (53 ^ (4 / 2))) = [1] :=
  ⟨9, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 4 → ∃ w : ℕ,
      RabinCert.zpgcd 53 w fr
      (RabinCert.zpxwsubX 53 fr 23 (53 ^ (4 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 4 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [51, 29, 34, 11, 1]

lemma h1_2 : RabinCert.zpxw 61 fr2 (RabinCert.bitsOf 24 (61 ^ 4)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 53) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

