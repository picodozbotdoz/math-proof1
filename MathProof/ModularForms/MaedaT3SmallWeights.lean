/-- **The characteristic polynomial of `T₃` on this weight.** -/
theorem charpoly_T3 : T3.charpoly = P.map (Int.castRingHom ℂ) := by
  have hdim := finrank_eq
  have hn : 0 < 2 := by norm_num
  rw [charpoly_dimN hn hdim fb Atab Xtab hzero hone hA T3 hX,
      ← CharpolyEngine.charpoly_of_eval_eq M P P_natDegree hevals, ← Matrix.charpoly_map]
  congr 1
  ext j i
  fin_cases j <;> fin_cases i
  · change coordN Atab (fun m => Xtab 0 m) 0 = ((162252 : ℤ) : ℂ)
    exact entry_0_0
  · change coordN Atab (fun m => Xtab 1 m) 0 = ((-48 : ℤ) : ℂ)
    exact entry_0_1
  · change coordN Atab (fun m => Xtab 0 m) 1 = ((-995328000 : ℤ) : ℂ)
    exact entry_1_0
  · change coordN Atab (fun m => Xtab 1 m) 1 = ((177228 : ℤ) : ℂ)
    exact entry_1_1

/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [18, 0, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 23)) = RabinCert.toPoly 23 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((-339480 : ℤ) : ZMod 23) = (0 : ZMod 23) from by decide +kernel,
      show ((-19020146544 : ℤ) : ZMod 23) = (18 : ZMod 23) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 23 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 23 fr).natDegree = 2 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 23 ^ 2 < 2 ^ 10 := by norm_num

lemma h1 : RabinCert.zpxw 23 fr (RabinCert.bitsOf 10 (23 ^ 2)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 23 w fr
      (RabinCert.zpxwsubX 23 fr 10 (23 ^ (2 / 2))) = [1] :=
  ⟨7, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 2 → ∃ w : ℕ,
      RabinCert.zpgcd 23 w fr
      (RabinCert.zpxwsubX 23 fr 10 (23 ^ (2 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 2 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [23, 23, 1]

lemma h1_2 : RabinCert.zpxw 29 fr2 (RabinCert.bitsOf 10 (29 ^ 2)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 23) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

