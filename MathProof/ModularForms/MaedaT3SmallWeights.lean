      238947529301950464000000, -10430012252160000, -270508802364]

/-- The translated matrices `t·1 − M`, as an explicit literal (symbolic in `t`). -/
def MT (t : ℤ) : Matrix (Fin 3) (Fin 3) ℤ :=
      !![t - 612036, (-648), (-1);
      (83774767104000), t - -56446502076, (24221808);
