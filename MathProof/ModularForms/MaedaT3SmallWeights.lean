  | 2, 1 => (5780352 : ℂ)
  | 2, 2 => (-91891405224 : ℂ)
  | 2, 3 => (-60164354899616 : ℂ)
  | 3, 0 => (0 : ℂ)
  | 3, 1 => (4464 : ℂ)
  | 3, 2 => (-48264768 : ℂ)
  | 3, 3 => (62452035180 : ℂ)
