    exact entry_1_1
  · change coordN Atab (fun m => Xtab 2 m) 1 = ((391176 : ℤ) : ℂ)
    exact entry_1_2
  · change coordN Atab (fun m => Xtab 0 m) 2 = ((6274292908032000000 : ℤ) : ℂ)
    exact entry_2_0
  · change coordN Atab (fun m => Xtab 1 m) 2 = ((1755758592000 : ℤ) : ℂ)
    exact entry_2_1
  · change coordN Atab (fun m => Xtab 2 m) 2 = ((-1162588788 : ℤ) : ℂ)
    exact entry_2_2

/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [19, 25, 2, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 37)) = RabinCert.toPoly 37 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((-1109442852 : ℤ) : ZMod 37) = (2 : ZMod 37) from by decide +kernel,
      show ((-9616340959640856144 : ℤ) : ZMod 37) = (25 : ZMod 37) from by decide +kernel,
      show ((11962616211248827131796154688 : ℤ) : ZMod 37) = (19 : ZMod 37) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 37 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 37 fr).natDegree = 3 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 37 ^ 3 < 2 ^ 16 := by norm_num

lemma h1 : RabinCert.zpxw 37 fr (RabinCert.bitsOf 16 (37 ^ 3)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_3 : ∃ w : ℕ, RabinCert.zpgcd 37 w fr
      (RabinCert.zpxwsubX 37 fr 16 (37 ^ (3 / 3))) = [1] :=
  ⟨8, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 3 → ∃ w : ℕ,
      RabinCert.zpgcd 37 w fr
      (RabinCert.zpxwsubX 37 fr 16 (37 ^ (3 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 3 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact h2_3

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [16, 11, 19, 1]

lemma h1_2 : RabinCert.zpxw 43 fr2 (RabinCert.bitsOf 17 (43 ^ 3)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 37) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

