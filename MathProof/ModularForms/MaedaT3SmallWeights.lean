/-- The translated matrices `t·1 − M`, as an explicit literal (symbolic in `t`). -/
def MT (t : ℤ) : Matrix (Fin 5) (Fin 5) ℤ :=
      !![t - 4446252, (-2352), (-1), (0), (0);
      (-1052971425792000), t - 662785139628, (-421595496), (-266544), (-120);
      (-1144561290775429870780416000000), (-5717841770741760000), t - 938209659378732,
      (99183704256), (42503130);
      (1840427753095885184040960000000000), (-1546457995636899840000000), (5636240516321280000),
      t - 632046343844268, (-390954243600);
      (-327147519355517877092352000000000000), (-1095610423081697280000000000),
      (2344934417891328000000), (-374406561792000), t - -617673441692628]

/-- One-time symbolic bridge, reused by all determinant lemmas. -/
theorem scalar_sub_M (t : ℤ) : Matrix.scalar (Fin 5) t - M = MT t := by
  ext a b
  simp only [Matrix.scalar_apply, Matrix.diagonal_apply, Matrix.sub_apply, M, MT]
  fin_cases a <;> fin_cases b <;> simp

/-- The characteristic polynomial of `T₃` (descending literal). -/
noncomputable def P : ℤ[X] :=
  C (1) * (X : ℤ[X]) ^ 5 + - C (953245351116252) * (X : ℤ[X]) ^ 4 +
      - C (2725762981675042674630827738208) * (X : ℤ[X]) ^ 3 +
      C (161146088051055196147322506078997935035916416) * (X : ℤ[X]) ^ 2 +
      C (1289052670076226202804335722539110882923156007245976432604416) * (X : ℤ[X]) ^ 1 +
      C (332328661587688507642907671043639006422441795220539413171770529120598791168)

theorem P_natDegree : P.natDegree = 5 := by unfold P; compute_degree!

theorem P_monic : P.Monic := by unfold P; monicity!

