/-- The basis as an ℕ-indexed function (concrete indices reduce by `rfl`; the
catch-all is never used: `charpoly_dimN` only reads `fb i` for `i < n`). -/
noncomputable def fb : ℕ → CuspForm 𝒮ℒ ((52 : ℕ) : ℤ)
  | 0 => f1
  | 1 => f2
  | 2 => f3
  | 3 => f4
  | _ => 0

/-- `Atab i j` = coefficient of `q^(j+1)` in `f i` for `i < j` (0 elsewhere). -/
def Atab : ℕ → ℕ → ℂ
  | 0, 1 => (2376 : ℂ)
  | 0, 2 => (2556252 : ℂ)
  | 0, 3 => (1643480128 : ℂ)
  | 1, 2 => (1632 : ℂ)
  | 1, 3 => (1145160 : ℂ)
  | 2, 3 => (888 : ℂ)
  | _, _ => 0

/-- `Xtab i m` = coefficient of `q^(m+1)` in `T₃ (f i)`. -/
def Xtab : ℕ → ℕ → ℂ
  | 0, 0 => (2556252 : ℂ)
  | 0, 1 => (208905514294752 : ℂ)
  | 0, 2 => (2154417505799070508767504 : ℂ)
  | 0, 3 => (87105309828016069146560256 : ℂ)
  | 1, 0 => (1632 : ℂ)
  | 1, 1 => (106377019740 : ℂ)
  | 1, 2 => (51869632603403520 : ℂ)
  | 1, 3 => (-56011926903828193824 : ℂ)
  | 2, 0 => (1 : ℂ)
  | 2, 1 => (38368512 : ℂ)
  | 2, 2 => (1207396769976 : ℂ)
  | 2, 3 => (1089203529627424 : ℂ)
  | 3, 0 => (0 : ℂ)
  | 3, 1 => (-16416 : ℂ)
  | 3, 2 => (386651232 : ℂ)
  | 3, 3 => (-498954927780 : ℂ)
  | _, _ => 0

lemma finrank_eq : Module.finrank ℂ (CuspForm 𝒮ℒ ((52 : ℕ) : ℤ)) = 4 := by
  apply Module.finrank_eq_of_rank_eq
  rw [CuspForm.discriminantEquiv.rank_eq]
  have h := ModularForm.dimension_level_one 40 (by decide)
  norm_num [Nat.ModEq] at h
  exact_mod_cast h

/-- `charpoly_dimN` hypothesis: the basis is in echelon form (zeros). -/
lemma hzero : ∀ (i m : ℕ), i < 4 → 1 ≤ m → m ≤ i →
    (qExpansion 1 (fb i)).coeff m = (0 : ℂ) := by
  intro i m hi h1 h2
  interval_cases i
  · simp only [fb]
    exact (by omega : False).elim
  · simp only [fb]
    interval_cases m
    · rw [c2, seqP_getD (N := 13) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c3, seqP_getD (N := 13) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c3, seqP_getD (N := 13) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c4, seqP_getD (N := 13) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c4, seqP_getD (N := 13) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c4, seqP_getD (N := 13) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]

/-- `charpoly_dimN` hypothesis: the diagonal is `1`. -/
lemma hone : ∀ i : ℕ, i < 4 → (qExpansion 1 (fb i)).coeff (i + 1) = (1 : ℂ) := by
  intro i hi
  interval_cases i
  · simp only [fb]
    exact q1_1
  · simp only [fb]
    exact q2_2
  · simp only [fb]
    exact q3_3
  · simp only [fb]
    exact q4_4

/-- `charpoly_dimN` hypothesis: the strict upper coefficients. -/
lemma hA : ∀ (i j : ℕ), i < j → j < 4 →
    (qExpansion 1 (fb i)).coeff (j + 1) = Atab i j := by
  intro i j hij hjn
  have hib : i < 4 := by omega
  interval_cases i
  · simp only [fb]
    interval_cases j
    · rw [c1, seqP_getD (N := 13) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
    · rw [c1, seqP_getD (N := 13) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
    · rw [c1, seqP_getD (N := 13) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
  · simp only [fb]
    interval_cases j
    · rw [c2, seqP_getD (N := 13) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
    · rw [c2, seqP_getD (N := 13) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
  · simp only [fb]
    interval_cases j
    · rw [c3, seqP_getD (N := 13) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
  · simp only [fb]
    interval_cases j

/-- `charpoly_dimN` hypothesis: the T₃-image coefficients. -/
lemma hX : ∀ (i m : ℕ), i < 4 → m < 4 →
    (qExpansion 1 (T3 (fb i))).coeff (m + 1) = Xtab i m := by
  intro i m hi hm
  interval_cases i
  · simp only [fb]
    interval_cases m
    · rw [t1_1]
      rfl
    · rw [t1_2]
      rfl
    · rw [t1_3]
      rfl
    · rw [t1_4]
      rfl
  · simp only [fb]
    interval_cases m
    · rw [t2_1]
      rfl
    · rw [t2_2]
      rfl
    · rw [t2_3]
      rfl
    · rw [t2_4]
      rfl
  · simp only [fb]
    interval_cases m
    · rw [t3_1]
      rfl
    · rw [t3_2]
      rfl
    · rw [t3_3]
      rfl
    · rw [t3_4]
      rfl
  · simp only [fb]
    interval_cases m
    · rw [t4_1]
      rfl
    · rw [t4_2]
      rfl
    · rw [t4_3]
      rfl
    · rw [t4_4]
