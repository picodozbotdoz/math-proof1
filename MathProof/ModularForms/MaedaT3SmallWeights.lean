/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [24, 19, 32, 28, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 71)) = RabinCert.toPoly 71 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((573723599022000 : ℤ) : ZMod 71) = (28 : ZMod 71) from by decide +kernel,
      show ((-148047142502943190327862646432 : ℤ) : ZMod 71)
           = (32 : ZMod 71) from by decide +kernel,
      show ((-56430130745266784820534654098342716887072000 : ℤ) : ZMod 71)
           = (19 : ZMod 71) from by decide +kernel,
      show ((10527331524606552743783084937951530094542295694731224576256 : ℤ) : ZMod 71)
           = (24 : ZMod 71) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 71 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 71 fr).natDegree = 4 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 71 ^ 4 < 2 ^ 25 := by norm_num

lemma h1 : RabinCert.zpxw 71 fr (RabinCert.bitsOf 25 (71 ^ 4)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 71 w fr
      (RabinCert.zpxwsubX 71 fr 25 (71 ^ (4 / 2))) = [1] :=
  ⟨9, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 4 → ∃ w : ℕ,
      RabinCert.zpgcd 71 w fr
      (RabinCert.zpxwsubX 71 fr 25 (71 ^ (4 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 4 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [1, 69, 69, 1, 1]

lemma h1_2 : RabinCert.zpxw 73 fr2 (RabinCert.bitsOf 25 (73 ^ 4)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 71) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

