/-- **The characteristic polynomial of `T₃` on this weight.** -/
theorem charpoly_T3 : T3.charpoly = P.map (Int.castRingHom ℂ) := by
  have hdim := finrank_eq
  have hn : 0 < 3 := by norm_num
  rw [charpoly_dimN hn hdim fb Atab Xtab hzero hone hA T3 hX,
      ← CharpolyEngine.charpoly_of_eval_eq M P P_natDegree hevals, ← Matrix.charpoly_map]
  congr 1
  ext j i
  fin_cases j <;> fin_cases i
  · change coordN Atab (fun m => Xtab 0 m) 0 = ((1584252 : ℤ) : ℂ)
    exact entry_0_0
  · change coordN Atab (fun m => Xtab 1 m) 0 = ((1152 : ℤ) : ℂ)
    exact entry_0_1
  · change coordN Atab (fun m => Xtab 2 m) 0 = ((1 : ℤ) : ℂ)
    exact entry_0_2
  · change coordN Atab (fun m => Xtab 0 m) 1 = ((47321874432000 : ℤ) : ℂ)
    exact entry_1_0
  · change coordN Atab (fun m => Xtab 1 m) 1 = ((13879138428 : ℤ) : ℂ)
    exact entry_1_1
  · change coordN Atab (fun m => Xtab 2 m) 1 = ((-2272104 : ℤ) : ℂ)
    exact entry_1_2
  · change coordN Atab (fun m => Xtab 0 m) 2 = ((355323114160128000000 : ℤ) : ℂ)
    exact entry_2_0
  · change coordN Atab (fun m => Xtab 1 m) 2 = ((-98627051520000 : ℤ) : ℂ)
    exact entry_2_1
  · change coordN Atab (fun m => Xtab 2 m) 2 = ((10520715132 : ℤ) : ℂ)
    exact entry_2_2

/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [48, 6, 19, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 61)) = RabinCert.toPoly 61 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((-24401437812 : ℤ) : ZMod 61) = (19 : ZMod 61) from by decide +kernel,
      show ((-433411430030887314384 : ℤ) : ZMod 61) = (6 : ZMod 61) from by decide +kernel,
      show ((5866988517623967326564020435008 : ℤ) : ZMod 61)
           = (48 : ZMod 61) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 61 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 61 fr).natDegree = 3 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 61 ^ 3 < 2 ^ 18 := by norm_num

lemma h1 : RabinCert.zpxw 61 fr (RabinCert.bitsOf 18 (61 ^ 3)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_3 : ∃ w : ℕ, RabinCert.zpgcd 61 w fr
      (RabinCert.zpxwsubX 61 fr 18 (61 ^ (3 / 3))) = [1] :=
  ⟨8, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 3 → ∃ w : ℕ,
      RabinCert.zpgcd 61 w fr
      (RabinCert.zpxwsubX 61 fr 18 (61 ^ (3 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 3 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact h2_3

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [10, 15, 44, 1]

lemma h1_2 : RabinCert.zpxw 73 fr2 (RabinCert.bitsOf 19 (73 ^ 3)) [1]
