lemma finrank_eq : Module.finrank ℂ (CuspForm 𝒮ℒ ((70 : ℕ) : ℤ)) = 5 := by
  apply Module.finrank_eq_of_rank_eq
  rw [CuspForm.discriminantEquiv.rank_eq]
  have h := ModularForm.dimension_level_one 58 (by decide)
  norm_num [Nat.ModEq] at h
  exact_mod_cast h

/-- `charpoly_dimN` hypothesis: the basis is in echelon form (zeros). -/
lemma hzero : ∀ (i m : ℕ), i < 5 → 1 ≤ m → m ≤ i →
    (qExpansion 1 (fb i)).coeff m = (0 : ℂ) := by
  intro i m hi h1 h2
  interval_cases i
  · simp only [fb]
    exact (by omega : False).elim
  · simp only [fb]
    interval_cases m
    · rw [c2, seqP_getD (N := 16) (by norm_num), L2]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c3, seqP_getD (N := 16) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c3, seqP_getD (N := 16) (by norm_num), L3]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c4, seqP_getD (N := 16) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c4, seqP_getD (N := 16) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c4, seqP_getD (N := 16) (by norm_num), L4]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
  · simp only [fb]
    interval_cases m
    · rw [c5, seqP_getD (N := 16) (by norm_num), L5]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c5, seqP_getD (N := 16) (by norm_num), L5]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c5, seqP_getD (N := 16) (by norm_num), L5]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
    · rw [c5, seqP_getD (N := 16) (by norm_num), L5]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]

/-- `charpoly_dimN` hypothesis: the diagonal is `1`. -/
lemma hone : ∀ i : ℕ, i < 5 → (qExpansion 1 (fb i)).coeff (i + 1) = (1 : ℂ) := by
  intro i hi
  interval_cases i
  · simp only [fb]
    exact q1_1
  · simp only [fb]
    exact q2_2
  · simp only [fb]
    exact q3_3
  · simp only [fb]
    exact q4_4
  · simp only [fb]
    exact q5_5

