noncomputable def fb : ℕ → CuspForm 𝒮ℒ ((58 : ℕ) : ℤ)
  | 0 => f1
  | 1 => f2
  | 2 => f3
  | 3 => f4
  | _ => 0

/-- `Atab i j` = coefficient of `q^(j+1)` in `f i` for `i < j` (0 elsewhere). -/
def Atab : ℕ → ℕ → ℂ
  | 0, 1 => (1872 : ℂ)
  | 0, 2 => (1342116 : ℂ)
  | 0, 3 => (315488512 : ℂ)
  | 1, 2 => (1128 : ℂ)
  | 1, 3 => (306000 : ℂ)
  | 2, 3 => (384 : ℂ)
  | _, _ => 0

