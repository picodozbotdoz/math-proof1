/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [30, 94, 41, 86, 54, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 97)) = RabinCert.toPoly 97 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((-3443360269119372 : ℤ) : ZMod 97) = (54 : ZMod 97) from by decide +kernel,
      show ((-239748302189192543002375076335968 : ℤ) : ZMod 97)
           = (86 : ZMod 97) from by decide +kernel,
      show ((-2543878756054325628827011583648078166901586304 : ℤ) : ZMod 97)
           = (41 : ZMod 97) from by decide +kernel,
      show ((11003934781510058690145366620768332740728720723475674327579878656 : ℤ) : ZMod 97)
           = (94 : ZMod 97) from by decide +kernel,
      show ((13641479139537876716225648684288981987059336004251761883285355054795335672685568 : ℤ)
          : ZMod 97) = (30 : ZMod 97) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 97 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 97 fr).natDegree = 5 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 97 ^ 5 < 2 ^ 33 := by norm_num

lemma h1 : RabinCert.zpxw 97 fr (RabinCert.bitsOf 33 (97 ^ 5)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_5 : ∃ w : ℕ, RabinCert.zpgcd 97 w fr
      (RabinCert.zpxwsubX 97 fr 33 (97 ^ (5 / 5))) = [1] :=
  ⟨10, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 5 → ∃ w : ℕ,
      RabinCert.zpgcd 97 w fr
      (RabinCert.zpxwsubX 97 fr 33 (97 ^ (5 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 5 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact h2_5

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [36, 8, 72, 88, 128, 1]

lemma h1_2 : RabinCert.zpxw 163 fr2 (RabinCert.bitsOf 37 (163 ^ 5)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 97) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

