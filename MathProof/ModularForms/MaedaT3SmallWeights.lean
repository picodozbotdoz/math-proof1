lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 29 w fr
      (RabinCert.zpxwsubX 29 fr 10 (29 ^ (2 / 2))) = [1] :=
  ⟨7, by decide +kernel⟩

