  | 2, 1 => (-121476096 : ℂ)
  | 2, 2 => (14601979944648 : ℂ)
  | 2, 3 => (11935920012391936 : ℂ)
  | 3, 0 => (0 : ℂ)
  | 3, 1 => (-105624 : ℂ)
  | 3, 2 => (245717712 : ℂ)
