/-- The matrix of `T₃` in the echelon basis (census data, regression-checked). -/
def M : Matrix (Fin 4) (Fin 4) ℤ :=
      !![1342116, 1128, 1, 0;
      -172350996480000, -139003633116, -121477968, -105624;
      1570039466517677998080000000, -863308783964160000, 14739005750436, 364861584;
