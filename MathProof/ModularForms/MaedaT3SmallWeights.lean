/-- **The characteristic polynomial of `T₃` on this weight.** -/
theorem charpoly_T3 : T3.charpoly = P.map (Int.castRingHom ℂ) := by
  have hdim := finrank_eq
  have hn : 0 < 3 := by norm_num
  rw [charpoly_dimN hn hdim fb Atab Xtab hzero hone hA T3 hX,
      ← CharpolyEngine.charpoly_of_eval_eq M P P_natDegree hevals, ← Matrix.charpoly_map]
  congr 1
  ext j i
  fin_cases j <;> fin_cases i
  · change coordN Atab (fun m => Xtab 0 m) 0 = ((612036 : ℤ) : ℂ)
    exact entry_0_0
  · change coordN Atab (fun m => Xtab 1 m) 0 = ((648 : ℤ) : ℂ)
    exact entry_0_1
  · change coordN Atab (fun m => Xtab 2 m) 0 = ((1 : ℤ) : ℂ)
    exact entry_0_2
  · change coordN Atab (fun m => Xtab 0 m) 1 = ((-83774767104000 : ℤ) : ℂ)
    exact entry_1_0
  · change coordN Atab (fun m => Xtab 1 m) 1 = ((-56446502076 : ℤ) : ℂ)
    exact entry_1_1
  · change coordN Atab (fun m => Xtab 2 m) 1 = ((-24221808 : ℤ) : ℂ)
    exact entry_1_2
  · change coordN Atab (fun m => Xtab 0 m) 2 = ((238947529301950464000000 : ℤ) : ℂ)
    exact entry_2_0
  · change coordN Atab (fun m => Xtab 1 m) 2 = ((-10430012252160000 : ℤ) : ℂ)
    exact entry_2_1
  · change coordN Atab (fun m => Xtab 2 m) 2 = ((-270508802364 : ℤ) : ℂ)
    exact entry_2_2

/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [28, 46, 24, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 53)) = RabinCert.toPoly 53 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((326954692404 : ℤ) : ZMod 53) = (24 : ZMod 53) from by decide +kernel,
      show ((-476312153659569394420176 : ℤ) : ZMod 53) = (46 : ZMod 53) from by decide +kernel,
      show ((-9738009737601437474179912919075904 : ℤ) : ZMod 53)
           = (28 : ZMod 53) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 53 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 53 fr).natDegree = 3 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 53 ^ 3 < 2 ^ 18 := by norm_num

lemma h1 : RabinCert.zpxw 53 fr (RabinCert.bitsOf 18 (53 ^ 3)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_3 : ∃ w : ℕ, RabinCert.zpgcd 53 w fr
      (RabinCert.zpxwsubX 53 fr 18 (53 ^ (3 / 3))) = [1] :=
  ⟨8, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 3 → ∃ w : ℕ,
      RabinCert.zpgcd 53 w fr
      (RabinCert.zpxwsubX 53 fr 18 (53 ^ (3 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 3 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact h2_3

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [33, 54, 14, 1]

lemma h1_2 : RabinCert.zpxw 61 fr2 (RabinCert.bitsOf 18 (61 ^ 3)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 53) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

