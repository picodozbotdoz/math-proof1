/-!
# The Hecke index at every level-one weight with `2 ≤ dim S_k ≤ 10`

Generated by `tools/gen_hecke_index.py` from
`research/iteration23/hecke-index/index_data.json` (the G1 audit's
re-pinned data; byte-identical re-runs; do not hand-edit).  For each of
the 54 weights `24 ≤ k ≤ 134` with `2 ≤ dim S_k ≤ 10`: the index
`I_k = |det A|` with its certified Bareiss determinant (`eval_det`),
the Cramer weights `w' = I_k · w`, the entrywise kernel certificate
`∑ w'_j M₂^j = I_k M₃` (`decide +kernel` entrywise), the
basis-independent operator identity
`∑ (w'_j : ℂ) • T₂^j = (I_k : ℂ) • T₃`
(`HeckeIndex.int_poly_of_dimN`), and — for the weights with a
nontrivial reduced denominator `D` — the composite `D ∣ I_k` via
`HeckeIndex.den_dvd_index` (the reduced denominator of any
representation divides the denominator of every other).  At the six
dim-2 weights the denominator is `1` and the divisibility is
`one_dvd`.

Everything is light: no `set_option`, no `native_decide`/`sorry`; the
only decides are entrywise per-matrix-cell certificates plus one small
Bézout identity per weight, all `decide +kernel`.
-/

/-! ### Weight 24 (dim 2) -/
namespace HeckeIndexWeight24

/-- The index `I_k = |det A|` at weight 24 (G1 audit). -/
def Ik : ℤ :=
  1

/-- The Miller-coordinate matrix at weight 24: `A i j = a_(2^i)(f_j)` (G1 audit, Miller
  strategy (a)). -/
def A : Matrix (Fin 2) (Fin 2) ℤ := !![
1, 0;
0, 1]

/-- `det A = ±I_k` (the signed G1 value; certified Bareiss `eval_det`). -/
theorem det_A : A.det = Ik := by
  simp only [A]
  eval_det
  norm_num [Ik]

theorem hIkq : ((Ik : ℤ) : ℚ) ≠ 0 := by norm_num [Ik]
theorem hIkc : ((Ik : ℤ) : ℂ) ≠ 0 := by norm_num [Ik]

/-- The Cramer weights `w' = I_k · w` at weight 24 (G1 audit). -/
def wp : ℕ → ℤ
  | 0 => 195660
  | 1 => -48
  | _ => 0

theorem scaled : (∑ j ∈ Finset.range 2, wp j • HeckeRatWeight24.M2 ^ j)
    = Ik • MaedaT3Weight24.M := by
  ext a b
  fin_cases a <;> fin_cases b <;> decide +kernel

/-- The basis-independent operator identity `∑ w'_j T₂^j = I_k • T₃`. -/
theorem op_id : ∑ j ∈ Finset.range 2, ((wp j : ℤ) : ℂ) • HeckeRatWeight24.T2 ^ j
    = ((Ik : ℤ) : ℂ) • MaedaT3Weight24.T3 :=
  int_poly_of_dimN (by norm_num) MaedaT3Weight24.finrank_eq MaedaT3Weight24.fb
    MaedaT3Weight24.Atab HeckeRatWeight24.Xtab2 MaedaT3Weight24.Xtab
    MaedaT3Weight24.hzero MaedaT3Weight24.hone MaedaT3Weight24.hA
    HeckeRatWeight24.T2 MaedaT3Weight24.T3 HeckeRatWeight24.hX2 MaedaT3Weight24.hX
    HeckeRatWeight24.M2 MaedaT3Weight24.M HeckeRatWeight24.hM2 HeckeRatWeight24.hM3
    wp Ik scaled

/-- The denominator is trivial at this weight (`D = 1`). -/
theorem D_dvd_Ik : (1 : ℤ) ∣ Ik := one_dvd Ik

end HeckeIndexWeight24

