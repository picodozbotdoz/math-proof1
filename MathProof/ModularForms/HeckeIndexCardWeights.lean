/-- The entrywise kernel certificate: `C` is the Miller-conjugated row-0 of the
powers of the landed `T₂` matrix. -/
theorem hcard : Matrix.of (fun i j : Fin 10 =>
    ∑ c : Fin 10, millerCoeff atab 10 j.val c.val
      * (MaedaWeight128.M ^ (i : ℕ)) 0 c) = C := by
  ext i j
  fin_cases i <;> fin_cases j <;> decide +kernel

/-- `det C = ±I_k` (certified Bareiss `eval_det`; `I_k` the landed literal). -/
theorem det_C : C.det = HeckeIndexWeight128.Ik := by
  simp only [C]
  eval_det
  norm_num [HeckeIndexWeight128.Ik]

/-- **The lattice index at weight 128**: `[𝕋 : ℤ[T₂]] = |I_k|`. -/
theorem index_card : (t2Lattice (heckeTM ((128 : ℕ) : ℤ) 2) 10).toAddSubgroup.relIndex
    (heckeLattice ((128 : ℕ) : ℤ) 10).toAddSubgroup = HeckeIndexWeight128.Ik.natAbs :=
  index_card_dimN (by norm_num) (by norm_num) MaedaT3Weight128.finrank_eq MaedaT3Weight128.fb
    MaedaT3Weight128.Atab MaedaT3Weight128.hzero MaedaT3Weight128.hone MaedaT3Weight128.hA hfi
    hmin atab hAeq MaedaWeight128.Xtab MaedaWeight128.hX MaedaWeight128.M HeckeRatWeight128.hM2 C
    hcard HeckeIndexWeight128.Ik (by rw [det_C])

/-- **The lattice index at weight 128**, as `Nat.card (𝕋 ⧸ ℤ[T₂])`. -/
theorem index_card_natCard : Nat.card (↥(heckeLattice ((128 : ℕ) : ℤ) 10).toAddSubgroup ⧸
    (t2Lattice (heckeTM ((128 : ℕ) : ℤ) 2) 10).toAddSubgroup.addSubgroupOf
      (heckeLattice ((128 : ℕ) : ℤ) 10).toAddSubgroup) = HeckeIndexWeight128.Ik.natAbs :=
  index_card_natCard_dimN (by norm_num) (by norm_num) MaedaT3Weight128.finrank_eq
    MaedaT3Weight128.fb MaedaT3Weight128.Atab MaedaT3Weight128.hzero MaedaT3Weight128.hone
    MaedaT3Weight128.hA hfi hmin atab hAeq MaedaWeight128.Xtab MaedaWeight128.hX MaedaWeight128.M
    HeckeRatWeight128.hM2 C hcard HeckeIndexWeight128.Ik (by rw [det_C])

end HeckeIndexCardWeight128

