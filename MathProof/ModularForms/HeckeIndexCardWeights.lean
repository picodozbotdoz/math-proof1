  intro i j
  fin_cases i <;> fin_cases j <;> rfl

/-- The kernel certificate over `List` sums and integer tables (`propext`-only):
every cell of `C` is the Miller-conjugated row 0 of the powers of `T₂`. -/
theorem hcheck : cardCheck atab m2tab ctab 10 = true := by
  decide +kernel

/-- The matrix identity consumed by `index_card_dimN` (`hcard_of_check`). -/
theorem hcard : Matrix.of (fun i j : Fin 10 =>
    ∑ c : Fin 10, millerCoeff atab 10 j.val c.val
      * (MaedaWeight134.M ^ (i : ℕ)) 0 c) = C :=
  hcard_of_check atab MaedaWeight134.M C m2tab ctab hM2tab hCtab hcheck

/-- `det C = ±I_k` (certified Bareiss `eval_det`; `I_k` the landed literal). -/
theorem det_C : C.det = HeckeIndexWeight134.Ik := by
  simp only [C]
  eval_det
  norm_num [HeckeIndexWeight134.Ik]

/-- **The lattice index at weight 134**: `[𝕋 : ℤ[T₂]] = |I_k|`. -/
theorem index_card : (t2Lattice (heckeTM ((134 : ℕ) : ℤ) 2) 10).toAddSubgroup.relIndex
    (heckeLattice ((134 : ℕ) : ℤ) 10).toAddSubgroup = HeckeIndexWeight134.Ik.natAbs :=
  index_card_dimN (by norm_num) (by norm_num) MaedaT3Weight134.finrank_eq MaedaT3Weight134.fb
    MaedaT3Weight134.Atab MaedaT3Weight134.hzero MaedaT3Weight134.hone MaedaT3Weight134.hA hfi
    hmin atab hAeq MaedaWeight134.Xtab MaedaWeight134.hX MaedaWeight134.M HeckeRatWeight134.hM2 C
    hcard HeckeIndexWeight134.Ik (by rw [det_C])

/-- **The lattice index at weight 134**, as `Nat.card (𝕋 ⧸ ℤ[T₂])`. -/
theorem index_card_natCard : Nat.card (↥(heckeLattice ((134 : ℕ) : ℤ) 10).toAddSubgroup ⧸
    (t2Lattice (heckeTM ((134 : ℕ) : ℤ) 2) 10).toAddSubgroup.addSubgroupOf
      (heckeLattice ((134 : ℕ) : ℤ) 10).toAddSubgroup) = HeckeIndexWeight134.Ik.natAbs :=
  index_card_natCard_dimN (by norm_num) (by norm_num) MaedaT3Weight134.finrank_eq
    MaedaT3Weight134.fb MaedaT3Weight134.Atab MaedaT3Weight134.hzero MaedaT3Weight134.hone
    MaedaT3Weight134.hA hfi hmin atab hAeq MaedaWeight134.Xtab MaedaWeight134.hX MaedaWeight134.M
    HeckeRatWeight134.hM2 C hcard HeckeIndexWeight134.Ik (by rw [det_C])

end HeckeIndexCardWeight134
