/-- The `T₇` relation at weight 88: `T₇ = ∑_{t<9} t7c t • T_(t7M t)` with
{2,3,5}-smooth indices (generator-chosen Bezout combination). -/
def t7M : ℕ → ℕ := fun t =>
    [8, 10, 15, 1, 2, 3, 4, 5, 6].getD t 0

/-- The integer coefficients of the `T₇` relation at weight 88. -/
def t7c : ℕ → ℤ := fun t =>
    [-1015464698965290317, 32903132434132, -1, 12787988204477061858124997399598120000,
     -13638860659065590071380026250515128, -103789657690855567279741096527528,
     -310311208668332988401728287400, -314136322009573887299660000,
     257295454944763985540600].getD t 0

/-- The indices of the `T₇` relation are `{2,3,5}`-smooth. -/
theorem t7_smooth : ∀ t < 9, 1 ≤ t7M t ∧
    ([2, 3, 5] : List ℕ).prod ^ 30 % t7M t = 0 := by
  decide +kernel

/-- The `T₇` relation on the first `q`-coefficients of the echelon basis. -/
theorem t7_rows : ∀ i : ℕ, i < 7 → (qExpansion 1 (MaedaT3Weight88.fb i)).coeff 7
    = ∑ t ∈ Finset.range 9,
      ((t7c t : ℤ) : ℂ) * (qExpansion 1 (MaedaT3Weight88.fb i)).coeff (t7M t) := by
  intro i hi
  interval_cases i
  · simp only [Finset.sum_range_succ, Finset.sum_range_zero, t7M, t7c,
      List.getD_cons_succ, List.getD_cons_zero, MaedaT3Weight88.fb]
    simp only [MaedaT3Weight88.q1_1, MaedaT3Weight88.q1_2, MaedaT3Weight88.q1_3,
      MaedaT3Weight88.q1_4, MaedaT3Weight88.q1_5, MaedaT3Weight88.q1_6, MaedaT3Weight88.q1_7,
      MaedaT3Weight88.q1_8, MaedaT3Weight88.q1_10, MaedaT3Weight88.q1_15]
    norm_num
  · simp only [Finset.sum_range_succ, Finset.sum_range_zero, t7M, t7c,
      List.getD_cons_succ, List.getD_cons_zero, MaedaT3Weight88.fb]
    simp only [MaedaT3Weight88.q2_1, MaedaT3Weight88.q2_2, MaedaT3Weight88.q2_3,
      MaedaT3Weight88.q2_4, MaedaT3Weight88.q2_5, MaedaT3Weight88.q2_6, MaedaT3Weight88.q2_7,
      MaedaT3Weight88.q2_8, MaedaT3Weight88.q2_10, MaedaT3Weight88.q2_15]
    norm_num
  · simp only [Finset.sum_range_succ, Finset.sum_range_zero, t7M, t7c,
