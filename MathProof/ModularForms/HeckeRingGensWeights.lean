noncomputable def heckeRing :
    Subring (Module.End ℂ (CuspForm 𝒮ℒ ((72 : ℕ) : ℤ))) :=
  HeckeIndex.heckeRing (HeckeIndex.miller MaedaT3Weight72.fb MaedaT3Weight72.Atab 6)
    (by norm_num)
    (HeckeIndex.miller_linearIndependent _ _ MaedaT3Weight72.hzero MaedaT3Weight72.hone
      MaedaT3Weight72.hA)
    MaedaT3Weight72.finrank_eq
    (fun j m hj hm => HeckeIndex.miller_coeff' _ _ MaedaT3Weight72.hzero
      MaedaT3Weight72.hone MaedaT3Weight72.hA j m hj hm)
    (fun j m hj => HeckeFieldRat.miller_int _ _ MaedaT3Weight72.hA hfi j m hj)
    (by norm_num)

