/-- **Eigenvalue containment at weight 24**: every nonzero `T₂`-eigenform
with eigenvalue `λ₂` is a `T₃`-eigenform with eigenvalue in `ℚ(λ₂)`. -/
theorem eigen_T3_mem_adjoin_weight24 {v : CuspForm 𝒮ℒ ((24 : ℕ) : ℤ)} (hv : v ≠ 0)
    {μ : ℂ} (hμ : heckeTPₗ ((24 : ℕ) : ℤ) Nat.prime_two v = μ • v) :
    ∃ w ∈ IntermediateField.adjoin ℚ ({μ} : Set ℂ),
