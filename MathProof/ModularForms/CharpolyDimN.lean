import MathProof.ModularForms.MaedaLevelOne

/-!
# The dimension-generic echelon extraction (`charpoly_dimN`)

Generalizes `MaedaLevelOne.charpoly_dim2`, `charpoly_dim3` and `charpoly_dim4`
to every dimension.  For a basis `f : Fin n → S_k(ℤ)` in echelon form — `f i`
has q-order `i + 1`, and its higher coefficients are recorded in `A` — the
matrix of any endomorphism `T` in this basis is the *downward
back-substitution* of the q-coefficient data `X i m = coeff q^{m+1} (T (f i))`:

* `coordN A c j` solves the triangular system `γ j + ∑_{i<j} A i j γ i = c j`
  for `γ`, by structural recursion over a snoc-list accumulator
  (`coordsAux`);  nothing kernel-decides it, so well-behaved simp unfolding is
  the only requirement.
* `charpoly_dimN` reads off `T.charpoly` from `A` and `X`.

The consumers (`MaedaDim6Weights` … `MaedaDim10Weights`, generated by
`tools/gen_maedan.py`) discharge the hypotheses with `MaedaCertC.seqPLc`
coefficient lemmas and bridge the resulting matrix to the literal integer
matrix via `Matrix.charpoly_map` + `CharpolyEngine.charpoly_of_eval_eq`.

This module is new infrastructure (the `HornerCert`/`MaedaCertC` pattern):
it imports `MaedaLevelOne` but is imported by nothing in the heavy
`MaedaGalois5Defs` ancestor set, so the heavy chain is not invalidated.
-/

namespace MaedaLevelOne

open UpperHalfPlane ModularForm CuspForm Polynomial
open scoped MatrixGroups

/-! ### A sum-splitting helper (pure `ℕ`) -/

/-- Splitting a range sum by the trichotomy against `m`: everything strictly
below `m`, the point `m` itself, and (a zero tail) everything above. -/
private lemma sum_range_split (F : ℕ → ℂ) :
    ∀ (m : ℕ) (e : ℕ → ℂ) (n : ℕ), m < n →
      (∑ x ∈ Finset.range n, (if x < m then F x else if x = m then e x else 0))
        = (∑ x ∈ Finset.range m, F x) + e m := by
  intro m
  induction m with
  | zero =>
      intro e n hn
      have hz : ∀ x : ℕ, (if x < 0 then F x else if x = 0 then e x else 0)
          = (if x = 0 then e x else 0) := fun x => by simp
      rw [Finset.sum_congr rfl fun x _ => hz x, Finset.sum_ite_eq' (Finset.range n) 0 e,
        ite_eq_left (Finset.mem_range.mpr hn), Finset.sum_range_zero, zero_add]
  | succ m ih =>
      intro e n hn
      show (∑ x ∈ Finset.range n, (if x < m + 1 then F x else if x = m + 1 then e x else 0))
          = (∑ x ∈ Finset.range (m + 1), F x) + e (m + 1)
      have hpt : ∀ x : ℕ, (if x < m + 1 then F x else if x = m + 1 then e x else 0)
          = (if x < m then F x else if x = m then F x else 0)
            + (if x = m + 1 then e x else 0) := by
        intro x
        rcases Nat.lt_trichotomy x (m + 1) with h | h | h
        · rcases Nat.lt_trichotomy x m with h2 | h2 | h2
          · rw [ite_eq_left h, ite_eq_left h2,
              ite_eq_right (show ¬(x = m + 1) from by omega)]
            ring
          · rw [ite_eq_left h, ite_eq_right (show ¬(x < m) from by omega),
              ite_eq_left (show x = m from h2),
              ite_eq_right (show ¬(x = m + 1) from by omega)]
            ring
          · exact (by omega : False).elim
        · rw [ite_eq_right (show ¬(x < m + 1) from by omega),
            ite_eq_left (show x = m + 1 from h),
            ite_eq_right (show ¬(x < m) from by omega),
            ite_eq_right (show ¬(x = m) from by omega)]
          ring
        · rw [ite_eq_right (show ¬(x < m + 1) from by omega),
            ite_eq_right (show ¬(x = m + 1) from by omega),
            ite_eq_right (show ¬(x < m) from by omega),
            ite_eq_right (show ¬(x = m) from by omega)]
          ring
      have hsumH := ih F n (by omega)
      simp only [hpt, Finset.sum_add_distrib]
      rw [hsumH, Finset.sum_ite_eq' (Finset.range n) (m + 1) e,
        ite_eq_left (Finset.mem_range.mpr hn), Finset.sum_range_succ]

/-! ### The back-substitution -/

/-- The coordinates `[γ 0, …, γ (j-1)]` solving the triangular system
`γ j + ∑_{i<j} A i j γ i = c j`, by downward substitution (structural on `j`:
row `j` only reads the already-computed list). -/
def coordsAux (A : ℕ → ℕ → ℂ) (c : ℕ → ℂ) : ℕ → List ℂ
  | 0 => []
  | j + 1 =>
      coordsAux A c j ++
        [c j - ∑ i ∈ Finset.range j, A i j * (coordsAux A c j).getD i 0]

/-- `coordN A c j` is the `j`-th coordinate of the back-substitution of the
data `c` under the strictly triangular system `A`:
`coordN A c j = c j - ∑_{i<j} A i j * coordN A c i`. -/
def coordN (A : ℕ → ℕ → ℂ) (c : ℕ → ℂ) (j : ℕ) : ℂ :=
  (coordsAux A c (j + 1)).getD j 0

lemma coordsAux_length (A : ℕ → ℕ → ℂ) (c : ℕ → ℂ) :
    ∀ j : ℕ, (coordsAux A c j).length = j := by
  intro j
  induction j with
  | zero => rfl
  | succ j ih =>
      change (coordsAux A c j ++
        [c j - ∑ i ∈ Finset.range j, A i j * (coordsAux A c j).getD i 0]).length = j + 1
      rw [List.length_append, List.length_cons, List.length_nil, ih]

lemma coordsAux_getD (A : ℕ → ℕ → ℂ) (c : ℕ → ℂ) :
    ∀ (d i : ℕ), i < d → (coordsAux A c d).getD i 0 = coordN A c i := by
  intro d
  induction d with
  | zero => intro i hi; exact absurd hi (Nat.not_lt_zero i)
  | succ d ih =>
      intro i hi
      change (coordsAux A c d ++
        [c d - ∑ x ∈ Finset.range d, A x d * (coordsAux A c d).getD x 0]).getD i 0
        = coordN A c i
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with h | h
      · rw [List.getD_append _ _ _ i (by rw [coordsAux_length A c d]; omega), ih i h]
      · subst h
        rw [coordN, coordsAux,
          List.getD_append_right _ _ _ i (by rw [coordsAux_length A c i]),
          coordsAux_length A c i, Nat.sub_self, List.getD_cons_zero]

lemma coordN_zero (A : ℕ → ℕ → ℂ) (c : ℕ → ℂ) : coordN A c 0 = c 0 := by
  rw [coordN, coordsAux, List.getD_append_right _ _ _ 0 (by rw [coordsAux_length A c 0]),
    coordsAux_length A c 0, Nat.sub_self, List.getD_cons_zero, Finset.sum_range_zero,
    sub_zero]

lemma coordN_succ (A : ℕ → ℕ → ℂ) (c : ℕ → ℂ) (j : ℕ) : coordN A c (j + 1)
    = c (j + 1) - ∑ i ∈ Finset.range (j + 1), A i (j + 1) * coordN A c i := by
  rw [coordN, coordsAux,
    List.getD_append_right _ _ _ (j + 1) (by rw [coordsAux_length A c (j + 1)]),
    coordsAux_length A c (j + 1), Nat.sub_self, List.getD_cons_zero]
  congr 1
  refine Finset.sum_congr rfl fun i hi => ?_
  rw [coordsAux_getD A c (j + 1) i (Finset.mem_range.mp hi)]

lemma coordN_congr {A : ℕ → ℕ → ℂ} {c c' : ℕ → ℂ} :
    ∀ j : ℕ, (∀ m ≤ j, c m = c' m) → coordN A c j = coordN A c' j := by
  have main : ∀ j : ℕ, ∀ i : ℕ, i ≤ j → (∀ m ≤ i, c m = c' m) →
      coordN A c i = coordN A c' i := by
    intro j
    induction j with
    | zero =>
        intro i hi h
        have hic : i = 0 := by omega
        subst hic
        rw [coordN_zero, coordN_zero, h 0 (Nat.le_refl _)]
    | succ j ih =>
        intro i hi h
        rcases Nat.lt_or_ge i (j + 1) with hlt | hge
        · exact ih i (by omega) h
        · have hie : i = j + 1 := by omega
          subst hie
          rw [coordN_succ, coordN_succ]
          have hsum : ∑ x ∈ Finset.range (j + 1), A x (j + 1) * coordN A c x
              = ∑ x ∈ Finset.range (j + 1), A x (j + 1) * coordN A c' x := by
            refine Finset.sum_congr rfl fun x hx => ?_
            have hxj : x ≤ j := Nat.le_of_lt_succ (Finset.mem_range.mp hx)
            exact congrArg _ (ih x hxj (fun m hm => h m (by omega)))
          rw [hsum, h (j + 1) (Nat.le_refl _)]
  exact fun j h => main j j (Nat.le_refl _) h

lemma coordN_zero_c (A : ℕ → ℕ → ℂ) : ∀ j : ℕ, coordN A (fun _ => (0 : ℂ)) j = 0 := by
  have main : ∀ j : ℕ, ∀ i : ℕ, i ≤ j → coordN A (fun _ => (0 : ℂ)) i = 0 := by
    intro j
    induction j with
    | zero =>
        intro i hi
        have hic : i = 0 := by omega
        subst hic
        rw [coordN_zero]
    | succ j ih =>
        intro i hi
        rcases Nat.lt_or_ge i (j + 1) with hlt | hge
        · exact ih i (by omega)
        · have hie : i = j + 1 := by omega
          subst hie
          rw [coordN_succ, Finset.sum_eq_zero (fun x hx => by
            rw [ih x (Nat.le_of_lt_succ (Finset.mem_range.mp hx))]; ring), sub_zero]
  exact fun j => main j j (Nat.le_refl _)

/-! ### The dimension-generic extraction -/

/-- **The dimension-generic echelon extraction.**  Let `f : Fin n → S_k` be a
basis in echelon form: `f i` has q-order `i + 1` (`hzero`, `hone`) and its
coefficient of `q^{j+1}` is `A i j` for `i < j` (`hA`).  Then the matrix of any
endomorphism `T` in this basis is the downward back-substitution of the
T-coefficient data `X i m = coeff q^{m+1} (T (f i))` (`hX`).  This is the
`Fin n` generalization of `charpoly_dim2/3/4`; `charpoly_of_eval_eq`
(`CharpolyEngine`) turns the resulting matrix into a literal polynomial. -/
theorem charpoly_dimN {k : ℤ} {n : ℕ} (hn : 0 < n)
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (f : ℕ → CuspForm 𝒮ℒ k) (A X : ℕ → ℕ → ℂ)
    (hzero : ∀ (i m : ℕ), i < n → 1 ≤ m → m ≤ i → (qExpansion 1 (f i)).coeff m = 0)
    (hone : ∀ i : ℕ, i < n → (qExpansion 1 (f i)).coeff (i + 1) = 1)
    (hA : ∀ (i j : ℕ), i < j → j < n → (qExpansion 1 (f i)).coeff (j + 1) = A i j)
    (T : CuspForm 𝒮ℒ k →ₗ[ℂ] CuspForm 𝒮ℒ k)
    (hX : ∀ (i m : ℕ), i < n → m < n → (qExpansion 1 (T (f i))).coeff (m + 1) = X i m) :
    T.charpoly = Matrix.charpoly
      (Matrix.of fun (j i : Fin n) => coordN A (fun m => X i.val m) j.val) := by
  have hne : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
  -- The coefficient trichotomy: at degree `m + 1`, the echelon basis
  -- contributes `A l m` below the diagonal, `1` on it, and `0` above.
  have coefftri : ∀ (m : ℕ), m < n → ∀ l : Fin n, (qExpansion 1 (f l)).coeff (m + 1)
      = if (l : ℕ) < m then A l.val m else if (l : ℕ) = m then 1 else 0 := by
    intro m hm l
    rcases Nat.lt_trichotomy l.val m with h | h | h
    · rw [ite_eq_left h, hA l.val m h hm]
    · rw [ite_eq_right (show ¬((l : ℕ) < m) from by omega), ite_eq_left h, ← h]
      exact hone l.val (by omega)
    · rw [ite_eq_right (show ¬((l : ℕ) < m) from by omega),
        ite_eq_right (show ¬((l : ℕ) = m) from by omega),
        hzero l.val (m + 1) l.isLt (by omega) (by omega)]
  -- The elimination lemma: the coordinates of any `g = ∑ γ l • f l` are the
  -- back-substitution of its q-coefficients (ℕ-indexed via the extension `γd`).
  have coord_eq : ∀ (g : CuspForm 𝒮ℒ k) (γ : Fin n → ℂ), (∑ l, γ l • f l) = g →
      ∀ j : Fin n, γ j = coordN A (fun p => (qExpansion 1 g).coeff (p + 1)) j.val := by
    intro g γ hg
    set γd : ℕ → ℂ := fun x => if h : x < n then γ ⟨x, h⟩ else 0 with hγddef
    have hγd : ∀ x : ℕ, ∀ hx : x < n, γd x = γ ⟨x, hx⟩ := by
      intro x hx
      simp only [hγddef, dite_eq_left hx]
    have hgsum : ∀ m : ℕ, m < n → (qExpansion 1 g).coeff (m + 1)
        = (∑ x ∈ Finset.range m, A x m * γd x) + γd m := by
      intro m hm
      have heq := coeff_sum (Finset.univ (α := Fin n)) γ (fun i : Fin n => f i.val) (m + 1)
      rw [hg] at heq
      have hpt2 : ∀ l : Fin n,
          γ l * (qExpansion 1 (f l.val)).coeff (m + 1)
            = (if (l : ℕ) < m then A l.val m * γd l.val
               else if (l : ℕ) = m then γd l.val else 0) := by
        intro l
        rw [coefftri m hm l, hγd l.val l.isLt]
        split_ifs <;> ring
      rw [Finset.sum_congr rfl fun l _ => hpt2 l] at heq
      rw [Fin.sum_univ_eq_sum_range
        (f := fun x => if x < m then A x m * γd x else if x = m then γd x else 0)] at heq
      rw [sum_range_split (fun x => A x m * γd x) m γd n hm] at heq
      exact heq
    -- strong induction phrased as bounded induction
    have key : ∀ m : ℕ, ∀ j : Fin n, j.val ≤ m →
        γ j = coordN A (fun p => (qExpansion 1 g).coeff (p + 1)) j.val := by
      intro m
      induction m with
      | zero =>
          intro j hj0
          have hjv : j.val = 0 := by omega
          rw [hjv, coordN_zero, hgsum 0 hn, Finset.sum_range_zero, zero_add, hγd 0 hn]
          exact congrArg γ (Fin.ext hjv)
      | succ m ih =>
          intro j hjm
          rcases Nat.lt_or_ge j.val (m + 1) with hj | hj
          · exact ih j (by omega)
          · have hjv : j.val = m + 1 := by omega
            have hjn : m + 1 < n := by rw [← hjv]; exact j.isLt
            rw [hjv, coordN_succ, hgsum (m + 1) hjn]
            have hsub : ∑ x ∈ Finset.range (m + 1),
                A x (m + 1) * coordN A (fun p => (qExpansion 1 g).coeff (p + 1)) x
                = ∑ x ∈ Finset.range (m + 1), A x (m + 1) * γd x := by
              refine Finset.sum_congr rfl fun x hx => ?_
              have hxlt : x < m + 1 := Finset.mem_range.mp hx
              have hxn : x < n := by omega
              have hxm : x ≤ m := by omega
              rw [← ih ⟨x, hxn⟩ hxm, hγd x hxn]
            rw [hsub, add_sub_cancel_left, hγd (m + 1) hjn]
            exact congrArg γ (Fin.ext hjv)
    intro j
    exact key j.val j (Nat.le_refl _)
  -- Linear independence of the echelon family.
  have hli : LinearIndependent ℂ (fun i : Fin n => f i.val) := by
    rw [Fintype.linearIndependent_iff]
    intro γ hγ j
    have h0 : (fun p => (qExpansion 1 (0 : CuspForm 𝒮ℒ k)).coeff (p + 1)) = fun _ => (0 : ℂ) := by
      funext p
      have hz : (qExpansion 1 (0 : CuspForm 𝒮ℒ k)) = 0 := by rw [← qL_apply, map_zero]
      rw [hz]
      simp
    rw [coord_eq 0 γ hγ j, h0, coordN_zero_c]
  -- The basis, and the matrix entries.
  have hcard : Fintype.card (Fin n) = Module.finrank ℂ (CuspForm 𝒮ℒ k) := by simp [hdim]
  let b := basisOfLinearIndependentOfCardEqFinrank hli hcard
  have hb : ∀ i : Fin n, b i = f i.val := by
    intro i
    simp [b]
  rw [← LinearMap.charpoly_toMatrix T b]
  congr 1
  ext j i
  rw [LinearMap.toMatrix_apply, hb i]
  have hg' : (∑ l, b.repr (T (f i.val)) l • f l.val) = T (f i.val) :=
    (Finset.sum_congr rfl fun l _ => by rw [hb l]).trans (b.sum_repr (T (f i.val)))
  rw [coord_eq (T (f i.val)) (b.repr (T (f i.val))) hg' j]
  exact coordN_congr j.val (fun p hp => hX i.val p i.isLt (by omega))

end MaedaLevelOne
