/-- The translated matrices `t·1 − M`, as an explicit literal (symbolic in `t`). -/
def MT (t : ℤ) : Matrix (Fin 6) (Fin 6) ℤ :=
      !![t - 3576, (-1), (0), (0), (0), (0);
      (-2361183241441063680000), t - 3686784, (-2088), (-1), (0), (0);
