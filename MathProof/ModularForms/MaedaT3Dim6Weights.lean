/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [74, 20, 75, 77, 6, 27, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 113)) = RabinCert.toPoly 113 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((15648291925893129960 : ℤ) : ZMod 113) = (27 : ZMod 113) from by decide +kernel,
      show ((-1801792959691693313629163670589782555408 : ℤ) : ZMod 113)
           = (6 : ZMod 113) from by decide +kernel,
      show ((-29720142027699931851872542834818320558026606087848898110720 : ℤ) : ZMod 113)
           = (77 : ZMod 113) from by decide +kernel,
            show ((450998620345887513644663952124036636675666355417626207856798 * 10 ^ 18
            + 569800564669189888 : ℤ) : ZMod 113)
          = (75 : ZMod 113) from by decide +kernel,
            show ((703583078935846240741926655377713987563511209361710146074484 * 10 ^ 37
            + 7083774696693913502019207352519157760 : ℤ) : ZMod 113)
          = (20 : ZMod 113) from by decide +kernel,
            show ((103243508097245366859853583385050155822489494159652290789172 * 10 ^ 56
            + 41525095839626730792081404099907548804036899810814726144 : ℤ) : ZMod 113)
          = (74 : ZMod 113) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 113 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 113 fr).natDegree = 6 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 113 ^ 6 < 2 ^ 41 := by norm_num

lemma h1 : RabinCert.zpxw 113 fr (RabinCert.bitsOf 41 (113 ^ 6)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 113 w fr
      (RabinCert.zpxwsubX 113 fr 41 (113 ^ (6 / 2))) = [1] :=
  ⟨11, by decide +kernel⟩

lemma h2_3 : ∃ w : ℕ, RabinCert.zpgcd 113 w fr
      (RabinCert.zpxwsubX 113 fr 41 (113 ^ (6 / 3))) = [1] :=
  ⟨11, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 6 → ∃ w : ℕ,
      RabinCert.zpgcd 113 w fr
      (RabinCert.zpxwsubX 113 fr 41 (113 ^ (6 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 6 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact h2_3
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [139, 112, 109, 59, 33, 141, 1]

lemma h1_2 : RabinCert.zpxw 179 fr2 (RabinCert.bitsOf 45 (179 ^ 6)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 113) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

