/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [90, 48, 7, 71, 95, 66, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 139)) = RabinCert.toPoly 139 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((-1441611375788089080 : ℤ) : ZMod 139) = (66 : ZMod 139) from by decide +kernel,
      show ((-12936575637510543969707721594291162768 : ℤ) : ZMod 139)
           = (95 : ZMod 139) from by decide +kernel,
      show ((20401220647815605844558987349626661627978819219476053760 : ℤ) : ZMod 139)
           = (71 : ZMod 139) from by decide +kernel,
            show ((279526543248509867110440654447049425060779093946079411673048 * 10 ^ 14
            + 54663642865408 : ℤ) : ZMod 139)
          = (7 : ZMod 139) from by decide +kernel,
            show ((- (652601860129567880461070291445653912342542910174523824921031 * 10 ^ 32
            + 60737877503387575003072461895680) : ℤ) : ZMod 139)
          = (48 : ZMod 139) from by decide +kernel,
            show ((302224057970180180998985267569303792930161226769158710302003 * 10 ^ 50
            + 03697179762181633424098759709976426001709083561984 : ℤ) : ZMod 139)
          = (90 : ZMod 139) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 139 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 139 fr).natDegree = 6 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 139 ^ 6 < 2 ^ 43 := by norm_num

lemma h1 : RabinCert.zpxw 139 fr (RabinCert.bitsOf 43 (139 ^ 6)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 139 w fr
      (RabinCert.zpxwsubX 139 fr 43 (139 ^ (6 / 2))) = [1] :=
  ⟨11, by decide +kernel⟩

lemma h2_3 : ∃ w : ℕ, RabinCert.zpgcd 139 w fr
      (RabinCert.zpxwsubX 139 fr 43 (139 ^ (6 / 3))) = [1] :=
  ⟨11, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 6 → ∃ w : ℕ,
      RabinCert.zpgcd 139 w fr
      (RabinCert.zpxwsubX 139 fr 43 (139 ^ (6 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 6 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact h2_3
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [27, 93, 106, 121, 74, 64, 1]

lemma h1_2 : RabinCert.zpxw 173 fr2 (RabinCert.bitsOf 45 (173 ^ 6)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 139) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

