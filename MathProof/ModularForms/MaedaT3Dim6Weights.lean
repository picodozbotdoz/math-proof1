/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [65, 36, 87, 48, 12, 71, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 103)) = RabinCert.toPoly 103 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((158574346104614272200 : ℤ) : ZMod 103) = (71 : ZMod 103) from by decide +kernel,
      show ((-123783279393370185151527055311172525365648 : ℤ) : ZMod 103)
           = (12 : ZMod 103) from by decide +kernel,
      show ((-16197784554532675163773541389460995600313648799140347767302400 : ℤ) : ZMod 103)
           = (48 : ZMod 103) from by decide +kernel,
            show ((402955817553852208517583496045308760270700232513227183485900 * 10 ^ 22
            + 4060479085039841869568 : ℤ) : ZMod 103)
          = (87 : ZMod 103) from by decide +kernel,
            show ((302400042901635953240961525449879332164063949352861881142037 * 10 ^ 42
            + 248010534908942127198306342061057429555200 : ℤ) : ZMod 103)
          = (36 : ZMod 103) from by decide +kernel,
            show ((- (452754614793414251258493446488539451809090397448582978724661 * 10 ^ 62
            + 716563977345562248663422412300402752791249522870886371612712 * 10 ^ 2
            + 96) : ℤ) : ZMod 103)
          = (65 : ZMod 103) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 103 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 103 fr).natDegree = 6 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 103 ^ 6 < 2 ^ 41 := by norm_num

lemma h1 : RabinCert.zpxw 103 fr (RabinCert.bitsOf 41 (103 ^ 6)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 103 w fr
      (RabinCert.zpxwsubX 103 fr 41 (103 ^ (6 / 2))) = [1] :=
  ⟨11, by decide +kernel⟩

lemma h2_3 : ∃ w : ℕ, RabinCert.zpgcd 103 w fr
      (RabinCert.zpxwsubX 103 fr 41 (103 ^ (6 / 3))) = [1] :=
  ⟨11, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 6 → ∃ w : ℕ,
      RabinCert.zpgcd 103 w fr
      (RabinCert.zpxwsubX 103 fr 41 (103 ^ (6 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 6 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact h2_3
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [14, 117, 76, 15, 123, 3, 1]

lemma h1_2 : RabinCert.zpxw 131 fr2 (RabinCert.bitsOf 43 (131 ^ 6)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) for `T₃` in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 103) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

