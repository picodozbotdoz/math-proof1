/-- Assembly: the n+1 evaluation points, discharged per case. -/
theorem hevals : ∀ i : Fin 8, P.eval ((i : ℕ) : ℤ)
      = (Matrix.scalar (Fin 7) ((i : ℕ) : ℤ) - M).det := by
  intro i
  fin_cases i
  · change P.eval (0 : ℤ)
      = (Matrix.scalar (Fin 7) (0 : ℤ) - M).det
    rw [ev_0, det_0]
  · change P.eval (1 : ℤ)
      = (Matrix.scalar (Fin 7) (1 : ℤ) - M).det
    rw [ev_1, det_1]
  · change P.eval (2 : ℤ)
      = (Matrix.scalar (Fin 7) (2 : ℤ) - M).det
    rw [ev_2, det_2]
  · change P.eval (3 : ℤ)
      = (Matrix.scalar (Fin 7) (3 : ℤ) - M).det
    rw [ev_3, det_3]
  · change P.eval (4 : ℤ)
      = (Matrix.scalar (Fin 7) (4 : ℤ) - M).det
    rw [ev_4, det_4]
  · change P.eval (5 : ℤ)
      = (Matrix.scalar (Fin 7) (5 : ℤ) - M).det
    rw [ev_5, det_5]
  · change P.eval (6 : ℤ)
      = (Matrix.scalar (Fin 7) (6 : ℤ) - M).det
    rw [ev_6, det_6]
  · change P.eval (7 : ℤ)
      = (Matrix.scalar (Fin 7) (7 : ℤ) - M).det
    rw [ev_7, det_7]

