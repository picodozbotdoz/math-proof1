  ring_nf

lemma hmon' : (RabinCert.toPoly 349 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 349 fr).natDegree = 7 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 349 ^ 7 < 2 ^ 60 := by norm_num

lemma h1 : RabinCert.zpxw 349 fr (RabinCert.bitsOf 60 (349 ^ 7)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_7 : ∃ w : ℕ, RabinCert.zpgcd 349 w fr
      (RabinCert.zpxwsubX 349 fr 60 (349 ^ (7 / 7))) = [1] :=
  ⟨12, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 7 → ∃ w : ℕ,
      RabinCert.zpgcd 349 w fr
      (RabinCert.zpxwsubX 349 fr 60 (349 ^ (7 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 7 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact h2_7

