lemma hone : ∀ i : ℕ, i < 8 → (qExpansion 1 (fb i)).coeff (i + 1) = (1 : ℂ) := by
  intro i hi
  interval_cases i
  · simp only [fb]
    exact q1_1
  · simp only [fb]
    exact q2_2
  · simp only [fb]
    exact q3_3
  · simp only [fb]
    exact q4_4
  · simp only [fb]
    exact q5_5
  · simp only [fb]
    exact q6_6
  · simp only [fb]
    exact q7_7
  · simp only [fb]
    exact q8_8

/-- `charpoly_dimN` hypothesis: the strict upper coefficients. -/
