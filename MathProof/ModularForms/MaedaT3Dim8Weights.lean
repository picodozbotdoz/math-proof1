lemma hnd : (RabinCert.toPoly 149 fr).natDegree = 8 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 149 ^ 8 < 2 ^ 58 := by norm_num

lemma h1 : RabinCert.zpxw 149 fr (RabinCert.bitsOf 58 (149 ^ 8)) [1] = [0, 1] :=
