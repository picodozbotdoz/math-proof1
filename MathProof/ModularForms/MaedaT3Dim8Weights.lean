/-- `charpoly_dimN` hypothesis: the strict upper coefficients. -/
lemma hA : ∀ (i j : ℕ), i < j → j < 8 →
    (qExpansion 1 (fb i)).coeff (j + 1) = Atab i j := by
  intro i j hij hjn
  have hib : i < 8 := by omega
  interval_cases i
  · simp only [fb]
    interval_cases j
    · rw [c1, seqP_getD (N := 25) (by norm_num), L1]
      norm_num [List.getD_cons_succ, List.getD_cons_zero]
      rfl
    · rw [c1, seqP_getD (N := 25) (by norm_num), L1]
