lemma finrank_eq : Module.finrank ℂ (CuspForm 𝒮ℒ ((96 : ℕ) : ℤ)) = 8 := by
  apply Module.finrank_eq_of_rank_eq
  rw [CuspForm.discriminantEquiv.rank_eq]
  have h := ModularForm.dimension_level_one 84 (by decide)
  norm_num [Nat.ModEq] at h
  exact_mod_cast h

