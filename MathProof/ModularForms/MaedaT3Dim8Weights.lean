lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 149 w fr
      (RabinCert.zpxwsubX 149 fr 58 (149 ^ (8 / 2))) = [1] :=
  ⟨13, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 8 → ∃ w : ℕ,
      RabinCert.zpgcd 149 w fr
      (RabinCert.zpxwsubX 149 fr 58 (149 ^ (8 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 8 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
