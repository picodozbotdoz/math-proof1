/-- Assembly: the n+1 evaluation points, discharged per case. -/
theorem hevals : ∀ i : Fin 10, P.eval ((i : ℕ) : ℤ)
      = (Matrix.scalar (Fin 9) ((i : ℕ) : ℤ) - M).det := by
  intro i
  fin_cases i
  · change P.eval (0 : ℤ)
      = (Matrix.scalar (Fin 9) (0 : ℤ) - M).det
    rw [ev_0, det_0]
  · change P.eval (1 : ℤ)
      = (Matrix.scalar (Fin 9) (1 : ℤ) - M).det
    rw [ev_1, det_1]
  · change P.eval (2 : ℤ)
      = (Matrix.scalar (Fin 9) (2 : ℤ) - M).det
    rw [ev_2, det_2]
  · change P.eval (3 : ℤ)
      = (Matrix.scalar (Fin 9) (3 : ℤ) - M).det
    rw [ev_3, det_3]
  · change P.eval (4 : ℤ)
      = (Matrix.scalar (Fin 9) (4 : ℤ) - M).det
    rw [ev_4, det_4]
  · change P.eval (5 : ℤ)
      = (Matrix.scalar (Fin 9) (5 : ℤ) - M).det
    rw [ev_5, det_5]
  · change P.eval (6 : ℤ)
      = (Matrix.scalar (Fin 9) (6 : ℤ) - M).det
    rw [ev_6, det_6]
  · change P.eval (7 : ℤ)
      = (Matrix.scalar (Fin 9) (7 : ℤ) - M).det
    rw [ev_7, det_7]
  · change P.eval (8 : ℤ)
      = (Matrix.scalar (Fin 9) (8 : ℤ) - M).det
    rw [ev_8, det_8]
  · change P.eval (9 : ℤ)
      = (Matrix.scalar (Fin 9) (9 : ℤ) - M).det
    rw [ev_9, det_9]

