lemma hmon' : (RabinCert.toPoly 127 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 127 fr).natDegree = 9 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 127 ^ 9 < 2 ^ 63 := by norm_num

lemma h1 : RabinCert.zpxw 127 fr (RabinCert.bitsOf 63 (127 ^ 9)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_3 : ∃ w : ℕ, RabinCert.zpgcd 127 w fr
      (RabinCert.zpxwsubX 127 fr 63 (127 ^ (9 / 3))) = [1] :=
  ⟨14, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 9 → ∃ w : ℕ,
      RabinCert.zpgcd 127 w fr
      (RabinCert.zpxwsubX 127 fr 63 (127 ^ (9 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 9 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact h2_3
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)

