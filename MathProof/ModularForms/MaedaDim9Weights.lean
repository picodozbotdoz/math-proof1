noncomputable def fb : ℕ → CuspForm 𝒮ℒ ((108 : ℕ) : ℤ)
  | 0 => f1
  | 1 => f2
  | 2 => f3
  | 3 => f4
  | 4 => f5
  | 5 => f6
  | 6 => f7
  | 7 => f8
  | 8 => f9
  | _ => 0

