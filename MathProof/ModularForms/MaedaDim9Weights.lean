lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 9 → ∃ w : ℕ,
      RabinCert.zpgcd 137 w fr
      (RabinCert.zpxwsubX 137 fr 64 (137 ^ (9 / q))) = [1] := by
