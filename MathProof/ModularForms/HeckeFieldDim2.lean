import MathProof.ModularForms.HeckeTM
import MathProof.ModularForms.HeckeGeneratedByT2SmallWeights
import MathProof.ModularForms.MaedaWeight24
import MathProof.ModularForms.MaedaSmallWeights
import Mathlib.Algebra.Polynomial.Div
import Mathlib.LinearAlgebra.Charpoly.Basic

/-!
# Dim-2 integrality: every `T_m` is an integer polynomial in `T₂`

At the six weights with `dim S_k = 2` (k = 24, 28, 30, 32, 34, 38) the Hecke
algebra acting on `S_k(SL(2, ℤ))` is generated by `T₂` alone *over `ℤ`*: for
every `m ≥ 1`,

    `T_m = a_m(g₁) • 1 + a_m(g₂) • T₂`,    with `a_m(g₁), a_m(g₂) ∈ ℤ`,

where `(g₁, g₂) = (f₁ − a₂(f₁)•f₂, f₂)` is the Miller basis of `S_k`
(`a_n(g_j) = δ_{nj}` for `n ≤ 2`, from the landed echelon data) and the
scalars are its q-expansion coefficients.  This is the theorem the
hecke-denominators article flagged as "worth formalizing" (probe 3, G1:
verified for all `m ≤ 60` at all six weights).

Proof route (generic; no per-`m` data, no new kernel decides):

* `heckeTM_mem_spanT2` — every prime `T_p` is a polynomial in `T₂`
  (`HeckeGeneratedByT2SmallWeights`, from Maeda irreducibility + commutation), and
  `ℂ[T₂]` is closed under the two-term recursion defining `T_m`
  (`HeckeTM.heckeTM_ge_two`) — strong induction on `m`;
* `exists_smul_pair_of_finrank_two` — Cayley–Hamilton reduces the polynomial
  to degree `< 2 = dim S_k`: `T_m = α • 1 + β • T₂`;
* `heckeTM_dim2` — applying to the echelon basis forms and reading the first
  q-coefficient (`HeckeTM.heckeTM_one`: `a₁(T_m f) = a_m(f)`) determines
  `α = a_m(f₁ − a₂(f₁)•f₂)` and `β = a_m(f₂)`, i.e. the Miller coefficients;
* the integer corollaries pin the Miller coefficients to explicit `seqP`
  values (`MaedaLevelOne.prodForm_coeff`) at the five weights whose basis
  data carries all-`m` coefficient bridges (`MaedaSmallWeights`).  At
  weight 24 `MaedaWeight24` pins only finitely many basis coefficients, so no
  all-`m` integer corollary is stated there — the operator theorem itself
  needs only `a₁, a₂` of the basis and is unaffected.

Everything is light; no `set_option`, no `decide`.
-/

open Polynomial MaedaLevelOne HeckeTM
open UpperHalfPlane ModularForm CuspForm
open scoped MatrixGroups

namespace HeckeFieldDim2

/-! ### Generic layer: q-expansion coefficient linearity -/

section Coeff

variable {k : ℤ}

/-- `qL` respects scalar multiples (public form of the `MaedaLevelOne` /
`HeckeTM` private lemmas). -/
lemma qL_smul' (c : ℂ) (f : CuspForm 𝒮ℒ k) : qL k (c • f) = c • qL k f := by
  rw [qL_apply, qL_apply, qe_smul]

/-- Coefficients are linear in the form: the `n`-th q-coefficient of
`f − c • g` is `a_n(f) − c · a_n(g)`. -/
lemma coeff_sub_smul (f g : CuspForm 𝒮ℒ k) (c : ℂ) (n : ℕ) :
    (qExpansion 1 ⇑(f - c • g)).coeff n
      = (qExpansion 1 f).coeff n - c * (qExpansion 1 g).coeff n := by
  have h : qExpansion 1 ⇑(f - c • g) = qExpansion 1 f - c • qExpansion 1 g := by
    rw [← qL_apply (f - c • g), ← qL_apply f, ← qL_apply g, map_sub, qL_smul']
  rw [h]
  simp

/-- The integer form of `coeff_sub_smul`: if the basis coefficients are
integer-valued (via all-`m` bridges `hu`, `hv`) and `a₂(f₁) = ((s : ℤ) : ℂ)`,
then the Miller coefficient `a_n(f₁ − a₂(f₁)•f₂)` is the integer
`u n − s * v n`. -/
theorem coeff_sub_smul_int {f1 f2 : CuspForm 𝒮ℒ k} {u v : ℕ → ℤ} {s : ℤ}
    (hs : (qExpansion 1 f1).coeff 2 = ((s : ℤ) : ℂ))
    (hu : ∀ n, (qExpansion 1 f1).coeff n = ((u n : ℤ) : ℂ))
    (hv : ∀ n, (qExpansion 1 f2).coeff n = ((v n : ℤ) : ℂ)) (n : ℕ) :
    (qExpansion 1 ⇑(f1 - (qExpansion 1 f1).coeff 2 • f2)).coeff n
      = (((u n - s * v n : ℤ) : ℂ)) := by
  rw [coeff_sub_smul, hu n, hv n, hs]
  push_cast
  ring

end Coeff

/-! ### Generic layer: `T_m` is a polynomial in `T₂`, and of degree < 2 -/

section Span

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- **Generic-`m` span.**  If every prime Hecke operator `T_p` is a polynomial
in `T₂`, then so is every `T_m`: strong induction along the two-term recursion
`HeckeTM.heckeTM_ge_two`, using that `ℂ[T₂]` is closed under subtraction,
scalar multiples and composition (endomorphism multiplication *is*
composition, and `Q ↦ aeval T₂ Q` is multiplicative). -/
theorem heckeTM_mem_spanT2 {k : ℤ} (T2 : CuspForm 𝒮ℒ k →ₗ[ℂ] CuspForm 𝒮ℒ k)
    (hspan : ∀ (q : ℕ) (hq : q.Prime), ∃ Q : ℂ[X], heckeTPₗ k hq = Polynomial.aeval T2 Q)
    (m : ℕ) : ∃ Q : ℂ[X], heckeTM k m = Polynomial.aeval T2 Q := by
  induction m using Nat.strongRecOn with
  | ind n ih =>
    rcases n with _ | n'
    · exact ⟨0, by rw [heckeTM_zero, map_zero]⟩
    · rcases Nat.lt_or_ge (n' + 1) 2 with h1 | h2
      · have hn1 : n' + 1 = 1 := by omega
        rw [hn1]
        exact ⟨1, by rw [heckeTM_id, map_one]; rfl⟩
      · obtain ⟨Qp, hQp⟩ := hspan _ (Nat.minFac_prime (show n' + 1 ≠ 1 by omega))
        have hplt : (n' + 1) / (n' + 1).minFac < n' + 1 :=
          Nat.div_lt_self (by omega)
            (Nat.minFac_prime (show n' + 1 ≠ 1 by omega)).one_lt
        obtain ⟨Qn, hQn⟩ := ih _ hplt
        rw [heckeTM_ge_two k h2, hQp, hQn]
        by_cases hd : (n' + 1).minFac ∣ (n' + 1) / (n' + 1).minFac
        · have hdd : (n' + 1) / (n' + 1).minFac / (n' + 1).minFac < n' + 1 :=
            Nat.lt_of_le_of_lt (Nat.div_le_self _ _) hplt
          obtain ⟨Qd, hQd⟩ := ih _ hdd
          refine ⟨Qp * Qn - ((n' + 1).minFac : ℂ) ^ (k - 1) • Qd, ?_⟩
          simp only [hd, ↓reduceIte, hQd, map_sub, map_smul, map_mul]
          rfl
        · refine ⟨Qp * Qn, ?_⟩
          simp only [hd, ↓reduceIte, smul_zero, sub_zero, map_mul]
          rfl

/-- Degree-2 reduction: on a 2-dimensional space every polynomial in `T₂`
agrees with a linear one `α • 1 + β • T₂` (Cayley–Hamilton + division with
remainder by the monic characteristic polynomial). -/
theorem exists_smul_pair_of_finrank_two {T2 T : V →ₗ[ℂ] V}
    [FiniteDimensional ℂ V] (hfr : Module.finrank ℂ V = 2)
    (hmem : ∃ Q : ℂ[X], T = Polynomial.aeval T2 Q) :
    ∃ α β : ℂ, T = α • LinearMap.id + β • T2 := by
  obtain ⟨Q, hQ⟩ := hmem
  have hPmonic : (LinearMap.charpoly T2).Monic := LinearMap.charpoly_monic T2
  have hPdeg : (LinearMap.charpoly T2).natDegree = 2 := by
    rw [LinearMap.charpoly_natDegree, hfr]
  have hCP : Polynomial.aeval T2 (LinearMap.charpoly T2) = 0 :=
    LinearMap.aeval_self_charpoly T2
  have hR : T = Polynomial.aeval T2 (Q %ₘ LinearMap.charpoly T2) := by
    rw [hQ]
    nth_rewrite 1 [← Polynomial.modByMonic_add_div Q (LinearMap.charpoly T2)]
    rw [map_add, map_mul, hCP, zero_mul, add_zero]
  have hqne : LinearMap.charpoly T2 ≠ 1 := by
    intro h
    rw [h, Polynomial.natDegree_one] at hPdeg
    omega
  have hRdeg : (Q %ₘ LinearMap.charpoly T2).natDegree < 2 := by
    rw [← hPdeg]
    exact Polynomial.natDegree_modByMonic_lt Q hPmonic hqne
  generalize Q %ₘ LinearMap.charpoly T2 = R at hR hRdeg
  refine ⟨R.coeff 0, R.coeff 1, ?_⟩
  have hRm : R = Polynomial.monomial 0 (R.coeff 0) + Polynomial.monomial 1 (R.coeff 1) := by
    ext n
    rcases n with _ | _ | n''
    · simp [Polynomial.coeff_monomial]
    · simp
    · have hz : (Polynomial.monomial 0 (R.coeff 0)
          + Polynomial.monomial 1 (R.coeff 1)).coeff (n'' + 2) = 0 := by
        simp [Polynomial.coeff_monomial]
      rw [hz]
      exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
  rw [hR]
  conv_lhs => rw [hRm]
  rw [map_add, Polynomial.aeval_monomial, pow_zero,
    Polynomial.aeval_monomial, pow_one, ← Algebra.smul_def, ← Algebra.smul_def]
  rfl

end Span

/-! ### The dim-2 Miller-basis identity, generic in `m` -/

section Dim2

variable {k : ℤ}

/-- **Dim-2 integrality (Miller form).**  Let `f₁, f₂` be an echelon basis of
`S_k` (`a₁(f₁) = 1`, `a₁(f₂) = 0`, `a₂(f₂) = 1`), `dim S_k = 2`, and suppose
every prime `T_p` is a polynomial in `T₂`.  Then for every `m ≥ 1`,

    `T_m = a_m(g₁) • 1 + a_m(g₂) • T₂`,  `g₁ = f₁ − a₂(f₁) • f₂`, `g₂ = f₂`,

the Miller basis (`a_n(g_j) = δ_{nj}` for `n ≤ 2`).  The scalar `a_m(g_j)` is
the `m`-th q-expansion coefficient of `g_j`, an integer by the integer
corollaries below (weights 28–38). -/
theorem heckeTM_dim2 (f1 f2 : CuspForm 𝒮ℒ k)
    (hfr : Module.finrank ℂ (CuspForm 𝒮ℒ k) = 2)
    (hspan : ∀ (q : ℕ) (hq : q.Prime), ∃ Q : ℂ[X],
      heckeTPₗ k hq = Polynomial.aeval (heckeTPₗ k Nat.prime_two) Q)
    (ha11 : (qExpansion 1 f1).coeff 1 = 1)
    (ha21 : (qExpansion 1 f2).coeff 1 = 0)
    (ha22 : (qExpansion 1 f2).coeff 2 = 1)
    (m : ℕ) (hm : 1 ≤ m) :
    heckeTM k m
      = (qExpansion 1 ⇑(f1 - (qExpansion 1 f1).coeff 2 • f2)).coeff m • LinearMap.id
        + (qExpansion 1 f2).coeff m • heckeTPₗ k Nat.prime_two := by
  obtain ⟨α, β, hαβ⟩ := exists_smul_pair_of_finrank_two
    (T2 := heckeTPₗ k Nat.prime_two) (T := heckeTM k m) hfr
    (heckeTM_mem_spanT2 _ hspan m)
  have e2 : heckeTM k 2 = heckeTPₗ k Nat.prime_two := heckeTM_prime k Nat.prime_two
  -- the first q-coefficients of `T₂ f_j`, by `heckeTM_one` at `m = 2`
  have hT2f1 : (qExpansion 1 (heckeTPₗ k Nat.prime_two f1)).coeff 1
      = (qExpansion 1 f1).coeff 2 := by
    rw [← e2]; exact heckeTM_one f1 (by norm_num)
  have hT2f2 : (qExpansion 1 (heckeTPₗ k Nat.prime_two f2)).coeff 1
      = (qExpansion 1 f2).coeff 2 := by
    rw [← e2]; exact heckeTM_one f2 (by norm_num)
  -- apply the operator identity at `f₂` and read `a₁`: `a_m(f₂) = β`
  have h2 : heckeTM k m f2 = α • f2 + β • heckeTPₗ k Nat.prime_two f2 := by
    rw [hαβ, LinearMap.add_apply, LinearMap.smul_apply, LinearMap.smul_apply,
      LinearMap.id_apply]
  have hq2 : qExpansion 1 ⇑(heckeTM k m f2)
      = α • qExpansion 1 f2 + β • qExpansion 1 (heckeTPₗ k Nat.prime_two f2) := by
    rw [h2, ← qL_apply (α • f2 + β • heckeTPₗ k Nat.prime_two f2), map_add]
    simp only [qL_apply, qe_smul]
  have h4 := congrArg (fun P : PowerSeries ℂ => PowerSeries.coeff 1 P) hq2
  rw [heckeTM_one f2 hm] at h4
  have hβ : (qExpansion 1 f2).coeff m = β := by simpa [ha21, hT2f2, ha22] using h4
  -- apply at `f₁` and read `a₁`: `a_m(f₁) = α + β · a₂(f₁)`
  have h3 : heckeTM k m f1 = α • f1 + β • heckeTPₗ k Nat.prime_two f1 := by
    rw [hαβ, LinearMap.add_apply, LinearMap.smul_apply, LinearMap.smul_apply,
      LinearMap.id_apply]
  have hq1 : qExpansion 1 ⇑(heckeTM k m f1)
      = α • qExpansion 1 f1 + β • qExpansion 1 (heckeTPₗ k Nat.prime_two f1) := by
    rw [h3, ← qL_apply (α • f1 + β • heckeTPₗ k Nat.prime_two f1), map_add]
    simp only [qL_apply, qe_smul]
  have h5 := congrArg (fun P : PowerSeries ℂ => PowerSeries.coeff 1 P) hq1
  rw [heckeTM_one f1 hm] at h5
  have h5' : (qExpansion 1 f1).coeff m = α + β * (qExpansion 1 f1).coeff 2 := by
    simpa [ha11, hT2f1] using h5
  -- solve for `α`, `β`
  have hαd : α = (qExpansion 1 f1).coeff m
      - (qExpansion 1 f1).coeff 2 * (qExpansion 1 f2).coeff m := by
    rw [← hβ] at h5'
    linear_combination -h5'
  rw [hαβ, hαd, ← hβ, coeff_sub_smul]

end Dim2

/-! ### Weight 24 -/

section Weight24

/-- The landed hand-rolled `T₂` on `S₂₄` is the landed prime operator. -/
lemma heckeT2_eq_heckeTPₗ_weight24 : MaedaWeight24.heckeT2
    = heckeTPₗ ((24 : ℕ) : ℤ) Nat.prime_two := rfl

/-- `dim S₂₄ = 2`. -/
lemma finrank_weight24 : Module.finrank ℂ (CuspForm 𝒮ℒ ((24 : ℕ) : ℤ)) = 2 := by
  apply Module.finrank_eq_of_rank_eq
  rw [CuspForm.discriminantEquiv.rank_eq]
  have h := ModularForm.dimension_level_one 12 (by decide)
  norm_num [Nat.ModEq] at h
  exact_mod_cast h

/-- Every prime `T_p` on `S₂₄` is a polynomial in `T₂`. -/
theorem hspan_weight24 : ∀ (q : ℕ) (hq : q.Prime), ∃ Q : ℂ[X],
    heckeTPₗ ((24 : ℕ) : ℤ) hq
      = Polynomial.aeval (heckeTPₗ ((24 : ℕ) : ℤ) Nat.prime_two) Q := by
  intro q hq
  obtain ⟨Q, hQ⟩ := HeckeGeneratedByT2Weights.heckeTP_mem_spanT2_weight24 hq
  rw [heckeT2_eq_heckeTPₗ_weight24] at hQ
  exact ⟨Q, hQ⟩

/-- **Weight 24 (dim 2).**  `∀ m ≥ 1, T_m = a_m(g₁) • 1 + a_m(g₂) • T₂` with
the Miller basis `g₁ = Δ E₄³ − 696 • Δ²`, `g₂ = Δ²`. -/
theorem dim2_weight24 (m : ℕ) (hm : 1 ≤ m) :
    heckeTM ((24 : ℕ) : ℤ) m
      = (qExpansion 1 ⇑(MaedaWeight24.f1
          - (qExpansion 1 MaedaWeight24.f1).coeff 2 • MaedaWeight24.f2)).coeff m
          • LinearMap.id
        + (qExpansion 1 MaedaWeight24.f2).coeff m
          • heckeTPₗ ((24 : ℕ) : ℤ) Nat.prime_two :=
  heckeTM_dim2 MaedaWeight24.f1 MaedaWeight24.f2 finrank_weight24 hspan_weight24
    MaedaWeight24.f1_coeff.2.1 MaedaWeight24.f2_coeff.2.1 MaedaWeight24.f2_coeff.2.2.1
    m hm

end Weight24

/-! ### Weights 28–38 (from `MaedaSmallWeights`) -/

section Weight28

/-- **Weight 28 (dim 2).**  `∀ m ≥ 1, T_m = a_m(g₁) • 1 + a_m(g₂) • T₂` with
the Miller basis `g₁ = Δ E₄⁴ − 936 • Δ² E₄`, `g₂ = Δ² E₄`. -/
theorem dim2_weight28 (m : ℕ) (hm : 1 ≤ m) :
    heckeTM ((28 : ℕ) : ℤ) m
      = (qExpansion 1 ⇑(MaedaWeight28.f1
          - (qExpansion 1 MaedaWeight28.f1).coeff 2 • MaedaWeight28.f2)).coeff m
          • LinearMap.id
        + (qExpansion 1 MaedaWeight28.f2).coeff m
          • heckeTPₗ ((28 : ℕ) : ℤ) Nat.prime_two :=
  heckeTM_dim2 MaedaWeight28.f1 MaedaWeight28.f2 MaedaWeight28.finrank_eq
    (fun _ hq => HeckeGeneratedByT2Weights.heckeTP_mem_spanT2_weight28 hq)
    MaedaWeight28.q1_1 MaedaWeight28.q2_1 MaedaWeight28.q2_2 m hm

/-- The Miller coefficient `a_m(g₁)` at weight 28 is the integer
`seqP 0 4 0 m − 936 · seqP 1 1 0 m`. -/
theorem aM1_int_weight28 (m : ℕ) :
    (qExpansion 1 ⇑(MaedaWeight28.f1
        - (qExpansion 1 MaedaWeight28.f1).coeff 2 • MaedaWeight28.f2)).coeff m
      = (((seqP 0 4 0 m - 936 * seqP 1 1 0 m : ℤ) : ℂ)) :=
  coeff_sub_smul_int (by rw [MaedaWeight28.q1_2]; norm_num)
    MaedaWeight28.c1 MaedaWeight28.c2 m

/-- The Miller coefficient `a_m(g₂)` at weight 28 is the integer
`seqP 1 1 0 m`. -/
theorem aM2_int_weight28 (m : ℕ) :
    (qExpansion 1 MaedaWeight28.f2).coeff m = ((seqP 1 1 0 m : ℤ) : ℂ) :=
  MaedaWeight28.c2 m

/-- **Weight 28, integer form:** `T_m` is the integer polynomial
`a_m(g₁) • 1 + a_m(g₂) • T₂` in `T₂`. -/
theorem int_weight28 (m : ℕ) (hm : 1 ≤ m) :
    heckeTM ((28 : ℕ) : ℤ) m
      = ((seqP 0 4 0 m - 936 * seqP 1 1 0 m : ℤ) : ℂ) • LinearMap.id
        + ((seqP 1 1 0 m : ℤ) : ℂ) • heckeTPₗ ((28 : ℕ) : ℤ) Nat.prime_two := by
  rw [dim2_weight28 m hm, aM1_int_weight28 m, aM2_int_weight28 m]

end Weight28

section Weight30

/-- **Weight 30 (dim 2).**  `∀ m ≥ 1, T_m = a_m(g₁) • 1 + a_m(g₂) • T₂` with
the Miller basis `g₁ = Δ E₄³ E₆ − 192 • Δ² E₆`, `g₂ = Δ² E₆`. -/
theorem dim2_weight30 (m : ℕ) (hm : 1 ≤ m) :
    heckeTM ((30 : ℕ) : ℤ) m
      = (qExpansion 1 ⇑(MaedaWeight30.f1
          - (qExpansion 1 MaedaWeight30.f1).coeff 2 • MaedaWeight30.f2)).coeff m
          • LinearMap.id
        + (qExpansion 1 MaedaWeight30.f2).coeff m
          • heckeTPₗ ((30 : ℕ) : ℤ) Nat.prime_two :=
  heckeTM_dim2 MaedaWeight30.f1 MaedaWeight30.f2 MaedaWeight30.finrank_eq
    (fun _ hq => HeckeGeneratedByT2Weights.heckeTP_mem_spanT2_weight30 hq)
    MaedaWeight30.q1_1 MaedaWeight30.q2_1 MaedaWeight30.q2_2 m hm

/-- The Miller coefficient `a_m(g₁)` at weight 30 is the integer
`seqP 0 3 1 m − 192 · seqP 1 0 1 m`. -/
theorem aM1_int_weight30 (m : ℕ) :
    (qExpansion 1 ⇑(MaedaWeight30.f1
        - (qExpansion 1 MaedaWeight30.f1).coeff 2 • MaedaWeight30.f2)).coeff m
      = (((seqP 0 3 1 m - 192 * seqP 1 0 1 m : ℤ) : ℂ)) :=
  coeff_sub_smul_int (by rw [MaedaWeight30.q1_2]; norm_num)
    MaedaWeight30.c1 MaedaWeight30.c2 m

/-- The Miller coefficient `a_m(g₂)` at weight 30 is the integer
`seqP 1 0 1 m`. -/
theorem aM2_int_weight30 (m : ℕ) :
    (qExpansion 1 MaedaWeight30.f2).coeff m = ((seqP 1 0 1 m : ℤ) : ℂ) :=
  MaedaWeight30.c2 m

/-- **Weight 30, integer form:** `T_m` is the integer polynomial
`a_m(g₁) • 1 + a_m(g₂) • T₂` in `T₂`. -/
theorem int_weight30 (m : ℕ) (hm : 1 ≤ m) :
    heckeTM ((30 : ℕ) : ℤ) m
      = ((seqP 0 3 1 m - 192 * seqP 1 0 1 m : ℤ) : ℂ) • LinearMap.id
        + ((seqP 1 0 1 m : ℤ) : ℂ) • heckeTPₗ ((30 : ℕ) : ℤ) Nat.prime_two := by
  rw [dim2_weight30 m hm, aM1_int_weight30 m, aM2_int_weight30 m]

end Weight30

section Weight32

/-- **Weight 32 (dim 2).**  `∀ m ≥ 1, T_m = a_m(g₁) • 1 + a_m(g₂) • T₂` with
the Miller basis `g₁ = Δ E₄⁵ − 1176 • Δ² E₄²`, `g₂ = Δ² E₄²`. -/
theorem dim2_weight32 (m : ℕ) (hm : 1 ≤ m) :
    heckeTM ((32 : ℕ) : ℤ) m
      = (qExpansion 1 ⇑(MaedaWeight32.f1
          - (qExpansion 1 MaedaWeight32.f1).coeff 2 • MaedaWeight32.f2)).coeff m
          • LinearMap.id
        + (qExpansion 1 MaedaWeight32.f2).coeff m
          • heckeTPₗ ((32 : ℕ) : ℤ) Nat.prime_two :=
  heckeTM_dim2 MaedaWeight32.f1 MaedaWeight32.f2 MaedaWeight32.finrank_eq
    (fun _ hq => HeckeGeneratedByT2Weights.heckeTP_mem_spanT2_weight32 hq)
    MaedaWeight32.q1_1 MaedaWeight32.q2_1 MaedaWeight32.q2_2 m hm

/-- The Miller coefficient `a_m(g₁)` at weight 32 is the integer
`seqP 0 5 0 m − 1176 · seqP 1 2 0 m`. -/
theorem aM1_int_weight32 (m : ℕ) :
    (qExpansion 1 ⇑(MaedaWeight32.f1
        - (qExpansion 1 MaedaWeight32.f1).coeff 2 • MaedaWeight32.f2)).coeff m
      = (((seqP 0 5 0 m - 1176 * seqP 1 2 0 m : ℤ) : ℂ)) :=
  coeff_sub_smul_int (by rw [MaedaWeight32.q1_2]; norm_num)
    MaedaWeight32.c1 MaedaWeight32.c2 m

/-- The Miller coefficient `a_m(g₂)` at weight 32 is the integer
`seqP 1 2 0 m`. -/
theorem aM2_int_weight32 (m : ℕ) :
    (qExpansion 1 MaedaWeight32.f2).coeff m = ((seqP 1 2 0 m : ℤ) : ℂ) :=
  MaedaWeight32.c2 m

/-- **Weight 32, integer form:** `T_m` is the integer polynomial
`a_m(g₁) • 1 + a_m(g₂) • T₂` in `T₂`. -/
theorem int_weight32 (m : ℕ) (hm : 1 ≤ m) :
    heckeTM ((32 : ℕ) : ℤ) m
