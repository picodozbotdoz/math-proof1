import MathProof.ModularForms.HeckeIndex
import MathProof.ModularForms.HeckeFieldRat

/-!
# Generators of the Hecke ring of `S_k`

Iteration 24 (hecke-ring-gens).  For a level-one weight with
`n = dim S_k`, the Hecke ring `𝕋 = span_ℤ {T_1, …, T_n}`
(`HeckeIndex.heckeRing`) is generated, as a ring, by few prime operators:

* `heckeRing_eq_closure`: if every `T_j` (`j ≤ n`) lies in the subring
  generated by `{T_p : p ∈ ps}`, then `𝕋` equals that subring (`⊇` because
  each `T_p ∈ 𝕋`, `HeckeIndex.heckeTM_mem_lattice`);
* `heckeTM_mem_closure_of_smooth`: `T_m ∈ ℤ[T_p : p ∈ ps]` whenever every
  prime factor of `m` lies in `ps` (strong induction through the defining
  recursion of `T_m`: the multiplicativity / prime-power calculus of
  `HeckeTM`, e.g. `T₄ = T₂² − 2^(k-1)`, `T₆ = T₂T₃`, `T₉ = T₃² − 3^(k-1)`);
* the certificate-free corollaries, valid at every weight in their
  dimension range:

  | generators | range | theorem |
  |---|---|---|
  | `T₂, T₃, T₅, T₇` | `n ≤ 10` | `heckeRing_eq_closure_gens2357` |
  | `T₂, T₃, T₅` | `n ≤ 6` | `heckeRing_eq_closure_gens235` |
  | `T₂, T₃` | `n ≤ 4` | `heckeRing_eq_closure_gens23` |
  | `T₂` | `n ≤ 2` | `heckeRing_eq_closure_gens2` |

* `heckeRing_eq_closure_gens235_of_t7`: for `n ≤ 10`, `𝕋 = ℤ[T₂, T₃, T₅]`
  as soon as `T₇ ∈ ℤ[T₂, T₃, T₅]`; and `heckeTM_mem_closure_of_rows`
  certifies such a membership from an integer relation
  `T₇ = ∑ cₜ T_{Mₜ}` with smooth `Mₜ`, checked on the first `q`-coefficients
  of an echelon basis (`op_eq_of_first_coeff`: an operator in the
  `T`-span is determined by the row `i ↦ a₁(X fᵢ)`).

Everything here is light and analytic: no `set_option`, no kernel decides
beyond the small `Nat` divisibility facts of the corollaries.
-/

namespace HeckeRingGens

open HeckeIndex HeckeTM HeckeFieldRat MaedaLevelOne
open UpperHalfPlane ModularForm CuspForm
open scoped MatrixGroups

/-- The prime operators `{T_p : p ∈ ps}` inside `End(S_k)`. -/
def gensOf (k : ℤ) (ps : List ℕ) : Set (Module.End ℂ (CuspForm 𝒮ℒ k)) :=
  {x | ∃ p ∈ ps, x = heckeTM k p}

/-- Multiplication in `End(S_k)` is composition (definitional). -/
private lemma comp_eq_mul {k : ℤ} (X Y : CuspForm 𝒮ℒ k →ₗ[ℂ] CuspForm 𝒮ℒ k) :
    X ∘ₗ Y = (X * Y : Module.End ℂ (CuspForm 𝒮ℒ k)) := rfl

/-- `T₁ = 1` in `End(S_k)`. -/
private lemma heckeTM_one_eq (k : ℤ) : heckeTM k 1 = 1 := by
  rw [heckeTM_id]
  rfl

/-- For `k ≥ 1` the correction scalar `p^(k-1)` acts as a natural multiple. -/
private lemma smul_pow_mem {k : ℤ} (hk : 1 ≤ k)
    (S : Subring (Module.End ℂ (CuspForm 𝒮ℒ k))) (p : ℕ)
    {X : Module.End ℂ (CuspForm 𝒮ℒ k)} (hX : X ∈ S) :
    ((p : ℂ) ^ (k - 1)) • X ∈ S := by
  obtain ⟨e, he⟩ : ∃ e : ℕ, k - 1 = (e : ℤ) := ⟨(k - 1).toNat, by omega⟩
  rw [he, zpow_natCast, ← Nat.cast_pow, Nat.cast_smul_eq_nsmul ℂ]
  exact nsmul_mem hX _

/-! ### Smooth membership -/

section Smooth

variable {k : ℤ}

/-- **Every `ps`-smooth `T_m` lies in `ℤ[T_p : p ∈ ps]`**: if every prime
factor of `m ≥ 1` lies in `ps` and `k ≥ 1`, then
`T_m ∈ Subring.closure (gensOf k ps)` — strong induction through the
defining recursion `T_m = T_q T_{m/q} − q^(k-1) [q ∣ m/q] T_{m/q²}`
(`q = minFac m`). -/
theorem heckeTM_mem_closure_of_smooth (hk : 1 ≤ k) (ps : List ℕ) (m : ℕ) (hm : 1 ≤ m)
    (hsm : ∀ p : ℕ, p.Prime → p ∣ m → p ∈ ps) :
    heckeTM k m ∈ Subring.closure (gensOf k ps) := by
  induction m using Nat.strongRecOn with
  | ind m ih =>
    rcases Nat.lt_or_ge m 2 with hm2 | hm2
    · obtain rfl : m = 1 := by omega
      rw [heckeTM_one_eq]
      exact Subring.one_mem _
    · have hmp : m.minFac.Prime := Nat.minFac_prime (show m ≠ 1 by omega)
      have hdvd : m.minFac ∣ m := Nat.minFac_dvd m
      have hq1 : 1 ≤ m / m.minFac := Nat.div_pos (Nat.le_of_dvd hm hdvd) hmp.pos
      have hqlt : m / m.minFac < m := Nat.div_lt_self (by omega) hmp.one_lt
      have hsm1 : ∀ p : ℕ, p.Prime → p ∣ m / m.minFac → p ∈ ps :=
        fun p hpr hpm => hsm p hpr (hpm.trans (Nat.div_dvd_of_dvd hdvd))
      have hmem1 := ih _ hqlt hq1 hsm1
      have hgen : heckeTPₗ k hmp ∈ Subring.closure (gensOf k ps) := by
        rw [← heckeTM_prime k hmp]
        exact Subring.subset_closure ⟨m.minFac, hsm _ hmp hdvd, rfl⟩
      rw [heckeTM_ge_two k hm2, comp_eq_mul]
      by_cases hc : m.minFac ∣ m / m.minFac
      · have hc1 : 1 ≤ m / m.minFac / m.minFac :=
          Nat.div_pos (Nat.le_of_dvd hq1 hc) hmp.pos
        have hclt : m / m.minFac / m.minFac < m :=
          (Nat.div_le_self _ _).trans_lt hqlt
        have hsm2 : ∀ p : ℕ, p.Prime → p ∣ m / m.minFac / m.minFac → p ∈ ps :=
          fun p hpr hpm => hsm1 p hpr (hpm.trans (Nat.div_dvd_of_dvd hc))
        rw [ite_eq_left hc]
        exact Subring.sub_mem _ (Subring.mul_mem _ hgen hmem1)
          (smul_pow_mem hk _ _ (ih _ hclt hc1 hsm2))
      · rw [ite_eq_right hc, smul_zero, sub_zero]
        exact Subring.mul_mem _ hgen hmem1

/-- **Divisibility form of smoothness**: if `m ∣ (∏ ps)^e` (a decidable `Nat`
fact) and `ps` consists of primes, then `T_m ∈ ℤ[T_p : p ∈ ps]`. -/
theorem heckeTM_mem_closure_of_dvd (hk : 1 ≤ k) (ps : List ℕ)
    (hps : ∀ p ∈ ps, p.Prime) (m : ℕ) (hm : 1 ≤ m) (e : ℕ)
    (hdvd : ps.prod ^ e % m = 0) :
    heckeTM k m ∈ Subring.closure (gensOf k ps) := by
  refine heckeTM_mem_closure_of_smooth hk ps m hm fun p hp hpm => ?_
  have h1 : p ∣ ps.prod := hp.dvd_of_dvd_pow (hpm.trans (Nat.dvd_of_mod_eq_zero hdvd))
  obtain ⟨a, ha, hpa⟩ := (Prime.dvd_prod_iff hp.prime).mp h1
  rwa [(Nat.prime_dvd_prime_iff_eq hp (hps a ha)).mp hpa]

end Smooth

/-! ### The Hecke-ring transport -/

section Transport

variable {k : ℤ} {n : ℕ}

/-- **Transport**: if every `T_{j+1}` (`j < n`) lies in a subring `R`, then
`𝕋 ≤ R` (the Hecke lattice is the ℤ-span of the `T`-family). -/
theorem heckeRing_le_of_mem (g : ℕ → CuspForm 𝒮ℒ k) (hn : 0 < n)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) (R : Subring (Module.End ℂ (CuspForm 𝒮ℒ k)))
    (hmem : ∀ j : Fin n, heckeTM k (j.val + 1) ∈ R) :
    heckeRing g hn hg hdim hδ hint hk ≤ R := by
  intro x hx
  have hx' : x ∈ heckeLattice k n := hx
  obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp hx'
  exact sum_mem fun j _ => zsmul_mem (hmem j) (c j)

/-- **`𝕋 = ℤ[T_p : p ∈ ps]`** as soon as every `T_{j+1}` (`j < n`) lies in
the subring generated by the `T_p` (`p ∈ ps`, all `p ≥ 1`). -/
theorem heckeRing_eq_closure (g : ℕ → CuspForm 𝒮ℒ k) (hn : 0 < n)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) (ps : List ℕ) (hps : ∀ p ∈ ps, 1 ≤ p)
    (hcov : ∀ j : Fin n, heckeTM k (j.val + 1) ∈ Subring.closure (gensOf k ps)) :
    heckeRing g hn hg hdim hδ hint hk = Subring.closure (gensOf k ps) := by
  refine le_antisymm (heckeRing_le_of_mem g hn hg hdim hδ hint hk _ hcov) ?_
  refine Subring.closure_le.2 ?_
  rintro x ⟨p, hp, rfl⟩
  exact heckeTM_mem_lattice g hn hg hdim hδ hint p (hps p hp)

/-- **Smooth initial segment**: if `ps` consists of primes, `n ≤ N`, and
every `m ≤ N` divides `(∏ ps)^N`, then `𝕋 = ℤ[T_p : p ∈ ps]`. -/
theorem heckeRing_eq_closure_of_le (g : ℕ → CuspForm 𝒮ℒ k) (hn : 0 < n)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) (ps : List ℕ) (hps : ∀ p ∈ ps, p.Prime) (N : ℕ) (hnN : n ≤ N)
    (hcovN : ∀ m < N, ps.prod ^ N % (m + 1) = 0) :
    heckeRing g hn hg hdim hδ hint hk = Subring.closure (gensOf k ps) :=
  heckeRing_eq_closure g hn hg hdim hδ hint hk ps (fun p hp => (hps p hp).one_lt.le)
    fun j => heckeTM_mem_closure_of_dvd hk ps hps _ (by omega) N
      (hcovN j.val (by omega))

/-- **`𝕋 = ℤ[T₂, T₃, T₅, T₇]` at every weight with `dim S_k ≤ 10`**
(certificate-free: every `m ≤ 10` is `{2,3,5,7}`-smooth). -/
theorem heckeRing_eq_closure_gens2357 (g : ℕ → CuspForm 𝒮ℒ k) (hn : 0 < n)
    (hn10 : n ≤ 10)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) :
    heckeRing g hn hg hdim hδ hint hk = Subring.closure (gensOf k [2, 3, 5, 7]) :=
  heckeRing_eq_closure_of_le g hn hg hdim hδ hint hk _
    (by simp [Nat.prime_two, Nat.prime_three, Nat.prime_five, Nat.prime_seven]) 10 hn10
    (by decide +kernel)

/-- **`𝕋 = ℤ[T₂, T₃, T₅]` at every weight with `dim S_k ≤ 6`**. -/
theorem heckeRing_eq_closure_gens235 (g : ℕ → CuspForm 𝒮ℒ k) (hn : 0 < n)
    (hn6 : n ≤ 6)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) :
    heckeRing g hn hg hdim hδ hint hk = Subring.closure (gensOf k [2, 3, 5]) :=
  heckeRing_eq_closure_of_le g hn hg hdim hδ hint hk _
    (by simp [Nat.prime_two, Nat.prime_three, Nat.prime_five]) 6 hn6 (by decide +kernel)

/-- **`𝕋 = ℤ[T₂, T₃]` at every weight with `dim S_k ≤ 4`**. -/
theorem heckeRing_eq_closure_gens23 (g : ℕ → CuspForm 𝒮ℒ k) (hn : 0 < n)
    (hn4 : n ≤ 4)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) :
    heckeRing g hn hg hdim hδ hint hk = Subring.closure (gensOf k [2, 3]) :=
  heckeRing_eq_closure_of_le g hn hg hdim hδ hint hk _
    (by simp [Nat.prime_two, Nat.prime_three]) 4 hn4 (by decide +kernel)

/-- **`𝕋 = ℤ[T₂]` at every weight with `dim S_k ≤ 2`**. -/
theorem heckeRing_eq_closure_gens2 (g : ℕ → CuspForm 𝒮ℒ k) (hn : 0 < n)
    (hn2 : n ≤ 2)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) :
    heckeRing g hn hg hdim hδ hint hk = Subring.closure (gensOf k [2]) :=
  heckeRing_eq_closure_of_le g hn hg hdim hδ hint hk _
    (by simp [Nat.prime_two]) 2 hn2 (by decide +kernel)

/-- **`𝕋 = ℤ[T₂, T₃, T₅]` from a `T₇` membership** (`dim S_k ≤ 10`). -/
theorem heckeRing_eq_closure_gens235_of_t7 (g : ℕ → CuspForm 𝒮ℒ k) (hn : 0 < n)
    (hn10 : n ≤ 10)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) (hT7 : heckeTM k 7 ∈ Subring.closure (gensOf k [2, 3, 5])) :
    heckeRing g hn hg hdim hδ hint hk = Subring.closure (gensOf k [2, 3, 5]) := by
  have hps : ∀ p ∈ [2, 3, 5], p.Prime := by
    simp [Nat.prime_two, Nat.prime_three, Nat.prime_five]
  have hsm : ∀ m < 10, m + 1 ≠ 7 → ([2, 3, 5] : List ℕ).prod ^ 10 % (m + 1) = 0 := by
    decide +kernel
  refine heckeRing_eq_closure g hn hg hdim hδ hint hk _
    (fun p hp => (hps p hp).one_lt.le) fun j => ?_
  by_cases h7 : j.val + 1 = 7
  · rw [h7]
    exact hT7
  · exact heckeTM_mem_closure_of_dvd hk _ hps _ (by omega) 10 (hsm j.val (by omega) h7)

end Transport

/-! ### First-coefficient rows detect operators in the `T`-span -/

section Row

variable {k : ℤ} {n : ℕ}

/-- Coefficients of a difference. -/
private lemma coeff_sub' (f g : CuspForm 𝒮ℒ k) (m : ℕ) :
    (qExpansion 1 ⇑(f - g)).coeff m
      = (qExpansion 1 ⇑f).coeff m - (qExpansion 1 ⇑g).coeff m := by
  have h1 : (qL k (f - g)).coeff m = (qL k f - qL k g).coeff m := by rw [map_sub]
  have h2 : (qL k f - qL k g).coeff m = (qL k f).coeff m - (qL k g).coeff m := by
    rw [map_sub]
  rw [← qL_apply (f - g), ← qL_apply f, ← qL_apply g, h1, h2]

/-- **Row injectivity**: two operators in the ℂ-span of the `T`-family are
equal as soon as the first q-coefficients of `X fᵢ` and `Y fᵢ` agree over an
echelon basis `f` (evaluate at the largest index carrying a nonzero
coordinate — the echelon shape kills every smaller index). -/
theorem op_eq_of_first_coeff (f : ℕ → CuspForm 𝒮ℒ k)
    (hzero : ∀ (i m : ℕ), i < n → 1 ≤ m → m ≤ i → (qExpansion 1 (f i)).coeff m = 0)
    (hone : ∀ i : ℕ, i < n → (qExpansion 1 (f i)).coeff (i + 1) = 1)
    (X Y : CuspForm 𝒮ℒ k →ₗ[ℂ] CuspForm 𝒮ℒ k)
    (hX : X ∈ Submodule.span ℂ (Set.range fun j : Fin n => heckeTM k (j.val + 1)))
    (hY : Y ∈ Submodule.span ℂ (Set.range fun j : Fin n => heckeTM k (j.val + 1)))
    (hrow : ∀ i : ℕ, i < n →
      (qExpansion 1 (X (f i))).coeff 1 = (qExpansion 1 (Y (f i))).coeff 1) :
    X = Y := by
  classical
  by_contra hne
  obtain ⟨cX, hcX⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp hX
  obtain ⟨cY, hcY⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp hY
  let γ : Fin n → ℂ := fun j => cX j - cY j
  have hZsum : X - Y = ∑ j : Fin n, γ j • heckeTM k (j.val + 1) := by
    rw [← hcX, ← hcY, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun j _ => (sub_smul _ _ _).symm
  have hzero' : ∀ i : ℕ, i < n → (qExpansion 1 ((X - Y) (f i))).coeff 1 = 0 := by
    intro i hi
    rw [LinearMap.sub_apply, coeff_sub', hrow i hi, sub_self]
  let S : Finset (Fin n) := Finset.univ.filter (fun j => γ j ≠ 0)
  have hSne : S.Nonempty := by
    by_contra hSe
    have hall : ∀ j : Fin n, γ j = 0 := by
      intro j
      by_contra hj
      exact hSe ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_univ j, hj⟩⟩
    refine hne (sub_eq_zero.mp ?_)
    rw [hZsum]
    exact Finset.sum_eq_zero fun j _ => by rw [hall j, zero_smul]
  let jmax : Fin n := S.max' hSne
  have hjmem : γ jmax ≠ 0 := (Finset.mem_filter.mp (S.max'_mem hSne)).2
  have hjle : ∀ j : Fin n, γ j ≠ 0 → j.val ≤ jmax.val := fun j hj =>
    Finset.le_max' S j (Finset.mem_filter.mpr ⟨Finset.mem_univ j, hj⟩)
  have hap : (X - Y) (f jmax.val)
      = ∑ j : Fin n, γ j • heckeTM k (j.val + 1) (f jmax.val) := by
    rw [hZsum, LinearMap.sum_apply]
    simp only [LinearMap.smul_apply]
  have h1 := hzero' jmax.val jmax.isLt
  rw [hap, coeff_sum Finset.univ γ (fun j => heckeTM k (j.val + 1) (f jmax.val)) 1,
    Finset.sum_eq_single jmax] at h1
  · refine hjmem ?_
    rw [heckeTM_one _ (by omega : 1 ≤ jmax.val + 1), hone jmax.val jmax.isLt, mul_one] at h1
    exact h1
  · intro b _ hb
    by_cases hb0 : γ b = 0
    · rw [hb0, zero_mul]
    · have hblt : b.val < jmax.val :=
        lt_of_le_of_ne (hjle b hb0) (fun h => hb (Fin.val_inj.mp h))
      rw [heckeTM_one _ (by omega : 1 ≤ b.val + 1),
        hzero jmax.val (b.val + 1) jmax.isLt (by omega) (by omega), mul_zero]
  · intro hcon
    exact absurd (Finset.mem_univ jmax) hcon

/-- **Row certificate for a membership**: over echelon data with integer
coefficients, an integer relation `T_{m₀} = ∑_{t<s} cₜ T_{Mₜ}` — checked on
the first coefficients `a_{m₀}(fᵢ) = ∑ cₜ a_{Mₜ}(fᵢ)` (`i < n`) — with every
`Mₜ ∣ (∏ ps)^e` puts `T_{m₀}` in `ℤ[T_p : p ∈ ps]`. -/
theorem heckeTM_mem_closure_of_rows (hn : 0 < n)
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (f : ℕ → CuspForm 𝒮ℒ k) (A : ℕ → ℕ → ℂ)
    (hzero : ∀ (i m : ℕ), i < n → 1 ≤ m → m ≤ i → (qExpansion 1 (f i)).coeff m = 0)
    (hone : ∀ i : ℕ, i < n → (qExpansion 1 (f i)).coeff (i + 1) = 1)
    (hA : ∀ (i j : ℕ), i < j → j < n → (qExpansion 1 (f i)).coeff (j + 1) = A i j)
    (hfi : ∀ i : ℕ, i < n → ∀ m : ℕ, ∃ z : ℤ, (qExpansion 1 (f i)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) (ps : List ℕ) (hps : ∀ p ∈ ps, p.Prime)
    (m₀ : ℕ) (hm₀ : 1 ≤ m₀) (s : ℕ) (M : ℕ → ℕ) (c : ℕ → ℤ) (e : ℕ)
    (hM : ∀ t < s, 1 ≤ M t ∧ ps.prod ^ e % M t = 0)
    (hrow : ∀ i : ℕ, i < n → (qExpansion 1 (f i)).coeff m₀
      = ∑ t ∈ Finset.range s, ((c t : ℤ) : ℂ) * (qExpansion 1 (f i)).coeff (M t)) :
    heckeTM k m₀ ∈ Subring.closure (gensOf k ps) := by
  have hspan : ∀ m : ℕ, 1 ≤ m →
      heckeTM k m ∈ Submodule.span ℂ (Set.range fun j : Fin n => heckeTM k (j.val + 1)) :=
    fun m hm => Submodule.span_le_restrictScalars ℤ ℂ _
      (heckeTM_mem_lattice (miller f A n) hn (miller_linearIndependent f A hzero hone hA)
        hdim (fun j m hj hm => miller_coeff' f A hzero hone hA j m hj hm)
        (fun j m hj => miller_int f A hA hfi j m hj) m hm)
  have heq : heckeTM k m₀ = ∑ t ∈ Finset.range s, ((c t : ℤ) : ℂ) • heckeTM k (M t) := by
    refine op_eq_of_first_coeff f hzero hone _ _ (hspan m₀ hm₀)
      (Submodule.sum_mem _ fun t ht =>
        Submodule.smul_mem _ _ (hspan _ (hM t (Finset.mem_range.mp ht)).1)) fun i hi => ?_
    rw [heckeTM_one _ hm₀, hrow i hi, LinearMap.sum_apply]
    simp only [LinearMap.smul_apply]
    rw [coeff_sum]
    exact Finset.sum_congr rfl fun t ht => by
      rw [heckeTM_one _ (hM t (Finset.mem_range.mp ht)).1]
  rw [heq]
  refine sum_mem fun t ht => ?_
  rw [Int.cast_smul_eq_zsmul ℂ]
  have h := hM t (Finset.mem_range.mp ht)
  exact zsmul_mem (heckeTM_mem_closure_of_dvd hk ps hps _ h.1 e h.2) _

end Row

end HeckeRingGens
