import MathProof.ModularForms.HeckeIndex
import MathProof.ModularForms.HeckeFieldRat

/-!
# The Hecke ring of `S_k` is generated by `T₂, T₃, T₅, T₇`

Iteration 24, b3 — the generic generator theorem and its certificate-free
instances.  For every level-one weight with `2 ≤ n = dim S_k ≤ 10` the Hecke
ring `𝕋 = span_ℤ {T_1, …, T_n}` (`HeckeIndex.heckeRing`) equals the subring
generated by the four prime operators:

    `heckeRing_eq_closure_gens4`:  𝕋 = Subring.closure {T₂, T₃, T₅, T₇}.

Both inclusions are certificate-free at every weight: `⊇` is
`Subring.closure_le` with each generator in `𝕋`
(`HeckeIndex.heckeTM_mem_lattice`), and `⊆` is the multiplicativity of the
`T_m` calculus (`HeckeTM.heckeTM_mul` / `heckeTM_prime_pow_succ`): with
`n ≤ 10`, every `T_j` with `j ≤ 10` reduces over `{T₂, T₃, T₅, T₇}` —
`T₁ = 1`, `T₄ = T₂² − 2^(k-1)`, `T₆ = T₂T₃`, `T₈ = T₂T₄ − 2^(k-1)T₂`,
`T₉ = T₃² − 3^(k-1)`, `T₁₀ = T₂T₅` (FINDINGS F3).

The same transport with the generator set `{T₂, T₃, T₅}`
(`heckeRing_eq_closure_gens235_of_t7`) reduces to a single per-weight input,
the `T₇` membership: every `T_m` whose prime factors lie in `{2, 3, 5}` is in
`ℤ[T₂, T₃, T₅]` by the defining recursion
(`heckeTM_mem_closure_gens235_of_smooth`, strong induction on `m`), and the
generated files provide `T₇ = ∑ cⱼ • T_{Mⱼ}` representations with smooth
`Mⱼ` through `heckeTM_seven_mem_of_rep`.

The per-weight representations are proved by the first-coefficient row
injectivity `op_eq_of_first_coeff`: an operator in the `T`-span is determined
by the row `i ↦ a₁(X fᵢ)` over an echelon basis (evaluate the largest
coefficient index — the echelon shape kills every smaller index).

Everything here is light and analytic: no `set_option`, no kernel decides.

## Non-objectives

Lattice indices (`[𝕋 : ℤ[T₂]]`, `[𝕋 : ℤ[T₂, T₃]]` — the `HeckeLatticeIndex`
track); weights with `dim S_k ≥ 11` (where `T₁₁` would enter); minimality of
the generator set beyond what the closure statements themselves say.
-/

namespace HeckeRingGens

open HeckeIndex HeckeTM HeckeFieldRat MaedaLevelOne
open UpperHalfPlane ModularForm CuspForm

variable {k : ℤ}

/-! ### The generator sets -/

/-- The four prime generators `{T₂, T₃, T₅, T₇}` inside `End(S_k)`. -/
noncomputable def gens4 (k : ℤ) : Set (Module.End ℂ (CuspForm 𝒮ℒ k)) :=
  {heckeTM k 2, heckeTM k 3, heckeTM k 5, heckeTM k 7}

/-- The three generators `{T₂, T₃, T₅}` inside `End(S_k)`. -/
noncomputable def gens235 (k : ℤ) : Set (Module.End ℂ (CuspForm 𝒮ℒ k)) :=
  {heckeTM k 2, heckeTM k 3, heckeTM k 5}

/-- Multiplication in `End(S_k)` is composition (definitional). -/
private lemma comp_eq_mul (X Y : CuspForm 𝒮ℒ k →ₗ[ℂ] CuspForm 𝒮ℒ k) :
    (X * Y : Module.End ℂ (CuspForm 𝒮ℒ k)) = X ∘ₗ Y := rfl

/-- `T₁ = 1` in `End(S_k)`. -/
private lemma heckeTM_one_eq (k : ℤ) :
    heckeTM k 1 = 1 := by
  rw [heckeTM_id]
  ext x
  rfl

/-! ### The composite reductions (FINDINGS F3) -/

section Reductions

/-- `T₄ = T₂² − 2^(k-1) • T₁` — the prime-power recursion at `2²`. -/
theorem heckeTM_four_eq (k : ℤ) :
    heckeTM k 4 = heckeTM k 2 * heckeTM k 2 - ((2 : ℂ) ^ (k - 1)) • 1 := by
  have h := heckeTM_prime_pow_succ k Nat.prime_two 0
  norm_num at h
  rw [h, ← heckeTM_prime k Nat.prime_two, heckeTM_one_eq, ← comp_eq_mul]

/-- `T₆ = T₂T₃` — the multiplicativity formula at a coprime pair. -/
theorem heckeTM_six_eq (k : ℤ) :
    heckeTM k 2 * heckeTM k 3 = heckeTM k 6 := by
  have h := heckeTM_mul (k := k) 2 3
  rw [Nat.gcd_comm 3 2] at h
  have hg : (Nat.gcd 3 2).divisors = {1} := by simp
  rw [hg, Finset.sum_singleton, one_zpow, one_smul, one_mul, one_mul,
    Nat.div_one, ← comp_eq_mul] at h
  exact h.symm

/-- `T₈ = T₂T₄ − 2^(k-1)T₂` — the prime-power recursion at `2³`. -/
theorem heckeTM_eight_eq (k : ℤ) :
    heckeTM k 8 = heckeTM k 2 * heckeTM k 4 - ((2 : ℂ) ^ (k - 1)) • heckeTM k 2 := by
  have h := heckeTM_prime_pow_succ k Nat.prime_two 1
  norm_num at h
  rw [h, ← heckeTM_prime k Nat.prime_two, ← comp_eq_mul]

/-- `T₉ = T₃² − 3^(k-1) • T₁` — the prime-power recursion at `3²`. -/
theorem heckeTM_nine_eq (k : ℤ) :
    heckeTM k 9 = heckeTM k 3 * heckeTM k 3 - ((3 : ℂ) ^ (k - 1)) • heckeTM k 1 := by
  have h := heckeTM_prime_pow_succ k Nat.prime_three 0
  norm_num at h
  rw [h, ← heckeTM_prime k Nat.prime_three, ← comp_eq_mul]

/-- `T₁₀ = T₂T₅` — the multiplicativity formula at a coprime pair. -/
theorem heckeTM_ten_eq (k : ℤ) :
    heckeTM k 2 * heckeTM k 5 = heckeTM k 10 := by
  have h := heckeTM_mul (k := k) 2 5
  rw [Nat.gcd_comm 5 2] at h
  have hg : (Nat.gcd 5 2).divisors = {1} := by simp
  rw [hg, Finset.sum_singleton, one_zpow, one_smul, one_mul, one_mul,
    Nat.div_one, ← comp_eq_mul] at h
  exact h.symm

end Reductions

/-! ### Smooth membership in `ℤ[T₂, T₃, T₅]` -/

section Smooth

/-- For `k ≥ 1` the correction scalar `p^(k-1)` is an integer multiple:
`(p ^ (k-1).toNat : ℤ)` acts as the `ℤ`-scalar. -/
private lemma smul_pow_int {k : ℤ} (hk : 1 ≤ k) (p : ℕ)
    (X : Module.End ℂ (CuspForm 𝒮ℒ k)) :
    ∃ z : ℤ, ((p : ℂ) ^ (k - 1)) • X = z • X := by
  refine ⟨(p ^ (k - 1).toNat : ℤ), ?_⟩
  have he : k - 1 = ((k - 1).toNat : ℤ) := by
    rw [Int.toNat_of_nonneg (by omega)]
  rw [he, zpow_natCast, ← Nat.cast_pow, Int.cast_natCast, Int.cast_smul_eq_zsmul]

/-- **Every smooth `T_m` lies in `ℤ[T₂, T₃, T₅]`**: if the prime factors of
`m ≥ 1` lie in `{2, 3, 5}` and `k ≥ 1`, then `T_m ∈ Subring.closure {T₂,T₃,T₅}`
— strong induction through the defining recursion of `T_m`. -/
theorem heckeTM_mem_closure_gens235_of_smooth {k : ℤ} (hk : 1 ≤ k) (m : ℕ)
    (hm : 1 ≤ m)
    (hsm : ∀ p : ℕ, p.Prime → p ∣ m → p = 2 ∨ p = 3 ∨ p = 5) :
    heckeTM k m ∈ Subring.closure (gens235 k) := by
  induction m using Nat.strongRecOn with
  | ind m ih =>
    rcases Nat.lt_or_ge m 2 with hm2 | hm2
    · have hm1 : m = 1 := by omega
      subst hm1
      rw [heckeTM_one_eq]
      exact Subring.one_mem _
    · have hmp : m.minFac.Prime := Nat.minFac_prime (show m ≠ 1 by omega)
      have hdvd : m.minFac ∣ m := Nat.minFac_dvd m
      have hq1 : 1 ≤ m / m.minFac := Nat.div_pos (Nat.le_of_dvd hm hdvd) hmp.pos
      have hqlt : m / m.minFac < m := Nat.div_lt_self (by omega) hmp.one_lt
      have hsm1 : ∀ p : ℕ, p.Prime → p ∣ m / m.minFac → p = 2 ∨ p = 3 ∨ p = 5 :=
        fun p hpr hpm => hsm p hpr (hdvd.trans hpm)
      have hmem1 := ih _ hqlt hq1 hsm1
      -- the leading prime operator is one of the generators
      have hgen : heckeTPₗ k hmp ∈ Subring.closure (gens235 k) := by
        rcases hsm m.minFac hmp hdvd with rfl | rfl | rfl
        · rw [← heckeTM_prime k Nat.prime_two]
          exact Subring.subset_closure (by simp [gens235])
        · rw [← heckeTM_prime k Nat.prime_three]
          exact Subring.subset_closure (by simp [gens235])
        · rw [← heckeTM_prime (k := k) (p := 5) Nat.prime_five]
          exact Subring.subset_closure (by simp [gens235])
      -- the correction scalar is an integer smul
      have hcorr : ∀ r : ℕ, heckeTM k r ∈ Subring.closure (gens235 k) →
          ((m.minFac : ℂ) ^ (k - 1)) • heckeTM k r ∈ Subring.closure (gens235 k) := by
        intro r hr
        obtain ⟨z, hz⟩ := smul_pow_int hk m.minFac (heckeTM k r)
        rw [hz]
        exact Subring.zsmul_mem _ hr z
      rw [heckeTM_ge_two k hm2, ← comp_eq_mul]
      by_cases hc : m.minFac ∣ m / m.minFac
      · have hc1 : 1 ≤ m / m.minFac / m.minFac := by
          obtain ⟨t, ht⟩ := hc
          have hz : m / m.minFac = m.minFac * t := ht
          rcases Nat.eq_zero_or_pos t with h0 | hpos
          · rw [h0, Nat.mul_zero] at hz
            exact absurd hq1 (by rw [hz]; omega)
          · rw [hz, Nat.mul_div_cancel_left _ hmp.pos]
            exact hpos
        have hclt : m / m.minFac / m.minFac < m :=
          Nat.lt_of_le_of_lt (Nat.div_le_self _ _) hqlt
        have hd2 : m / m.minFac / m.minFac ∣ m / m.minFac :=
          Nat.div_dvd_of_dvd hc
        have hsm2 : ∀ p : ℕ, p.Prime → p ∣ m / m.minFac / m.minFac →
            p = 2 ∨ p = 3 ∨ p = 5 :=
          fun p hpr hpm => hsm1 p hpr (hd2.trans hpm)
        rw [hc, if_pos hc]
        exact Subring.sub_mem _ (Subring.mul_mem _ hgen hmem1)
          (hcorr _ (ih _ hclt hc1 hsm2))
      · rw [if_neg hc, sub_zero]
        exact Subring.mul_mem _ hgen hmem1

/-- Every `T_m` with `m ≤ 10` except `T₇` lies in `ℤ[T₂, T₃, T₅]` (the
smoothness is numerically checkable at `m ≤ 10`). -/
theorem heckeTM_mem_closure_gens235 {k : ℤ} (hk : 1 ≤ k) {m : ℕ} (hm : 1 ≤ m)
    (hm10 : m ≤ 10) (hm7 : m ≠ 7) :
    heckeTM k m ∈ Subring.closure (gens235 k) := by
  refine heckeTM_mem_closure_gens235_of_smooth hk m hm ?_
  intro p hpr hpm
  have hp10 : p ≤ 10 := Nat.le_trans (Nat.le_of_dvd hm hpm) hm10
  interval_cases p
  · exact Or.inl rfl
  · exact absurd hpr (by norm_num)
  · exact Or.inr (Or.inl rfl)
  · exact absurd hpr (by norm_num)
  · exact Or.inr (Or.inr rfl)
  · exact absurd hpr (by norm_num)
  · -- p = 7: forces m = 7
    obtain ⟨t, ht⟩ := hpm
    rw [ht] at hm hm10
    rcases Nat.eq_zero_or_pos t with h0 | h0
    · omega
    · have ht1 : t = 1 := by omega
      rw [ht1] at hm7
      exact absurd rfl hm7
  · exact absurd hpr (by norm_num)
  · exact absurd hpr (by norm_num)
  · exact absurd hpr (by norm_num)

/-- **A representation puts `T₇` in `ℤ[T₂, T₃, T₅]`**: if `T₇ = ∑ cₜ • T_{Mₜ}`
with every `Mₜ ≥ 1` smooth over `{2, 3, 5}`, then
`T₇ ∈ Subring.closure {T₂, T₃, T₅}`. -/
theorem heckeTM_seven_mem_of_rep {k : ℤ} (hk : 1 ≤ k) (s : ℕ) (M : ℕ → ℕ)
    (c : ℕ → ℤ)
    (hM1 : ∀ t < s, 1 ≤ M t)
    (hsm : ∀ t < s, ∀ p : ℕ, p.Prime → p ∣ M t → p = 2 ∨ p = 3 ∨ p = 5)
    (hrep : (heckeTM k 7 : Module.End ℂ (CuspForm 𝒮ℒ k))
      = ∑ t ∈ Finset.range s, ((c t : ℤ) : ℂ) • heckeTM k (M t)) :
    heckeTM k 7 ∈ Subring.closure (gens235 k) := by
  rw [hrep]
  refine Subring.sum_mem _ fun t ht => ?_
  obtain ⟨z, hz⟩ : ∃ z : ℤ, ((c t : ℤ) : ℂ) • heckeTM k (M t)
      = z • heckeTM k (M t) := ⟨c t, by rw [Int.cast_smul_eq_zsmul]⟩
  rw [hz]
  exact Subring.zsmul_mem _
    (heckeTM_mem_closure_gens235_of_smooth hk (M t) (hM1 t (Finset.mem_range.mp ht))
      (hsm t (Finset.mem_range.mp ht))) (c t)

end Smooth

/-! ### The Hecke-ring transport -/

section Transport

variable {k : ℤ} {n : ℕ}

/-- **Transport**: if every `T_{j+1}` (`j < n`) lies in a subring `R`, then
`𝕋 ≤ R` (the Hecke lattice is the ℤ-span of the `T`-family). -/
theorem heckeRing_le_of_mem (g : ℕ → CuspForm 𝒮ℒ k) (hn : 0 < n)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) (R : Subring (Module.End ℂ (CuspForm 𝒮ℒ k)))
    (hmem : ∀ j : Fin n, heckeTM k (j.val + 1) ∈ R) :
    heckeRing g hn hg hdim hδ hint hk ≤ R := by
  intro x hx
  have hx' : x ∈ heckeLattice k n := hx
  have hsub : (heckeLattice k n).toAddSubgroup ≤ R.toAddSubgroup := by
    rw [heckeLattice, Submodule.span_int_eq_addSubgroupClosure]
    refine AddSubgroup.closure_le.2 ?_
    rintro y ⟨j, rfl⟩
    exact Subring.mem_toAddSubgroup.mpr (hmem j)
  exact Subring.mem_toAddSubgroup.mp (hsub (Submodule.mem_toAddSubgroup.mpr hx'))

/-- **`𝕋 = ℤ[T₂, T₃, T₅, T₇]` at every weight with `dim S_k ≤ 10`**: both
inclusions are certificate-free (FINDINGS F3). -/
theorem heckeRing_eq_closure_gens4 (g : ℕ → CuspForm 𝒮ℒ k) (hn : 0 < n)
    (hn10 : n ≤ 10)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) :
    heckeRing g hn hg hdim hδ hint hk = Subring.closure (gens4 k) := by
  refine le_antisymm ?_ ?_
  · refine heckeRing_le_of_mem g hn hg hdim hδ hint hk _ (fun j => ?_)
    have hj : j.val + 1 ≤ 10 := Nat.le_trans (Nat.succ_le_of_lt j.isLt) hn10
    rcases Nat.eq_or_lt_of_le hj with h7 | h7
    · rw [h7]
      exact Subring.subset_closure (by simp [gens4])
    · refine Subring.closure_mono (hset : gens235 k ⊆ gens4 k) ?_
      · intro x hx
        simp only [gens235, Set.mem_insert_iff, Set.mem_singleton_iff] at hx
        rcases hx with rfl | rfl | rfl <;> simp [gens4]
      · exact heckeTM_mem_closure_gens235 hk (by omega) hj (by omega)
  · refine Subring.closure_le.2 ?_
    rintro x (rfl | rfl | rfl | rfl)
    · exact heckeTM_mem_lattice g hn hg hdim hδ hint 2 (by norm_num)
    · exact heckeTM_mem_lattice g hn hg hdim hδ hint 3 (by norm_num)
    · exact heckeTM_mem_lattice g hn hg hdim hδ hint 5 (by norm_num)
    · exact heckeTM_mem_lattice g hn hg hdim hδ hint 7 (by norm_num)

/-- **`𝕋 = ℤ[T₂, T₃, T₅]` from a `T₇` membership**: at every weight with
`dim S_k ≤ 10`, a single per-weight input — `T₇ ∈ ℤ[T₂, T₃, T₅]` — upgrades
the smooth reductions to the full equality. -/
theorem heckeRing_eq_closure_gens235_of_t7 (g : ℕ → CuspForm 𝒮ℒ k) (hn : 0 < n)
    (hn10 : n ≤ 10)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) (hT7 : heckeTM k 7 ∈ Subring.closure (gens235 k)) :
    heckeRing g hn hg hdim hδ hint hk = Subring.closure (gens235 k) := by
  refine le_antisymm ?_ ?_
  · refine heckeRing_le_of_mem g hn hg hdim hδ hint hk _ (fun j => ?_)
    have hj : j.val + 1 ≤ 10 := Nat.le_trans (Nat.succ_le_of_lt j.isLt) hn10
    rcases Nat.eq_or_lt_of_le hj with h7 | h7
    · rw [h7]
      exact hT7
    · exact heckeTM_mem_closure_gens235 hk (by omega) hj (by omega)
  · refine Subring.closure_le.2 ?_
    rintro x (rfl | rfl | rfl)
    · exact heckeTM_mem_lattice g hn hg hdim hδ hint 2 (by norm_num)
    · exact heckeTM_mem_lattice g hn hg hdim hδ hint 3 (by norm_num)
    · exact heckeTM_mem_lattice g hn hg hdim hδ hint 5 (by norm_num)

/-- **Echelon form of the four-generator theorem** (the shape the per-weight
files instantiate: no Miller data, only the echelon bundle). -/
theorem heckeRing_eq_closure_gens4_of_echelon {k : ℤ} {n : ℕ} (hn : 0 < n)
    (hn10 : n ≤ 10) (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (f : ℕ → CuspForm 𝒮ℒ k) (A : ℕ → ℕ → ℂ)
    (hzero : ∀ (i m : ℕ), i < n → 1 ≤ m → m ≤ i → (qExpansion 1 (f i)).coeff m = 0)
    (hone : ∀ i : ℕ, i < n → (qExpansion 1 (f i)).coeff (i + 1) = 1)
    (hA : ∀ (i j : ℕ), i < j → j < n → (qExpansion 1 (f i)).coeff (j + 1) = A i j)
    (hfi : ∀ i : ℕ, i < n → ∀ m : ℕ, ∃ z : ℤ, (qExpansion 1 (f i)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) :
    heckeRing (miller f A n) hn (miller_linearIndependent f A hzero hone hA) hdim
      (fun j m hj hm => miller_coeff' f A hzero hone hA j m hj hm)
      (fun j m hj => miller_int f A hA hfi j m hj) hk
      = Subring.closure (gens4 k) :=
  heckeRing_eq_closure_gens4 _ hn hn10 (miller_linearIndependent f A hzero hone hA) hdim
    (fun j m hj hm => miller_coeff' f A hzero hone hA j m hj hm)
    (fun j m hj => miller_int f A hA hfi j m hj) hk

/-- **Echelon form of the three-generator theorem** (the per-weight
certificate consumer). -/
theorem heckeRing_eq_closure_gens235_of_echelon {k : ℤ} {n : ℕ} (hn : 0 < n)
    (hn10 : n ≤ 10) (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (f : ℕ → CuspForm 𝒮ℒ k) (A : ℕ → ℕ → ℂ)
    (hzero : ∀ (i m : ℕ), i < n → 1 ≤ m → m ≤ i → (qExpansion 1 (f i)).coeff m = 0)
    (hone : ∀ i : ℕ, i < n → (qExpansion 1 (f i)).coeff (i + 1) = 1)
    (hA : ∀ (i j : ℕ), i < j → j < n → (qExpansion 1 (f i)).coeff (j + 1) = A i j)
    (hfi : ∀ i : ℕ, i < n → ∀ m : ℕ, ∃ z : ℤ, (qExpansion 1 (f i)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) (hT7 : heckeTM k 7 ∈ Subring.closure (gens235 k)) :
    heckeRing (miller f A n) hn (miller_linearIndependent f A hzero hone hA) hdim
      (fun j m hj hm => miller_coeff' f A hzero hone hA j m hj hm)
      (fun j m hj => miller_int f A hA hfi j m hj) hk
      = Subring.closure (gens235 k) :=
  heckeRing_eq_closure_gens235_of_t7 _ hn hn10
    (miller_linearIndependent f A hzero hone hA) hdim
    (fun j m hj hm => miller_coeff' f A hzero hone hA j m hj hm)
    (fun j m hj => miller_int f A hA hfi j m hj) hk hT7

end Transport

/-! ### First-coefficient rows detect operators in the `T`-span -/

section Row

variable {k : ℤ} {n : ℕ}

/-- Coefficients of a difference. -/
private lemma coeff_sub' (f g : CuspForm 𝒮ℒ k) (m : ℕ) :
    (qExpansion 1 ⇑(f - g)).coeff m
      = (qExpansion 1 ⇑f).coeff m - (qExpansion 1 ⇑g).coeff m := by
  have h1 : (qL k (f - g)).coeff m = (qL k f - qL k g).coeff m := by rw [map_sub]
  have h2 : (qL k f - qL k g).coeff m = (qL k f).coeff m - (qL k g).coeff m := by
    rw [map_sub]
  rw [← qL_apply (f - g), ← qL_apply f, ← qL_apply g, h1, h2]

/-- **Row injectivity**: two operators in the ℂ-span of the `T`-family are
equal as soon as the first q-coefficients of `X fᵢ` and `Y fᵢ` agree over an
echelon basis `f` (evaluate at the largest differing coefficient index — the
echelon shape kills every smaller index). -/
theorem op_eq_of_first_coeff (hn : 0 < n)
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (f : ℕ → CuspForm 𝒮ℒ k) (A : ℕ → ℕ → ℂ)
    (hzero : ∀ (i m : ℕ), i < n → 1 ≤ m → m ≤ i → (qExpansion 1 (f i)).coeff m = 0)
    (hone : ∀ i : ℕ, i < n → (qExpansion 1 (f i)).coeff (i + 1) = 1)
    (hA : ∀ (i j : ℕ), i < j → j < n → (qExpansion 1 (f i)).coeff (j + 1) = A i j)
    (X Y : CuspForm 𝒮ℒ k →ₗ[ℂ] CuspForm 𝒮ℒ k)
    (hX : X ∈ Submodule.span ℂ (Set.range fun j : Fin n => heckeTM k (j.val + 1)))
    (hY : Y ∈ Submodule.span ℂ (Set.range fun j : Fin n => heckeTM k (j.val + 1)))
    (hrow : ∀ i : ℕ, i < n →
      (qExpansion 1 (X (f i))).coeff 1 = (qExpansion 1 (Y (f i))).coeff 1) :
    X = Y := by
  classical
  by_contra hne
  obtain ⟨cX, hcX⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp hX
  obtain ⟨cY, hcY⟩ := (Submodule.mem_span_range_iff_exists_fun ℂ).mp hY
  set γ : Fin n → ℂ := fun j => cX j - cY j with hγdef
  have hZsum : ((X - Y : CuspForm 𝒮ℒ k →ₗ[ℂ] CuspForm 𝒮ℒ k))
      = ∑ j : Fin n, γ j • heckeTM k (j.val + 1) := by
    rw [map_sub, hcX, hcY, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun j _ => by rw [smul_sub]
  have hzero' : ∀ i : ℕ, i < n →
      (qExpansion 1 ((X - Y) (f i))).coeff 1 = 0 := by
    intro i hi
    rw [LinearMap.sub_apply, coeff_sub', hrow i hi, sub_self]
  -- the support of γ is nonempty (else X = Y)
  set S : Finset (Fin n) := Finset.univ.filter (fun j => γ j ≠ 0) with hSdef
  have hSne : S.Nonempty := by
    by_contra hSe
    have hall : ∀ j : Fin n, γ j = 0 := by
      intro j
      by_contra hj
      exact hSe (hSdef ▸ Finset.mem_filter.mpr ⟨Finset.mem_univ j, hj⟩)
    refine hne ?_
    have hz0 : (X - Y : CuspForm 𝒮ℒ k →ₗ[ℂ] CuspForm 𝒮ℒ k) = 0 := by
      rw [hZsum]
      rw [← Finset.sum_eq_zero (f := fun j => γ j • heckeTM k (j.val + 1))
        (fun j _ => by rw [hall j, zero_smul])]
      exact Finset.sum_congr rfl fun j _ => rfl
    exact sub_eq_zero.mp (LinearMap.ext_iff.mp hz0)
  set jmax : Fin n := S.max' hSne with hjmaxdef
  have hjmem : γ jmax ≠ 0 :=
    (Finset.mem_filter.mp (S.max'_mem hSne)).2
  have hjle : ∀ j : Fin n, γ j ≠ 0 → j.val ≤ jmax.val := by
    intro j hj
    exact Finset.le_max' S j (Finset.mem_filter.mpr ⟨Finset.mem_univ j, hj⟩)
  -- expand the difference at `f jmax` and read off the single live term
  have hap : (X - Y) (f jmax.val)
      = ∑ j : Fin n, γ j • heckeTM k (j.val + 1) (f jmax.val) := by
    conv_lhs => rw [hZsum]
    rw [LinearMap.sum_apply]
  have h1 := hzero' jmax.val jmax.isLt
  rw [hap, coeff_sum Finset.univ γ
    (fun j => heckeTM k (j.val + 1) (f jmax.val)) 1,
    Finset.sum_eq_single jmax] at h1
  · refine hjmem ?_
    rw [heckeTM_one, hone jmax.val jmax.isLt, mul_one] at h1
    exact h1
  · intro b _ hb
    by_cases hb0 : γ b = 0
    · rw [hb0, zero_mul]
    · have hblt : b.val < jmax.val := by
        rcases Nat.lt_or_ge b.val jmax.val with h | h
        · exact h
        · exact absurd (Fin.val_inj.mp (Nat.le_antisymm (hjle b hb0) h)) hb
      rw [heckeTM_one,
        hzero jmax.val (b.val + 1) jmax.isLt (by omega) (by omega), mul_zero]
  · intro hcon
    exact absurd (Finset.mem_univ jmax) hcon

end Row

end HeckeRingGens
