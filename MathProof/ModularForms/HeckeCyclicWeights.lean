  | 2, _, m => ⟨_, MaedaT3Weight62.c3 m⟩
  | 3, _, m => ⟨_, MaedaT3Weight62.c4 m⟩
  | _ + 4, h, _ => absurd h (by omega)

/-- The witness identity `∑ cert_j T₂^j = D • T₃` at the operator level. -/
theorem op_id : ∑ j ∈ Finset.range 4, ((HeckeRatWeight62.cert j : ℤ) : ℂ)
      • HeckeRatWeight62.T2 ^ j
    = ((HeckeIndexWeight62.Dn : ℤ) : ℂ) • MaedaT3Weight62.T3 :=
  int_poly_of_dimN (by norm_num) MaedaT3Weight62.finrank_eq MaedaT3Weight62.fb
    MaedaT3Weight62.Atab HeckeRatWeight62.Xtab2 MaedaT3Weight62.Xtab
    MaedaT3Weight62.hzero MaedaT3Weight62.hone MaedaT3Weight62.hA
    HeckeRatWeight62.T2 MaedaT3Weight62.T3 HeckeRatWeight62.hX2 MaedaT3Weight62.hX
    HeckeRatWeight62.M2 MaedaT3Weight62.M HeckeRatWeight62.hM2 HeckeRatWeight62.hM3
    HeckeRatWeight62.cert HeckeIndexWeight62.Dn HeckeIndexWeight62.scaled_idN

/-- `D • T₃ ∈ ℤ[T₂]` — the witness kills the class of `T₃`. -/
theorem Dn_smul_mem : ((HeckeIndexWeight62.Dn : ℤ) : ℂ) • MaedaT3Weight62.T3
    ∈ HeckeCyclic.t2Span HeckeRatWeight62.T2 4 := by
  rw [← op_id]
  refine Submodule.sum_mem _ fun j hj => ?_
  rw [Int.cast_smul_eq_zsmul ℂ]
  exact Submodule.smul_mem _ _
    (HeckeCyclic.pow_mem_t2Span _ _ (Finset.mem_range.mp hj))

/-- **`D = I_k` at weight 62**: the quotient `𝕋 ⧸ ℤ[T₂]` is generated by
`[T₃]` and killed by `D`, so `I_k ∣ D`; the landed `D ∣ I_k` and positivity
close the equality.  `hcard` is the index cardinality (b1's
`HeckeLatticeIndex` per-weight fact). -/
theorem D_eq_Ik
    (hcard : Nat.card ((heckeLattice ((62 : ℕ) : ℤ) 4).toAddSubgroup ⧸
      (HeckeCyclic.t2Span HeckeRatWeight62.T2 4).toAddSubgroup.addSubgroupOf
        (heckeLattice ((62 : ℕ) : ℤ) 4).toAddSubgroup)
      = (HeckeIndexWeight62.Ik).natAbs) :
    HeckeIndexWeight62.Dn = HeckeIndexWeight62.Ik :=
  HeckeCyclic.D_eq_Ik_of_cyclic (by norm_num) (by norm_num) (by norm_num)
    (miller MaedaT3Weight62.fb MaedaT3Weight62.Atab 4)
    (miller_linearIndependent MaedaT3Weight62.fb MaedaT3Weight62.Atab
      MaedaT3Weight62.hzero MaedaT3Weight62.hone MaedaT3Weight62.hA)
    MaedaT3Weight62.finrank_eq
    (fun j m hj hm => miller_coeff' MaedaT3Weight62.fb MaedaT3Weight62.Atab
      MaedaT3Weight62.hzero MaedaT3Weight62.hone MaedaT3Weight62.hA j m hj hm)
    (fun j m hj => miller_int MaedaT3Weight62.fb MaedaT3Weight62.Atab
      MaedaT3Weight62.hA hfi j m hj)
    HeckeRatWeight62.T2 MaedaT3Weight62.T3
    (heckeTM_prime _ Nat.prime_two).symm (heckeTM_prime _ Nat.prime_three).symm
    HeckeIndexWeight62.Dn HeckeIndexWeight62.Ik
    (by norm_num [HeckeIndexWeight62.Dn]) (by norm_num [HeckeIndexWeight62.Ik])
    Dn_smul_mem HeckeIndexWeight62.D_dvd_Ik hcard

/-- `ℤ[T₂] ⊆ 𝕋` at weight 62 (the Miller bundle form). -/
theorem t2Span_le : HeckeCyclic.t2Span HeckeRatWeight62.T2 4
    ≤ heckeLattice ((62 : ℕ) : ℤ) 4 :=
  HeckeCyclic.t2Span_le_heckeLattice (miller MaedaT3Weight62.fb MaedaT3Weight62.Atab 4)
    (by norm_num)
    (miller_linearIndependent MaedaT3Weight62.fb MaedaT3Weight62.Atab
      MaedaT3Weight62.hzero MaedaT3Weight62.hone MaedaT3Weight62.hA)
    MaedaT3Weight62.finrank_eq
    (fun j m hj hm => miller_coeff' MaedaT3Weight62.fb MaedaT3Weight62.Atab
      MaedaT3Weight62.hzero MaedaT3Weight62.hone MaedaT3Weight62.hA j m hj hm)
    (fun j m hj => miller_int MaedaT3Weight62.fb MaedaT3Weight62.Atab
      MaedaT3Weight62.hA hfi j m hj)
    (by norm_num) _ (heckeTM_prime _ Nat.prime_two).symm

/-- **`𝕋 ≠ ℤ[T₂]` at weight 62**: the index `I_k ≠ 1` here, so the
quotient is nontrivial (via the iff; `hcard` as in `D_eq_Ik`). -/
theorem heckeLattice_ne_t2Span
    (hcard : Nat.card ((heckeLattice ((62 : ℕ) : ℤ) 4).toAddSubgroup ⧸
      (HeckeCyclic.t2Span HeckeRatWeight62.T2 4).toAddSubgroup.addSubgroupOf
        (heckeLattice ((62 : ℕ) : ℤ) 4).toAddSubgroup)
      = (HeckeIndexWeight62.Ik).natAbs) :
    heckeLattice ((62 : ℕ) : ℤ) 4 ≠ HeckeCyclic.t2Span HeckeRatWeight62.T2 4 := by
  intro h
  have h1 := (HeckeCyclic.heckeLattice_eq_t2Span_iff _
    (HeckeIndexWeight62.Ik).natAbs t2Span_le hcard).mp h
  norm_num [HeckeIndexWeight62.Ik] at h1

end HeckeCyclicWeight62

