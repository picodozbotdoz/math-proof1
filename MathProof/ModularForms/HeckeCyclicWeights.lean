/-! ### Weight 36 (dim 3) -/
namespace HeckeCyclicWeight36

/-- The echelon basis at weight 36 has integer `q`-coefficients (all `m`). -/
theorem hfi : ∀ i : ℕ, i < 3 → ∀ m : ℕ,
    ∃ z : ℤ, (qExpansion 1 (MaedaT3Weight36.fb i)).coeff m = (z : ℂ)
  | 0, _, m => ⟨_, MaedaT3Weight36.c1 m⟩
  | 1, _, m => ⟨_, MaedaT3Weight36.c2 m⟩
  | 2, _, m => ⟨_, MaedaT3Weight36.c3 m⟩
  | _ + 3, h, _ => absurd h (by omega)

/-- The witness identity `∑ cert_j T₂^j = D • T₃` at the operator level. -/
theorem op_id : ∑ j ∈ Finset.range 3, ((HeckeRatWeight36.cert j : ℤ) : ℂ)
      • HeckeRatWeight36.T2 ^ j
    = ((HeckeIndexWeight36.Dn : ℤ) : ℂ) • MaedaT3Weight36.T3 :=
  int_poly_of_dimN (by norm_num) MaedaT3Weight36.finrank_eq MaedaT3Weight36.fb
    MaedaT3Weight36.Atab HeckeRatWeight36.Xtab2 MaedaT3Weight36.Xtab
    MaedaT3Weight36.hzero MaedaT3Weight36.hone MaedaT3Weight36.hA
    HeckeRatWeight36.T2 MaedaT3Weight36.T3 HeckeRatWeight36.hX2 MaedaT3Weight36.hX
    HeckeRatWeight36.M2 MaedaT3Weight36.M HeckeRatWeight36.hM2 HeckeRatWeight36.hM3
    HeckeRatWeight36.cert HeckeIndexWeight36.Dn HeckeIndexWeight36.scaled_idN

/-- `D • T₃ ∈ ℤ[T₂]` — the witness kills the class of `T₃`. -/
theorem Dn_smul_mem : ((HeckeIndexWeight36.Dn : ℤ) : ℂ) • MaedaT3Weight36.T3
    ∈ HeckeCyclic.t2Span HeckeRatWeight36.T2 3 := by
  rw [← op_id]
  refine Submodule.sum_mem _ fun j hj => ?_
  rw [Int.cast_smul_eq_zsmul ℂ]
  exact Submodule.smul_mem _ _
    (HeckeCyclic.pow_mem_t2Span _ _ (Finset.mem_range.mp hj))

/-- **`D = I_k` at weight 36**: the quotient `𝕋 ⧸ ℤ[T₂]` is generated by
`[T₃]` and killed by `D`, so `I_k ∣ D`; the landed `D ∣ I_k` and positivity
close the equality.  `hcard` is the index cardinality (b1's
`HeckeLatticeIndex` per-weight fact). -/
theorem D_eq_Ik
    (hcard : Nat.card ((heckeLattice ((36 : ℕ) : ℤ) 3).toAddSubgroup ⧸
      (HeckeCyclic.t2Span HeckeRatWeight36.T2 3).toAddSubgroup.addSubgroupOf
        (heckeLattice ((36 : ℕ) : ℤ) 3).toAddSubgroup)
      = (HeckeIndexWeight36.Ik).natAbs) :
    HeckeIndexWeight36.Dn = HeckeIndexWeight36.Ik :=
  HeckeCyclic.D_eq_Ik_of_cyclic (by norm_num) (by norm_num) (by norm_num)
    (miller MaedaT3Weight36.fb MaedaT3Weight36.Atab 3)
    (miller_linearIndependent MaedaT3Weight36.fb MaedaT3Weight36.Atab
      MaedaT3Weight36.hzero MaedaT3Weight36.hone MaedaT3Weight36.hA)
    MaedaT3Weight36.finrank_eq
    (fun j m hj hm => miller_coeff' MaedaT3Weight36.fb MaedaT3Weight36.Atab
      MaedaT3Weight36.hzero MaedaT3Weight36.hone MaedaT3Weight36.hA j m hj hm)
    (fun j m hj => miller_int MaedaT3Weight36.fb MaedaT3Weight36.Atab
      MaedaT3Weight36.hA hfi j m hj)
    HeckeRatWeight36.T2 MaedaT3Weight36.T3
    (heckeTM_prime _ Nat.prime_two).symm (heckeTM_prime _ Nat.prime_three).symm
    HeckeIndexWeight36.Dn HeckeIndexWeight36.Ik
    (by norm_num [HeckeIndexWeight36.Dn]) (by norm_num [HeckeIndexWeight36.Ik])
    Dn_smul_mem HeckeIndexWeight36.D_dvd_Ik hcard

/-- `ℤ[T₂] ⊆ 𝕋` at weight 36 (the Miller bundle form). -/
theorem t2Span_le : HeckeCyclic.t2Span HeckeRatWeight36.T2 3
    ≤ heckeLattice ((36 : ℕ) : ℤ) 3 :=
  HeckeCyclic.t2Span_le_heckeLattice (miller MaedaT3Weight36.fb MaedaT3Weight36.Atab 3)
    (by norm_num)
    (miller_linearIndependent MaedaT3Weight36.fb MaedaT3Weight36.Atab
      MaedaT3Weight36.hzero MaedaT3Weight36.hone MaedaT3Weight36.hA)
    MaedaT3Weight36.finrank_eq
    (fun j m hj hm => miller_coeff' MaedaT3Weight36.fb MaedaT3Weight36.Atab
      MaedaT3Weight36.hzero MaedaT3Weight36.hone MaedaT3Weight36.hA j m hj hm)
    (fun j m hj => miller_int MaedaT3Weight36.fb MaedaT3Weight36.Atab
      MaedaT3Weight36.hA hfi j m hj)
    (by norm_num) _ (heckeTM_prime _ Nat.prime_two).symm

/-- **`𝕋 ≠ ℤ[T₂]` at weight 36**: the index `I_k ≠ 1` here, so the
quotient is nontrivial (via the iff; `hcard` as in `D_eq_Ik`). -/
theorem heckeLattice_ne_t2Span
    (hcard : Nat.card ((heckeLattice ((36 : ℕ) : ℤ) 3).toAddSubgroup ⧸
      (HeckeCyclic.t2Span HeckeRatWeight36.T2 3).toAddSubgroup.addSubgroupOf
        (heckeLattice ((36 : ℕ) : ℤ) 3).toAddSubgroup)
      = (HeckeIndexWeight36.Ik).natAbs) :
    heckeLattice ((36 : ℕ) : ℤ) 3 ≠ HeckeCyclic.t2Span HeckeRatWeight36.T2 3 := by
  intro h
  have h1 := (HeckeCyclic.heckeLattice_eq_t2Span_iff _
    (HeckeIndexWeight36.Ik).natAbs t2Span_le hcard).mp h
  norm_num [HeckeIndexWeight36.Ik] at h1

end HeckeCyclicWeight36

