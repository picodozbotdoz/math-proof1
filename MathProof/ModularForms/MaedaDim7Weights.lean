/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [83, 89, 15, 103, 70, 61, 62, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 137)) = RabinCert.toPoly 137 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((-43735426713792 : ℤ) : ZMod 137) = (62 : ZMod 137) from by decide +kernel,
      show ((-52422817047248315187327578112 : ℤ) : ZMod 137)
           = (61 : ZMod 137) from by decide +kernel,
      show ((1822340570225776508355098661880437883797504 : ℤ) : ZMod 137)
           = (70 : ZMod 137) from by decide +kernel,
      show ((774285750205728873399065770796719479780298817622452994048 : ℤ) : ZMod 137)
           = (103 : ZMod 137) from by decide +kernel,
            show ((- (161287792410494755740466210353209902547971193959787757809953 * 10 ^ 11
            + 72381372416) : ℤ) : ZMod 137)
          = (15 : ZMod 137) from by decide +kernel,
            show ((- (249474723091143066692321373845719454571800757521890194899347 * 10 ^ 25
            + 2855205244009258327998464) : ℤ) : ZMod 137)
          = (89 : ZMod 137) from by decide +kernel,
            show ((- (124404274437684794108277575734850895617680386303195050687003 * 10 ^ 38
            + 71236404014284338312788954309787123712) : ℤ) : ZMod 137)
          = (83 : ZMod 137) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 137 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 137 fr).natDegree = 7 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 137 ^ 7 < 2 ^ 50 := by norm_num

lemma h1 : RabinCert.zpxw 137 fr (RabinCert.bitsOf 50 (137 ^ 7)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_7 : ∃ w : ℕ, RabinCert.zpgcd 137 w fr
      (RabinCert.zpxwsubX 137 fr 50 (137 ^ (7 / 7))) = [1] :=
  ⟨12, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 7 → ∃ w : ℕ,
      RabinCert.zpgcd 137 w fr
      (RabinCert.zpxwsubX 137 fr 50 (137 ^ (7 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 7 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact h2_7

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [114, 110, 75, 125, 47, 12, 93, 1]

lemma h1_2 : RabinCert.zpxw 179 fr2 (RabinCert.bitsOf 53 (179 ^ 7)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 137) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

