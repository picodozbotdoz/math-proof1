/-- The characteristic polynomial mod the certificate prime (little-endian). -/
noncomputable def fr : List ℤ := [78, 250, 224, 97, 70, 307, 207, 1]

lemma hmap : P.map (Int.castRingHom (ZMod 349)) = RabinCert.toPoly 349 fr := by
  simp only [P, RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr,
      Polynomial.map_C, Polynomial.map_X, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_pow, Int.coe_castRingHom, ← Polynomial.C_neg]
  rw [show ((-18197022042936 : ℤ) : ZMod 349) = (207 : ZMod 349) from by decide +kernel,
      show ((-564235186214233767519802368 : ℤ) : ZMod 349)
           = (307 : ZMod 349) from by decide +kernel,
      show ((9469986856558070054862549104080818536448 : ℤ) : ZMod 349)
           = (70 : ZMod 349) from by decide +kernel,
      show ((77399298405874102643706834935868342570273672378974208 : ℤ) : ZMod 349)
           = (97 : ZMod 349) from by decide +kernel,
      show ((-1080069535198488781867669355624948784284442394272777499650910322688 : ℤ) : ZMod 349)
           = (224 : ZMod 349) from by decide +kernel,
            show ((- (193758178127421669256815739198552751929993704398907158052844 * 10 ^ 19
            + 3054414855422345216) : ℤ) : ZMod 349)
          = (250 : ZMod 349) from by decide +kernel,
            show ((259100108483817333170764313111328587301025983049059827102067 * 10 ^ 31
            + 4673257153575927974722510258176 : ℤ) : ZMod 349)
          = (78 : ZMod 349) from by decide +kernel]
  ring_nf

lemma hmon' : (RabinCert.toPoly 349 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 349 fr).natDegree = 7 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 349 ^ 7 < 2 ^ 60 := by norm_num

lemma h1 : RabinCert.zpxw 349 fr (RabinCert.bitsOf 60 (349 ^ 7)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_7 : ∃ w : ℕ, RabinCert.zpgcd 349 w fr
      (RabinCert.zpxwsubX 349 fr 60 (349 ^ (7 / 7))) = [1] :=
  ⟨12, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 7 → ∃ w : ℕ,
      RabinCert.zpgcd 349 w fr
      (RabinCert.zpxwsubX 349 fr 60 (349 ^ (7 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 7 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact h2_7

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
noncomputable def fr2 : List ℤ := [86, 275, 251, 171, 80, 228, 369, 1]

lemma h1_2 : RabinCert.zpxw 397 fr2 (RabinCert.bitsOf 61 (397 ^ 7)) [1]
      = [0, 1] :=
  by decide +kernel

/-- **Maeda's conjecture (irreducibility) in this weight.** -/
theorem maeda : Irreducible (P.map (Int.castRingHom ℚ)) :=
  haveI : Fact (Nat.Prime 349) := ⟨by norm_num⟩
  RabinCert.irreducible_of_rabin_int P_monic hmap hmon' hnd (by norm_num) hF h1 h2

