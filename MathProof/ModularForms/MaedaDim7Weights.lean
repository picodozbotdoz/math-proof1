    rw [ev_3, det_3]
  · change P.eval (4 : ℤ)
      = (Matrix.scalar (Fin 7) (4 : ℤ) - M).det
    rw [ev_4, det_4]
  · change P.eval (5 : ℤ)
      = (Matrix.scalar (Fin 7) (5 : ℤ) - M).det
    rw [ev_5, det_5]
  · change P.eval (6 : ℤ)
      = (Matrix.scalar (Fin 7) (6 : ℤ) - M).det
