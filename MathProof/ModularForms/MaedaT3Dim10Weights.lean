  · change P.eval (2 : ℤ)
      = (Matrix.scalar (Fin 10) (2 : ℤ) - M).det
    rw [ev_2, det_2]
  · change P.eval (3 : ℤ)
      = (Matrix.scalar (Fin 10) (3 : ℤ) - M).det
    rw [ev_3, det_3]
  · change P.eval (4 : ℤ)
      = (Matrix.scalar (Fin 10) (4 : ℤ) - M).det
