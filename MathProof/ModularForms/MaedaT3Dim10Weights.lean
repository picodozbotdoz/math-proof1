      (RabinCert.zpxwsubX 163 fr 74 (163 ^ (10 / 5))) = [1] :=
  ⟨15, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 10 → ∃ w : ℕ,
      RabinCert.zpgcd 163 w fr
      (RabinCert.zpxwsubX 163 fr 74 (163 ^ (10 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 10 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
