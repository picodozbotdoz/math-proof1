    = ((Ik : ℤ) : ℂ) • MaedaT3Weight36.T3 :=
  int_poly_of_dimN (by norm_num) MaedaT3Weight36.finrank_eq MaedaT3Weight36.fb
    MaedaT3Weight36.Atab HeckeRatWeight36.Xtab2 MaedaT3Weight36.Xtab
    MaedaT3Weight36.hzero MaedaT3Weight36.hone MaedaT3Weight36.hA
    HeckeRatWeight36.T2 MaedaT3Weight36.T3 HeckeRatWeight36.hX2 MaedaT3Weight36.hX
    HeckeRatWeight36.M2 MaedaT3Weight36.M HeckeRatWeight36.hM2 HeckeRatWeight36.hM3
    wp Ik scaled

/-- The reduced denominator of the landed rational witness at weight 36 (G1 audit). -/
def Dn : ℤ :=
  72

theorem scaled_idN :
    (∑ j ∈ Finset.range 3, HeckeRatWeight36.cert j • HeckeRatWeight36.M2 ^ j)
      = Dn • MaedaT3Weight36.M := HeckeRatWeight36.scaled_id

theorem hDq : ((Dn : ℤ) : ℚ) ≠ 0 := by norm_num [Dn]
theorem hDc : ((Dn : ℤ) : ℂ) ≠ 0 := by norm_num [Dn]

/-- The rational-witness representation (from the landed certificate). -/
theorem hrepD : MaedaT3Weight36.T3 = Polynomial.aeval HeckeRatWeight36.T2
    ((∑ j ∈ Finset.range 3, C ((((HeckeRatWeight36.cert j : ℤ) : ℚ) / (Dn : ℚ)))
      * (X : ℚ[X]) ^ j).map (algebraMap ℚ ℂ)) :=
  aeval_div_witness HeckeRatWeight36.T2 MaedaT3Weight36.T3 HeckeRatWeight36.cert Dn hDc
    (int_poly_of_dimN (by norm_num) MaedaT3Weight36.finrank_eq MaedaT3Weight36.fb
      MaedaT3Weight36.Atab HeckeRatWeight36.Xtab2 MaedaT3Weight36.Xtab
      MaedaT3Weight36.hzero MaedaT3Weight36.hone MaedaT3Weight36.hA
      HeckeRatWeight36.T2 MaedaT3Weight36.T3 HeckeRatWeight36.hX2 MaedaT3Weight36.hX
      HeckeRatWeight36.M2 MaedaT3Weight36.M HeckeRatWeight36.hM2 HeckeRatWeight36.hM3
      HeckeRatWeight36.cert Dn scaled_idN).symm

/-- The index representation (from the new certificate). -/
theorem hrepI : MaedaT3Weight36.T3 = Polynomial.aeval HeckeRatWeight36.T2
    ((∑ j ∈ Finset.range 3, C ((((wp j : ℤ) : ℚ) / (Ik : ℚ)))
      * (X : ℚ[X]) ^ j).map (algebraMap ℚ ℂ)) :=
  aeval_div_witness HeckeRatWeight36.T2 MaedaT3Weight36.T3 wp Ik hIkc op_id.symm

/-- `minpoly ℂ T₂` has degree `n` (the charpoly is irreducible). -/
theorem minpoly_nd : (minpoly ℂ (MaedaWeight36.T2 : Module.End ℂ
    (CuspForm 𝒮ℒ ((36 : ℕ) : ℤ)))).natDegree = 3 := by
  rw [HeckeGeneratedByT2.minpoly_eq_charpoly_of_map_of_irreducible
    MaedaWeight36.charpoly_T2 MaedaWeight36.maeda, MaedaWeight36.charpoly_T2,
    Polynomial.natDegree_map_eq_of_injective (RingHom.injective_int _)]
  unfold MaedaWeight36.P; compute_degree!

/-- The Bézout witness `∑ bez j * N j + bezc * D = 1` (balanced extgcd tree, G1 strategy). -/
def bez : ℕ → ℤ
  | 0 => 0
  | 1 => 0
  | 2 => -1
  | _ => 0

/-- The Bézout coefficient of `D`. -/
def bezc : ℤ :=
  0

/-- The Bézout identity over a `List` sum: the kernel certificate (a
`Finset` sum would route through `Multiset`'s quotient and pull
`Classical.choice`/`Quot.sound` into the decide — CLAUDE.md rule). -/
theorem hbezL : ((List.range 3).map fun j => bez j * HeckeRatWeight36.cert j).sum
    + bezc * Dn = 1 := by
  decide +kernel

theorem hbez : ∑ j ∈ Finset.range 3, bez j * HeckeRatWeight36.cert j
    + bezc * Dn = 1 := by
  rw [MaedaLevelOne.finset_sum_range_eq_list]
  exact hbezL

/-- **The composite: the reduced denominator divides the index.** -/
theorem D_dvd_Ik : Dn ∣ Ik :=
  den_dvd_index (by norm_num) HeckeRatWeight36.T2 MaedaT3Weight36.T3 minpoly_nd
    HeckeRatWeight36.cert wp Dn Ik hDq hIkq hrepD hrepI bez bezc hbez

end HeckeIndexWeight36

