import MathProof.ModularForms.HeckeLatticeIndex
import MathProof.ModularForms.HeckeIndexSmallWeights
import MathProof.ModularForms.HeckeGeneratedByT2SmallWeights

open HeckeIndex HeckeLatticeIndex HeckeTM MaedaLevelOne
open UpperHalfPlane ModularForm CuspForm
open scoped MatrixGroups

/-!
# The lattice index `[𝕋 : ℤ[T₂]]` at every level-one weight with `2 ≤ dim S_k ≤ 5`

Generated by `tools/gen_hecke_index.py --card` from the landed literals
(the `Atab` tables of the `MaedaT3` files, the `T₂` matrices of the
`HeckeRational` / `MaedaDim` files, `I_k` of the `HeckeIndex` files; parsed
with the iteration-23/24 G1 audit parsers; byte-identical re-runs, `--check`;
do not hand-edit).  For each of the 24 weights with `2 ≤ dim S_k ≤ 5`
(the 54 weights `24 ≤ k ≤ 134` are split by dimension over
`HeckeIndexCardSmallWeights` / `HeckeIndexCardWeights`): the dual
coordinates `C i j = a_1(T₂^i g_j)` of the powers of `T₂` over the Hecke
basis `T_1, …, T_n` (`g` the Miller basis), certified entrywise by
`decide +kernel` (`hcard`), `det C = ±I_k` (`eval_det`), and the lattice
index `[𝕋 : ℤ[T₂]] = |I_k|` as an `AddSubgroup.relIndex` (`index_card`) and
as `Nat.card (𝕋 ⧸ ℤ[T₂])` (`index_card_natCard`), through
`HeckeLatticeIndex.index_card_dimN`.

Everything is light: no `set_option`, no `native_decide`/`sorry`; the only
decides are the entrywise per-cell certificates, all `decide +kernel`.
-/

/-! ### Weight 24 (dim 2) -/
namespace HeckeIndexCardWeight24

/-- The landed echelon table `MaedaT3Weight24.Atab`, integer-typed (G1 audit). -/
def atab : ℕ → ℕ → ℤ
  | 0, 1 => 696
  | _, _ => 0

theorem hAeq : ∀ i j : ℕ, i < j → j < 2 →
    MaedaT3Weight24.Atab i j = ((atab i j : ℤ) : ℂ) := by
  intro i j hij hj
  obtain rfl : j = 1 := by omega
  obtain rfl : i = 0 := by omega
  norm_num [MaedaT3Weight24.Atab, atab]

/-- The echelon basis at weight 24 has integer `q`-coefficients (all `m`). -/
theorem hfi : ∀ i : ℕ, i < 2 → ∀ m : ℕ,
    ∃ z : ℤ, (qExpansion 1 (MaedaT3Weight24.fb i)).coeff m = (z : ℂ)
  | 0, _, m => ⟨_, MaedaT3Weight24.c1 m⟩
  | 1, _, m => ⟨_, MaedaT3Weight24.c2 m⟩
  | _ + 2, h, _ => absurd h (by omega)

/-- `minpoly T₂` has degree `dim S_24 = 2` (Maeda: charpoly irreducible). -/
theorem hmin : (minpoly ℂ (heckeTM ((24 : ℕ) : ℤ) 2)).natDegree = 2 := by
  rw [HeckeTM.heckeTM_prime _ Nat.prime_two]
  change (minpoly ℂ (MaedaWeight24.heckeT2 :
    Module.End ℂ (CuspForm 𝒮ℒ ((24 : ℕ) : ℤ)))).natDegree = 2
  rw [HeckeGeneratedByT2.minpoly_eq_charpoly_of_map_of_irreducible
    MaedaWeight24.charpoly_heckeT2
    MaedaWeight24.maeda_weight24,
    LinearMap.charpoly_natDegree, MaedaT3Weight24.finrank_eq]

/-- Dual coordinates at weight 24: `T₂^i = ∑_j C i j • T_(j+1)`. -/
def C : Matrix (Fin 2) (Fin 2) ℤ := !![
1, 0;
0, 1]

/-- The entrywise kernel certificate: `C` is the Miller-conjugated row-0 of the
powers of the landed `T₂` matrix. -/
theorem hcard : Matrix.of (fun i j : Fin 2 =>
    ∑ c : Fin 2, millerCoeff atab 2 j.val c.val
      * (HeckeRatWeight24.M2 ^ (i : ℕ)) 0 c) = C := by
  ext i j
  fin_cases i <;> fin_cases j <;> decide +kernel

/-- `det C = ±I_k` (certified Bareiss `eval_det`; `I_k` the landed literal). -/
theorem det_C : C.det = HeckeIndexWeight24.Ik := by
  simp only [C]
  eval_det
  norm_num [HeckeIndexWeight24.Ik]

/-- **The lattice index at weight 24**: `[𝕋 : ℤ[T₂]] = |I_k|`. -/
theorem index_card : (t2Lattice (heckeTM ((24 : ℕ) : ℤ) 2) 2).toAddSubgroup.relIndex
    (heckeLattice ((24 : ℕ) : ℤ) 2).toAddSubgroup = HeckeIndexWeight24.Ik.natAbs :=
  index_card_dimN (by norm_num) (by norm_num) MaedaT3Weight24.finrank_eq MaedaT3Weight24.fb
    MaedaT3Weight24.Atab MaedaT3Weight24.hzero MaedaT3Weight24.hone MaedaT3Weight24.hA hfi hmin
    atab hAeq HeckeRatWeight24.Xtab2 HeckeRatWeight24.hX2 HeckeRatWeight24.M2 HeckeRatWeight24.hM2
    C hcard HeckeIndexWeight24.Ik (by rw [det_C])

/-- **The lattice index at weight 24**, as `Nat.card (𝕋 ⧸ ℤ[T₂])`. -/
theorem index_card_natCard : Nat.card (↥(heckeLattice ((24 : ℕ) : ℤ) 2).toAddSubgroup ⧸
    (t2Lattice (heckeTM ((24 : ℕ) : ℤ) 2) 2).toAddSubgroup.addSubgroupOf
      (heckeLattice ((24 : ℕ) : ℤ) 2).toAddSubgroup) = HeckeIndexWeight24.Ik.natAbs :=
  index_card_natCard_dimN (by norm_num) (by norm_num) MaedaT3Weight24.finrank_eq
    MaedaT3Weight24.fb MaedaT3Weight24.Atab MaedaT3Weight24.hzero MaedaT3Weight24.hone
    MaedaT3Weight24.hA hfi hmin atab hAeq HeckeRatWeight24.Xtab2 HeckeRatWeight24.hX2
    HeckeRatWeight24.M2 HeckeRatWeight24.hM2 C hcard HeckeIndexWeight24.Ik (by rw [det_C])

end HeckeIndexCardWeight24

