/-!
# The level-one Hecke algebra is generated by `T₂` (54 verified weights)

Combines the two halves of the Iteration-21 upgrade:

* the **algebra half** (`HeckeAlgebraQT2.lean`) says that a `T₂` with irreducible
  characteristic polynomial generates its commutant.  Over `ℂ` the
  characteristic polynomial of `T₂` is never irreducible (degrees are ≥ 2), but
  the *same conclusion* holds whenever `minpoly = charpoly` (a cyclic
  operator):  this file first generalizes the upgrade theorem to that
  hypothesis (`exists_aeval_of_commute_of_minpoly_eq_charpoly`, the cyclic
  vector coming from the PID structure theorem
  `Module.exists_ker_toSpanSingleton_eq_annihilator` applied to the `ℂ[X]`-module
  `Module.AEval' T₂`), and then shows `minpoly ℂ T₂ = charpoly T₂` from the
  shape of the verified data (`minpoly_eq_charpoly_of_map_of_irreducible`):
  an integer polynomial `P` with `P.map ℚ` irreducible is separable, so over
  `ℂ` it has `deg P` distinct roots; each root of the characteristic polynomial
  is an eigenvalue (`Module.End.hasEigenvalue_iff_isRoot_charpoly`), hence a
  root of the minimal polynomial (`Module.End.isRoot_of_hasEigenvalue`), which
  forces the degrees — and the monic polynomials — to agree.

* the **analytic half** is `HeckeCommute.heckeTPₗ_commute`: all `T_p` commute
  with `T₂`.

Together (`heckeTP_mem_spanT2`), for every `T₂` whose characteristic
polynomial is an integer polynomial irreducible over `ℚ`, each Hecke operator
`T_p` is a polynomial in `T₂` with complex coefficients.  Instantiated at the
54 verified weights (`MaedaWeight24.maeda_weight24`, the eleven weights of
`MaedaSmallWeights`, and the 42 weights of `MaedaDim4Weights` …
`MaedaDim10Weights`), this gives `heckeTPₗ_mem_spanT2_weightKK`: **the Hecke
algebra of `S_k(SL(2, ℤ))` is generated by `T₂` alone in these weights.**

The per-weight corollaries are generated by `tools/gen_hecke_gen_t2.py`.
-/

open Polynomial MaedaLevelOne HeckeCommute
open scoped MatrixGroups

namespace HeckeGeneratedByT2

/-! ### Evaluation of polynomials at an operator, applied to a vector -/

section Eval

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]

/-- Evaluation of polynomials at `T`, applied to a fixed vector `v`:
`p ↦ (Polynomial.aeval T p) v` (the mirror of the private definition in
`HeckeAlgebraQT2.lean`). -/
private noncomputable def evalAeval (T : V →ₗ[K] V) (v : V) : K[X] →ₗ[K] V where
  toFun p := Polynomial.aeval T p v
  map_add' p q := by rw [map_add, LinearMap.add_apply]
  map_smul' c p := by rw [RingHom.id_apply, map_smul, LinearMap.smul_apply]

@[simp]
private lemma evalAeval_apply (T : V →ₗ[K] V) (v : V) (p : K[X]) :
    evalAeval T v p = Polynomial.aeval T p v := rfl

end Eval

/-! ### The cyclic-vector upgrade theorem -/

section Algebra

variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]

/-- **Cyclic vector from the structure theorem over `K[X]`.**  If
`minpoly K T = charpoly T`, there is a vector `v₀` whose `K[X]`-annihilator
(for the module structure induced by `T`) is exactly the ideal generated by the
minimal polynomial: `(aeval T p) v₀ = 0 ↔ minpoly K T ∣ p`. -/
private theorem exists_ann_eq_minpoly {T : V →ₗ[K] V} :
    ∃ v₀ : V, ∀ p : K[X], Polynomial.aeval T p v₀ = 0 ↔ minpoly K T ∣ p := by
  classical
  obtain ⟨x, hx⟩ :=
    Module.exists_ker_toSpanSingleton_eq_annihilator K[X] (Module.AEval' T)
  -- transport of the `K[X]`-action along the canonical equivalence `of`
  have hsmul : ∀ p : K[X], p • x = 0
      ↔ Polynomial.aeval T p ((Module.AEval'.of T).symm x) = 0 := by
    intro p
    constructor
    · intro h
      have h1 : (Module.AEval'.of T).symm (p • x) = 0 := by
        rw [Module.AEval.of_symm_smul T p x, Module.End.smul_def]
        exact h
      exact h1
    · intro h
      have h1 : (Module.AEval'.of T).symm (p • x) = 0 := by
        rw [Module.AEval.of_symm_smul T p x, Module.End.smul_def, h]
      have h2 : (Module.AEval'.of T).symm (p • x) = (Module.AEval'.of T).symm 0 := by
        rw [h1, map_zero]
      exact LinearEquiv.injective _ h2
  refine ⟨(Module.AEval'.of T).symm x, fun p => ⟨fun hp => ?_, fun hp => ?_⟩⟩
  · have hmem : p ∈ (LinearMap.toSpanSingleton K[X] (Module.AEval' T) x).ker :=
      LinearMap.mem_ker.mpr ((hsmul p).mp hp)
    rw [hx, ← Polynomial.span_minpoly_eq_annihilator] at hmem
    exact Ideal.mem_span_singleton.mp hmem
  · have hmem : p ∈ Ideal.span {minpoly K T} := Ideal.mem_span_singleton.mpr hp
    rw [Polynomial.span_minpoly_eq_annihilator, ← hx] at hmem
    exact (hsmul p).mpr (LinearMap.mem_ker.mp hmem)

/-- **The upgrade theorem, cyclic form.**  If `minpoly K T₂ = charpoly T₂`
(equivalently, `T₂` is a cyclic endomorphism), then every endomorphism
commuting with `T₂` is a polynomial in `T₂`.  This is the version of
`HeckeAlgebra.exists_aeval_of_commute_of_irreducible_charpoly` that applies
over an algebraically closed field: irreducibility of the characteristic
polynomial is replaced by the degree equality it was used for. -/
theorem exists_aeval_of_commute_of_minpoly_eq_charpoly {T2 Tn : V →ₗ[K] V}
    (hmm : minpoly K T2 = LinearMap.charpoly T2) (hcomm : Commute Tn T2) :
    ∃ q : K[X], Tn = Polynomial.aeval T2 q := by
  obtain ⟨v₀, hv₀⟩ := exists_ann_eq_minpoly (T := T2)
  have hmon : (minpoly K T2).Monic := minpoly.monic (LinearMap.isIntegral T2)
  have hdeg : (minpoly K T2).natDegree = Module.finrank K V := by
    rw [hmm, LinearMap.charpoly_natDegree T2]
  -- injectivity of `p ↦ (aeval T₂ p) v₀` on the polynomials of degree `< n`
  have hinj : Function.Injective ⇑
      ((evalAeval T2 v₀).comp
        (Polynomial.degreeLT K (minpoly K T2).natDegree).subtype) := by
    intro x y hxy
    have hxy' : evalAeval T2 v₀ x.val = evalAeval T2 v₀ y.val := by
      simpa only [LinearMap.comp_apply, Submodule.coe_subtype] using hxy
    have hmem : x.val - y.val ∈
        Polynomial.degreeLT K (minpoly K T2).natDegree :=
      Submodule.sub_mem (Polynomial.degreeLT K (minpoly K T2).natDegree) x.2 y.2
    have hr : Polynomial.aeval T2 (x.val - y.val) v₀ = 0 := by
      rw [← evalAeval_apply, map_sub, hxy', sub_self]
    have hdvd : minpoly K T2 ∣ x.val - y.val := (hv₀ _).mp hr
    have hzero : x.val - y.val = 0 := by
      by_contra h0
      have h1 : (minpoly K T2).natDegree ≤ (x.val - y.val).natDegree :=
        Polynomial.natDegree_le_of_dvd hdvd h0
      have h2 : (x.val - y.val).natDegree < (minpoly K T2).natDegree := by
        rw [Polynomial.natDegree_lt_iff_degree_lt h0]
        exact Polynomial.mem_degreeLT.mp hmem
      omega
    exact Subtype.ext (sub_eq_zero.mp hzero)
  -- dimension counting: the evaluations at `v₀` span everything
  have hdimLT : Module.finrank K
      (Polynomial.degreeLT K (minpoly K T2).natDegree) =
      (minpoly K T2).natDegree := by
    rw [LinearEquiv.finrank_eq
      (Polynomial.degreeLTEquiv K (minpoly K T2).natDegree)]
    exact Module.finrank_fin_fun (R := K)
  have hfrange : Module.finrank K (LinearMap.range
      ((evalAeval T2 v₀).comp
        (Polynomial.degreeLT K (minpoly K T2).natDegree).subtype)) =
      (minpoly K T2).natDegree := by
    rw [LinearMap.finrank_range_of_inj hinj, hdimLT]
  have hsub : LinearMap.range ((evalAeval T2 v₀).comp
      (Polynomial.degreeLT K (minpoly K T2).natDegree).subtype) ≤
      LinearMap.range (evalAeval T2 v₀) := by
    intro w hw
    obtain ⟨x, hx⟩ := LinearMap.mem_range.mp hw
    refine LinearMap.mem_range.mpr ⟨x.val, ?_⟩
    simpa only [LinearMap.comp_apply, Submodule.coe_subtype] using hx
  have hle : (minpoly K T2).natDegree ≤
      Module.finrank K (LinearMap.range (evalAeval T2 v₀)) := by
    rw [← hfrange]
    exact Submodule.finrank_mono hsub
  have htop : LinearMap.range (evalAeval T2 v₀) = ⊤ := by
    refine Submodule.eq_top_of_finrank_eq (le_antisymm (Submodule.finrank_le _) ?_)
    rw [← hdeg]
    exact hle
  -- `Tₙ` commutes with every polynomial in `T₂`
  have hpow : ∀ n : ℕ, Commute Tn (T2 ^ n) := by
    intro n
    induction n with
    | zero => rw [pow_zero]; exact Commute.one_right Tn
    | succ n ih => rw [pow_succ]; exact Commute.mul_right ih hcomm
  have hTnaev : ∀ p : K[X], Commute Tn (Polynomial.aeval T2 p) := by
    intro p
    induction p using Polynomial.induction_on' with
    | add p q ihp ihq =>
        rw [map_add]
        exact Commute.add_right ihp ihq
    | monomial n a =>
        rw [aeval_monomial]
        exact (Algebra.commute_algebraMap_right a Tn).mul_right (hpow n)
  have hswap : ∀ p : K[X], Tn (Polynomial.aeval T2 p v₀)
      = Polynomial.aeval T2 p (Tn v₀) := by
    intro p
    rw [← Module.End.mul_apply, (hTnaev p).eq, Module.End.mul_apply]
  -- finish: encode `Tₙ v₀` and spread by cyclicity
  have hmulcomm : ∀ p q : K[X], Polynomial.aeval T2 p * Polynomial.aeval T2 q
      = Polynomial.aeval T2 q * Polynomial.aeval T2 p := by
    intro p q
    rw [← map_mul, mul_comm p q, map_mul]
  have hmemq : Tn v₀ ∈ LinearMap.range (evalAeval T2 v₀) := by
    rw [htop]
    exact Submodule.mem_top
  obtain ⟨q₀, hq₀⟩ := LinearMap.mem_range.mp hmemq
  have hq₀' : Polynomial.aeval T2 q₀ v₀ = Tn v₀ := by
    rw [← evalAeval_apply]
    exact hq₀
  refine ⟨q₀, LinearMap.ext fun w => ?_⟩
  obtain ⟨p, hp⟩ : ∃ p : K[X], Polynomial.aeval T2 p v₀ = w := by
    have hw : w ∈ LinearMap.range (evalAeval T2 v₀) := by
      rw [htop]
      exact Submodule.mem_top
    obtain ⟨p, hp⟩ := LinearMap.mem_range.mp hw
    exact ⟨p, by rw [← evalAeval_apply]; exact hp⟩
  have h2 : Polynomial.aeval T2 p (Tn v₀)
      = Polynomial.aeval T2 p (Polynomial.aeval T2 q₀ v₀) := by
    rw [hq₀']
  have h3 : Polynomial.aeval T2 p (Polynomial.aeval T2 q₀ v₀)
      = Polynomial.aeval T2 q₀ (Polynomial.aeval T2 p v₀) := by
    rw [← Module.End.mul_apply, hmulcomm p q₀, Module.End.mul_apply]
  calc Tn w = Tn (Polynomial.aeval T2 p v₀) := by rw [hp]
    _ = Polynomial.aeval T2 p (Tn v₀) := hswap p
    _ = Polynomial.aeval T2 p (Polynomial.aeval T2 q₀ v₀) := h2
    _ = Polynomial.aeval T2 q₀ (Polynomial.aeval T2 p v₀) := h3
    _ = Polynomial.aeval T2 q₀ w := by rw [hp]

end Algebra

/-! ### From an irreducible rational charpoly to `minpoly = charpoly` over `ℂ` -/

section Complex

variable {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]

/-- If the characteristic polynomial of `T : V →ₗ[ℂ] V` is the image of an
integer polynomial `P` whose rational image is irreducible, then the minimal
polynomial of `T` (over `ℂ`!) equals the characteristic polynomial.  The
irreducible rational polynomial is separable, so over `ℂ` the characteristic
polynomial has `deg P` distinct roots; each is an eigenvalue, hence a root of
the minimal polynomial, and degree counting finishes. -/
theorem minpoly_eq_charpoly_of_map_of_irreducible {T : V →ₗ[ℂ] V} {P : ℤ[X]}
    (hchar : LinearMap.charpoly T = P.map (Int.castRingHom ℂ))
    (hirr : Irreducible (P.map (Int.castRingHom ℚ))) :
    minpoly ℂ T = LinearMap.charpoly T := by
  have hcomp : (algebraMap ℚ ℂ).comp (Int.castRingHom ℚ) = Int.castRingHom ℂ := by
    ext x
    rfl
  have hchar' : LinearMap.charpoly T
      = (P.map (Int.castRingHom ℚ)).map (algebraMap ℚ ℂ) := by
    rw [hchar, Polynomial.map_map, hcomp]
  have hQ0 : P.map (Int.castRingHom ℚ) ≠ 0 := Irreducible.ne_zero hirr
  have hsep : (P.map (Int.castRingHom ℚ)).Separable :=
    PerfectField.separable_of_irreducible hirr
  have hsep' : ((P.map (Int.castRingHom ℚ)).map (algebraMap ℚ ℂ)).Separable :=
    (Polynomial.separable_map (algebraMap ℚ ℂ)).mpr hsep
  have hsplits : ((P.map (Int.castRingHom ℚ)).map (algebraMap ℚ ℂ)).Splits :=
    IsAlgClosed.splits _
  have hcp0 : LinearMap.charpoly T ≠ 0 := (LinearMap.charpoly_monic T).ne_zero
  have hnd : (LinearMap.charpoly T).roots.Nodup := by
    rw [hchar']
    exact Polynomial.nodup_roots hsep'
  have hcard : Multiset.card (LinearMap.charpoly T).roots
      = (LinearMap.charpoly T).natDegree := by
    rw [hchar']
    exact hsplits.natDegree_eq_card_roots.symm
  -- every root of the characteristic polynomial is a root of the minimal one
  have hsub : (LinearMap.charpoly T).roots.toFinset
      ⊆ (minpoly ℂ T).roots.toFinset := by
    intro μ hμ
    refine Multiset.mem_toFinset.mpr ?_
    have hroot : (LinearMap.charpoly T).IsRoot μ :=
      (Polynomial.mem_roots hcp0).mp (Multiset.mem_toFinset.mp hμ)
    have hev : Module.End.HasEigenvalue (T : Module.End ℂ V) μ :=
      (Module.End.hasEigenvalue_iff_isRoot_charpoly (T : Module.End ℂ V) μ).mpr hroot
    exact (Polynomial.mem_roots (minpoly.monic (LinearMap.isIntegral T)).ne_zero).mpr
      (Module.End.isRoot_of_hasEigenvalue hev)
  -- degree counting
  have hmono : (minpoly ℂ T).Monic := minpoly.monic (LinearMap.isIntegral T)
  have hle : (minpoly ℂ T).natDegree ≤ (LinearMap.charpoly T).natDegree :=
    Polynomial.natDegree_le_of_dvd (LinearMap.minpoly_dvd_charpoly T) hcp0
  have hge : (LinearMap.charpoly T).natDegree ≤ (minpoly ℂ T).natDegree := by
    have h1 : (LinearMap.charpoly T).natDegree
        = (LinearMap.charpoly T).roots.toFinset.card := by
      rw [Multiset.toFinset_card_of_nodup hnd, hcard]
    have h2 : (LinearMap.charpoly T).roots.toFinset.card
        ≤ (minpoly ℂ T).roots.toFinset.card := Finset.card_le_card hsub
    have h3 : (minpoly ℂ T).roots.toFinset.card
        ≤ Multiset.card (minpoly ℂ T).roots := Multiset.toFinset_card_le _
    have h4 : Multiset.card (minpoly ℂ T).roots ≤ (minpoly ℂ T).natDegree :=
      Polynomial.card_roots' (minpoly ℂ T)
    omega
  have hnat : (minpoly ℂ T).natDegree = (LinearMap.charpoly T).natDegree :=
    le_antisymm hle hge
  -- monic + divisibility + equal degrees
  obtain ⟨s, hs⟩ := LinearMap.minpoly_dvd_charpoly T
  have hs0 : s ≠ 0 := by
    rintro rfl
    rw [mul_zero] at hs
    exact hcp0 hs
  have hsdeg : s.natDegree = 0 := by
    have h1 : (minpoly ℂ T * s).natDegree
        = (minpoly ℂ T).natDegree + s.natDegree :=
      Polynomial.natDegree_mul hmono.ne_zero hs0
    rw [← hs] at h1
    omega
  have hsmon : s.Monic :=
    Polynomial.Monic.of_mul_monic_left hmono (by rw [← hs]; exact LinearMap.charpoly_monic T)
  have hsconst : s = 1 := by
    have hlc : s.leadingCoeff = 1 := hsmon.leadingCoeff
    have hcoef : s.coeff 0 = 1 := by
      have h2 : s.leadingCoeff = s.coeff s.natDegree := rfl
      rw [hsdeg] at h2
      rw [← h2, hlc]
    rw [Polynomial.eq_C_of_natDegree_eq_zero hsdeg, hcoef, Polynomial.C_1]
  rw [hs, hsconst, mul_one]

end Complex

/-! ### The per-weight statement -/

section Weight

open UpperHalfPlane ModularForm CuspForm

variable {p : ℕ}

/-- **Weight-generic upgrade**: if the characteristic polynomial of `T₂` on
`S_k(SL(2, ℤ))` is the image of an integer polynomial that is irreducible over
`ℚ`, then every Hecke operator `T_p` on `S_k` is a polynomial in `T₂` with
complex coefficients:  the level-one Hecke algebra is generated by `T₂`. -/
theorem heckeTP_mem_spanT2 {W : ℕ} {P : ℤ[X]}
    (hchar : (heckeTPₗ ((W : ℕ) : ℤ) Nat.prime_two).charpoly
      = P.map (Int.castRingHom ℂ))
    (hirr : Irreducible (P.map (Int.castRingHom ℚ))) (hp : p.Prime) :
    ∃ Q : ℂ[X], heckeTPₗ ((W : ℕ) : ℤ) hp
      = Polynomial.aeval (heckeTPₗ ((W : ℕ) : ℤ) Nat.prime_two) Q :=
  exists_aeval_of_commute_of_minpoly_eq_charpoly
    (minpoly_eq_charpoly_of_map_of_irreducible hchar hirr)
    (heckeTPₗ_commute hp Nat.prime_two _)

end Weight

end HeckeGeneratedByT2
