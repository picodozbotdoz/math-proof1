lemma finrank_eq : Module.finrank ℂ (CuspForm 𝒮ℒ ((108 : ℕ) : ℤ)) = 9 := by
  apply Module.finrank_eq_of_rank_eq
  rw [CuspForm.discriminantEquiv.rank_eq]
  have h := ModularForm.dimension_level_one 96 (by decide)
  norm_num [Nat.ModEq] at h
  exact_mod_cast h

