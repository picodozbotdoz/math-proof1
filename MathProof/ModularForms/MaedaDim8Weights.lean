lemma hmon' : (RabinCert.toPoly 127 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 127 fr).natDegree = 8 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 127 ^ 8 < 2 ^ 56 := by norm_num

lemma h1 : RabinCert.zpxw 127 fr (RabinCert.bitsOf 56 (127 ^ 8)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 127 w fr
      (RabinCert.zpxwsubX 127 fr 56 (127 ^ (8 / 2))) = [1] :=
  ⟨13, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 8 → ∃ w : ℕ,
      RabinCert.zpgcd 127 w fr
      (RabinCert.zpxwsubX 127 fr 56 (127 ^ (8 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 8 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
