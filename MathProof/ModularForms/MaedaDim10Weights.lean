lemma hmon' : (RabinCert.toPoly 163 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 163 fr).natDegree = 10 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 163 ^ 10 < 2 ^ 74 := by norm_num

lemma h1 : RabinCert.zpxw 163 fr (RabinCert.bitsOf 74 (163 ^ 10)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 163 w fr
      (RabinCert.zpxwsubX 163 fr 74 (163 ^ (10 / 2))) = [1] :=
  ⟨15, by decide +kernel⟩

lemma h2_5 : ∃ w : ℕ, RabinCert.zpgcd 163 w fr
      (RabinCert.zpxwsubX 163 fr 74 (163 ^ (10 / 5))) = [1] :=
  ⟨15, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 10 → ∃ w : ℕ,
      RabinCert.zpgcd 163 w fr
      (RabinCert.zpxwsubX 163 fr 74 (163 ^ (10 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 10 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact h2_5
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)

