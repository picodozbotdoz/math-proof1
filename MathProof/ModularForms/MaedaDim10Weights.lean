lemma finrank_eq : Module.finrank ℂ (CuspForm 𝒮ℒ ((124 : ℕ) : ℤ)) = 10 := by
  apply Module.finrank_eq_of_rank_eq
  rw [CuspForm.discriminantEquiv.rank_eq]
  have h := ModularForm.dimension_level_one 112 (by decide)
  norm_num [Nat.ModEq] at h
  exact_mod_cast h

