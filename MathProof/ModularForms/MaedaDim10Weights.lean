lemma h1 : RabinCert.zpxw 149 fr (RabinCert.bitsOf 73 (149 ^ 10)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 149 w fr
      (RabinCert.zpxwsubX 149 fr 73 (149 ^ (10 / 2))) = [1] :=
  ⟨15, by decide +kernel⟩

lemma h2_5 : ∃ w : ℕ, RabinCert.zpgcd 149 w fr
      (RabinCert.zpxwsubX 149 fr 73 (149 ^ (10 / 5))) = [1] :=
  ⟨15, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 10 → ∃ w : ℕ,
      RabinCert.zpgcd 149 w fr
      (RabinCert.zpxwsubX 149 fr 73 (149 ^ (10 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 10 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact h2_5
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)

