lemma hmon' : (RabinCert.toPoly 199 fr).Monic := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  monicity!

lemma hnd : (RabinCert.toPoly 199 fr).natDegree = 10 := by
  simp only [RabinCert.toPoly_nil, RabinCert.toPoly_cons, fr, mul_zero, add_zero]
  compute_degree!

lemma hF : 199 ^ 10 < 2 ^ 77 := by norm_num

lemma h1 : RabinCert.zpxw 199 fr (RabinCert.bitsOf 77 (199 ^ 10)) [1] = [0, 1] :=
  by decide +kernel

lemma h2_2 : ∃ w : ℕ, RabinCert.zpgcd 199 w fr
      (RabinCert.zpxwsubX 199 fr 77 (199 ^ (10 / 2))) = [1] :=
  ⟨15, by decide +kernel⟩

lemma h2_5 : ∃ w : ℕ, RabinCert.zpgcd 199 w fr
      (RabinCert.zpxwsubX 199 fr 77 (199 ^ (10 / 5))) = [1] :=
  ⟨15, by decide +kernel⟩

lemma h2 : ∀ q : ℕ, q.Prime → q ∣ 10 → ∃ w : ℕ,
      RabinCert.zpgcd 199 w fr
      (RabinCert.zpxwsubX 199 fr 77 (199 ^ (10 / q))) = [1] := by
  intro q hq hq2
  have hqb : q ≤ 10 := Nat.le_of_dvd (by norm_num) hq2
  interval_cases q
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact h2_2
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact h2_5
  · exact absurd hq (by decide)
  · exact absurd hq2 (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)
  · exact absurd hq (by decide)

/-- The second certificate prime (sanity decide, not used by `maeda`). -/
