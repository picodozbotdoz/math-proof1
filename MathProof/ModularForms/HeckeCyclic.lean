import MathProof.ModularForms.HeckeIndex
import Mathlib.RingTheory.PowerBasis

/-!
# HeckeCyclic: the quotient `𝕋 ⧸ ℤ[T₂]` is cyclic at `n ≤ 4`, and `D = I_k`

Iteration 24, blueprint `index-cyclic` (b2), closing
iteration23-review §6.2/§6.3 on the dims ≤ 4 weights (FINDINGS F1/F5/F7).
The classical prediction: at every level-one weight with `dim S_k ≤ 4`,
`T₁ = 1` and `T₄ = T₂² − 2^{k−1}·T₁` (`heckeTM_two_mul_even`) put
`T₁, T₂, T₄ ∈ ℤ[T₂]`, so the additive quotient `G := 𝕋 ⧸ ℤ[T₂]` is
generated by the single class `[T₃]`; the reduced denominator `D` of the
landed T₃ witness kills `[T₃]`, so `|G| ∣ D`, and with the landed
`D ∣ I_k` (`HeckeIndexWeightKK.D_dvd_Ik`) and positivity, `D = I_k`.

Generic layers (no per-weight data here; the instantiations live in
`HeckeCyclicWeights`):

* **Group layer** (`zmulHom`, `card_dvd_of_generator`,
  `card_quotient_eq_one_iff`): an additive quotient `L ⧸ (N ⊓ L)`
  generated by the class of `t`, with `D • t ∈ N` and `0 < D`, admits a
  surjection `ZMod D →+ L ⧸ N.addSubgroupOf L` (`ZMod.lift` through
  `zmulHom`), hence `Nat.card (L ⧸ N.addSubgroupOf L) ∣ D` (Lagrange on
  the kernel); and `Nat.card (L ⧸ N.addSubgroupOf L) = 1 ↔ L = N`.
* **The span** `t2Span T2 n = span ℤ {T₂^j : j < n}` — the blueprint b1
  contract form of `HeckeLatticeIndex.t2Lattice`, kept definitionally
  identical so that adoption is a `rfl` — with `pow_mem_t2Span`.
* **Cyclicity** (`heckeTM_four_mem_t2Span`, `heckeLattice_le_sup_t3`,
  `quotient_generated`, `t2Span_le_heckeLattice`): at `n ≤ 4` and `k ≥ 1`
  every generator `T_{j+1}` of `𝕋` lies in `t2Span T2 n ⊔ span ℤ {T₃}`
  (the blueprint's `quotient_span_of_le_four`), the quotient is generated
  by `T₃` in the `∃ z, x − z • T₃ ∈ ℤ[T₂]` form, and `t2Span ≤ 𝕋`
  (powers of `T₂` lie in the Hecke ring).
* **Order bridge** (`order_minimal`): the witness identity
  `∑ N_j T₂^j = D • T₃` with a Bézout reduction `∑ e_j N_j + c D = 1`
  (the landed `hbez` shape) makes `D` the exact order of `[T₃]`: every
  `d` with `d • T₃ ∈ ℤ[T₂]` satisfies `D ∣ d` (cross-multiplication +
  `linearIndependent_pow`, the `den_dvd_index` pattern).
* **Packaging** (`D_eq_Ik_of_cyclic`): cyclicity + `D • T₃ ∈ ℤ[T₂]` +
  `Nat.card G = I_k.natAbs` + the landed `D ∣ I_k` + positivity give
  `D = I_k`.  Minimality is deliberately off this critical path —
  `I_k ∣ D` comes from the surjection alone.
* **The iff** (`heckeLattice_eq_t2Span_iff`): `𝕋 = ℤ[T₂] ↔ Nat.card G = 1`;
  at `n = 2` the equality is unconditional (`heckeLattice_eq_t2Span_two`:
  both lattices are `span {1, T₂}`), giving `𝕋 = ℤ[T₂]` at the six dim-2
  weights with no index input at all.

Everything is light: no `set_option`, no kernel decides (the per-weight
instantiations in `HeckeCyclicWeights` carry those).
-/

namespace HeckeCyclic

open HeckeIndex HeckeTM MaedaLevelOne Polynomial
open UpperHalfPlane ModularForm CuspForm
open scoped MatrixGroups

/-! ### The generic group layer -/

section Group

variable {A : Type*} [AddCommGroup A]

/-- The multiple-of-a-point hom `ℤ →+ A`, `z ↦ z • a`. -/
def zmulHom (a : A) : ℤ →+ A where
  toFun z := z • a
  map_zero' := zero_zsmul a
  map_add' z₁ z₂ := add_smul z₁ z₂ a

/-- **Cardinality divisibility from a cyclic generator** (FINDINGS F5).
If the quotient `L ⧸ (N ⊓ L)` is generated by the class of `t` (every
`x ∈ L` agrees with a multiple of `t` modulo `N`) and `D • t ∈ N` with
`0 < D`, then `Nat.card (L ⧸ N.addSubgroupOf L) ∣ D`: the hom
`ZMod D →+ L ⧸ N.addSubgroupOf L`, `1 ↦ [t]` (`ZMod.lift` through
`zmulHom`), is surjective, and Lagrange on its kernel writes
`D = |quotient| · |kernel|`. -/
theorem card_dvd_of_generator {L N : AddSubgroup A} {t : A}
    (htL : t ∈ L) (D : ℕ)
    (hDt : (D : ℤ) • t ∈ N) (hgen : ∀ x ∈ L, ∃ z : ℤ, x - z • t ∈ N) :
    Nat.card (L ⧸ N.addSubgroupOf L) ∣ D := by
  -- the hom `φ : ℤ →+ G` generated by the class of `t`, and `φ D = 0`
  have hφD : zmulHom (((⟨t, htL⟩ : L) : L ⧸ N.addSubgroupOf L)) (D : ℤ) = 0 := by
    change ((D : ℤ) • ((⟨t, htL⟩ : L) : L ⧸ N.addSubgroupOf L)) = 0
    rw [← QuotientAddGroup.mk_zsmul, QuotientAddGroup.eq_zero_iff]
    refine AddSubgroup.mem_addSubgroupOf.mpr ?_
    change (D : ℤ) • t ∈ N
    exact hDt
  set F : ZMod D →+ L ⧸ N.addSubgroupOf L :=
    ZMod.lift D ⟨zmulHom (((⟨t, htL⟩ : L) : L ⧸ N.addSubgroupOf L)), hφD⟩ with hFdef
  -- `F` on integers is the multiple-of-class map
  have hFcoe : ∀ z : ℤ, F ((z : ℤ) : ZMod D)
      = ((z • (⟨t, htL⟩ : L) : L) : L ⧸ N.addSubgroupOf L) := by
    intro z
    rw [hFdef, ZMod.lift_coe]
    rfl
  -- `F` is surjective: every class is a multiple of the class of `t`
  have hFsurj : Function.Surjective F := by
    intro w
    obtain ⟨x, rfl⟩ := QuotientAddGroup.mk'_surjective (N.addSubgroupOf L) w
    obtain ⟨z, hz⟩ := hgen x.val x.2
    refine ⟨(z : ℤ), ?_⟩
    rw [hFcoe, QuotientAddGroup.mk'_apply, QuotientAddGroup.eq]
    refine AddSubgroup.mem_addSubgroupOf.mpr ?_
    change -(z • t) + x.val ∈ N
    have hconv : -(z • t) + x.val = x.val - z • t := by abel
    rw [hconv]
    exact hz
  -- Lagrange on the kernel of `F`, with the kernel quotient identified with `G`
  have hqc : Nat.card (ZMod D ⧸ AddMonoidHom.ker F)
      = Nat.card (L ⧸ N.addSubgroupOf L) :=
    Nat.card_congr (QuotientAddGroup.quotientKerEquivOfSurjective F hFsurj).toEquiv
  have hsplit : Nat.card (ZMod D)
      = Nat.card (ZMod D ⧸ AddMonoidHom.ker F) * Nat.card (AddMonoidHom.ker F) :=
    AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup _
  have hcardZ : Nat.card (ZMod D) = D := Nat.card_zmod D
  refine ⟨Nat.card (AddMonoidHom.ker F), ?_⟩
  rw [← hqc, ← hsplit]
  exact hcardZ.symm

/-- **Trivial-quotient criterion**: `Nat.card (L ⧸ N.addSubgroupOf L) = 1`
iff `L = N` (for `N ≤ L`). -/
theorem card_quotient_eq_one_iff {L N : AddSubgroup A} (hNL : N ≤ L) :
    Nat.card (L ⧸ N.addSubgroupOf L) = 1 ↔ L = N := by
  rw [show Nat.card (L ⧸ N.addSubgroupOf L) = (N.addSubgroupOf L).index from rfl,
    AddSubgroup.index_eq_one, AddSubgroup.addSubgroupOf_eq_top]
  exact ⟨fun h => le_antisymm h hNL, fun h => le_of_eq h⟩

end Group

/-! ### The `ℤ[T₂]` span and the cyclicity at `n ≤ 4` -/

section Span

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- The polynomial span `ℤ[T₂] = span ℤ {T₂^j : j < n}` (the blueprint b1
contract form of `HeckeLatticeIndex.t2Lattice`; definitionally identical
so adoption is a `rfl`). -/
noncomputable def t2Span (T2 : Module.End ℂ V) (n : ℕ) :
    Submodule ℤ (Module.End ℂ V) :=
  Submodule.span ℤ (Set.range fun j : Fin n => T2 ^ (j : ℕ))

/-- Every power `T₂^j`, `j < n`, lies in the span. -/
theorem pow_mem_t2Span (T2 : Module.End ℂ V) (n : ℕ) {j : ℕ} (hj : j < n) :
    T2 ^ j ∈ t2Span T2 n :=
  Submodule.subset_span ⟨⟨j, hj⟩, rfl⟩

/-- `T₄ = T₂² − 2^{k−1}·T₁` lies in the polynomial span once `T₂²` does:
the `T₂` two-term relation at `m = 2`, as a lattice-membership fact. -/
theorem heckeTM_four_mem_t2Span {k : ℤ} (hk : 1 ≤ k)
    (T2 : Module.End ℂ (CuspForm 𝒮ℒ k)) (hT2 : T2 = heckeTM k 2) {n : ℕ}
    (h2n : 2 < n) : heckeTM k 4 ∈ t2Span T2 n := by
  obtain ⟨e, he⟩ : ∃ e : ℕ, k - 1 = (e : ℤ) := ⟨(k - 1).toNat, by omega⟩
  obtain ⟨c, hc⟩ : ∃ c : ℕ, ((2 : ℂ) ^ (k - 1)) = ((c : ℕ) : ℂ) := by
    refine ⟨2 ^ e, ?_⟩
    rw [he, zpow_natCast]
    exact (Nat.cast_pow 2 e).symm
  have h := heckeTM_two_mul_even (k := k) (m := 2) (dvd_refl 2)
  rw [show (2 : ℕ) * 2 = 4 from by decide, show (2 : ℕ) / 2 = 1 from by decide, hc,
    Nat.cast_smul_eq_nsmul ℂ] at h
  -- `h : T₂ ∘ T₂ = T₄ + c • T₁`
  have hB : heckeTM k 4 = T2 ^ 2 - (c : ℕ) • heckeTM k 1 := by
    rw [pow_two, Module.End.mul_eq_comp, hT2, h]
    abel
  rw [hB]
  refine Submodule.sub_mem _ (pow_mem_t2Span T2 n h2n) ?_
  rw [heckeTM_id, show (LinearMap.id : Module.End ℂ (CuspForm 𝒮ℒ k))
      = T2 ^ (0 : ℕ) from by rw [pow_zero, Module.End.one_eq_id]]
  exact Submodule.smul_of_tower_mem _ c (pow_mem_t2Span T2 n (by omega))

/-- **Cyclicity at `n ≤ 4` (lattice form; the blueprint's
`quotient_span_of_le_four`).**  For `k ≥ 1` and `n ≤ 4`, every generator
of the Hecke lattice `𝕋 = span ℤ {T_1, …, T_n}` lies in
`t2Span T2 n ⊔ span ℤ {T₃}`. -/
theorem heckeLattice_le_sup_t3 {k : ℤ} (hk : 1 ≤ k)
    (T2 T3 : Module.End ℂ (CuspForm 𝒮ℒ k)) (hT2 : T2 = heckeTM k 2)
    (hT3 : T3 = heckeTM k 3) {n : ℕ} (hn : n ≤ 4) :
    heckeLattice k n ≤ t2Span T2 n ⊔ Submodule.span ℤ ({T3} :
      Set (Module.End ℂ (CuspForm 𝒮ℒ k))) := by
  have hT1 : heckeTM k 1 = T2 ^ (0 : ℕ) := by
    rw [heckeTM_id, pow_zero, Module.End.one_eq_id]
  have hT2' : heckeTM k 2 = T2 ^ (1 : ℕ) := by
    rw [pow_one]; exact hT2.symm
  rw [show heckeLattice k n = Submodule.span ℤ
      (Set.range fun j : Fin n => heckeTM k (j.val + 1)) from rfl,
    Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  change heckeTM k (j.val + 1) ∈ (t2Span T2 n ⊔ Submodule.span ℤ ({T3} :
    Set (Module.End ℂ (CuspForm 𝒮ℒ k))))
  have hjn := j.isLt
  rcases (by omega : j.val + 1 = 1 ∨ j.val + 1 = 2 ∨ j.val + 1 = 3
    ∨ j.val + 1 = 4) with hm | hm | hm | hm
  · rw [hm, hT1]
    exact Submodule.mem_sup_left (pow_mem_t2Span T2 n (by omega))
  · rw [hm, hT2']
    exact Submodule.mem_sup_left (pow_mem_t2Span T2 n (by omega))
  · rw [hm, ← hT3]
    exact Submodule.mem_sup_right (Submodule.subset_span rfl)
  · rw [hm]
    exact Submodule.mem_sup_left (heckeTM_four_mem_t2Span hk T2 hT2 (by omega))

/-- **Cyclicity at `n ≤ 4` (generator form).**  Every element of `𝕋` agrees
with an integer multiple of `T₃` modulo `ℤ[T₂]` — the quotient
`𝕋 ⧸ ℤ[T₂]` is generated by `[T₃]`. -/
theorem quotient_generated {k : ℤ} (hk : 1 ≤ k)
    (T2 T3 : Module.End ℂ (CuspForm 𝒮ℒ k)) (hT2 : T2 = heckeTM k 2)
    (hT3 : T3 = heckeTM k 3) {n : ℕ} (hn : n ≤ 4)
    (x : Module.End ℂ (CuspForm 𝒮ℒ k)) (hx : x ∈ heckeLattice k n) :
    ∃ z : ℤ, x - z • T3 ∈ t2Span T2 n := by
  obtain ⟨a, ha, b, hb, hxab⟩ :=
    Submodule.mem_sup.mp (heckeLattice_le_sup_t3 hk T2 T3 hT2 hT3 hn hx)
  rw [Submodule.mem_span_singleton] at hb
  obtain ⟨z, hz⟩ := hb
  refine ⟨z, ?_⟩
  rw [← hxab, hz, add_sub_cancel_right]
  exact ha

/-- `ℤ[T₂] ⊆ 𝕋`: the powers of `T₂` lie in the Hecke lattice (Miller
bundle hypotheses, as in `HeckeIndex.T2_pow_mem_heckeRing`). -/
theorem t2Span_le_heckeLattice {k : ℤ} (g : ℕ → CuspForm 𝒮ℒ k) {n : ℕ}
    (hn : 0 < n)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (hk : 1 ≤ k) (T2 : Module.End ℂ (CuspForm 𝒮ℒ k)) (hT2 : T2 = heckeTM k 2) :
    t2Span T2 n ≤ heckeLattice k n := by
  rw [show t2Span T2 n = Submodule.span ℤ
      (Set.range fun j : Fin n => T2 ^ (j : ℕ)) from rfl,
    Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  change T2 ^ (j : ℕ) ∈ heckeLattice k n
  rw [hT2]
  exact T2_pow_mem_heckeRing g hn hg hdim hδ hint hk j.val

end Span

/-! ### The order bridge -/

section Order

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- The powers `T₂^j`, `j < n`, are ℤ-linearly independent when the
minimal polynomial of `T₂` has degree `n` (ℂ-independence by
`linearIndependent_pow`, then `restrict_scalars'`). -/
theorem linearIndependent_pow_z (T2 : Module.End ℂ V) {n : ℕ}
    (hmin : (minpoly ℂ T2).natDegree = n) :
    LinearIndependent ℤ (fun j : Fin n => T2 ^ (j : ℕ)) := by
  have hC : LinearIndependent ℂ (fun j : Fin n => T2 ^ (j : ℕ)) := by
    have h := linearIndependent_pow (K := ℂ) T2
    rw [hmin] at h
    exact h
  exact LinearIndependent.restrict_scalars' ℤ hC

/-- **Order minimality** (the blueprint's `order_of_t3`, minimality half).
If the witness identity `∑_{j<n} N_j T₂^j = D • T₃` holds with a Bézout
reduction `∑ e_j N_j + c D = 1` (the landed `hbez` shape), then every `d`
with `d • T₃ ∈ ℤ[T₂]` satisfies `D ∣ d`: `D` is the exact order of
`[T₃]` in `𝕋 ⧸ ℤ[T₂]`.  Cross-multiplication plus coefficientwise
vanishing — the `den_dvd_index` pattern, over the lattice itself. -/
theorem order_minimal (T2 T3 : Module.End ℂ V) {n : ℕ}
    (hmin : (minpoly ℂ T2).natDegree = n)
    (N : ℕ → ℤ) (D : ℤ)
    (hident : ∑ j ∈ Finset.range n, ((N j : ℤ) : ℂ) • T2 ^ j = ((D : ℤ) : ℂ) • T3)
    (e : ℕ → ℤ) (c : ℤ)
    (hbez : ∑ j ∈ Finset.range n, e j * N j + c * D = 1)
    {d : ℤ} (hmem : (d : ℤ) • T3 ∈ t2Span T2 n) : D ∣ d := by
  obtain ⟨w, hw⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).mp hmem
  -- hw : ∑ i : Fin n, w i • T2^i = d • T3
  have hli := linearIndependent_pow_z T2 hmin
  -- the identity and the Bézout combination, on `Fin n`
  have hidentF : ∑ i : Fin n, ((N i.val : ℤ) : ℂ) • T2 ^ (i : ℕ)
      = ((D : ℤ) : ℂ) • T3 :=
    (Fin.sum_univ_eq_sum_range (fun j : ℕ => ((N j : ℤ) : ℂ) • T2 ^ j) n).trans hident
  have hbezF : ∑ i : Fin n, e i.val * N i.val + c * D = 1 := by
    rw [show (∑ i : Fin n, e i.val * N i.val) = ∑ j ∈ Finset.range n, e j * N j from
      Fin.sum_univ_eq_sum_range (fun j : ℕ => e j * N j) n]
    exact hbez
  -- the two rescalings of `d • (D • T₃)`
  have hdl : ((d : ℤ) : ℂ) • (((D : ℤ) : ℂ) • T3)
      = ∑ i : Fin n, (((d * N i.val : ℤ) : ℂ)) • T2 ^ (i : ℕ) := by
    rw [← hidentF, Finset.smul_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [smul_smul, ← Int.cast_mul]
  have hwC : ((d : ℤ) : ℂ) • T3
      = ∑ i : Fin n, (((w i : ℤ) : ℂ)) • T2 ^ (i : ℕ) := by
    rw [show ((d : ℤ) : ℂ) • T3 = (d : ℤ) • T3 from Int.cast_smul_eq_zsmul ℂ d T3, ← hw]
    exact Finset.sum_congr rfl fun i _ =>
      (Int.cast_smul_eq_zsmul ℂ (w i) (T2 ^ (i : ℕ))).symm
  have hdr : ((D : ℤ) : ℂ) • (((d : ℤ) : ℂ) • T3)
      = ∑ i : Fin n, (((D * w i : ℤ) : ℂ)) • T2 ^ (i : ℕ) := by
    rw [hwC, Finset.smul_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [smul_smul, ← Int.cast_mul]
  -- the zero ℤ-combination
  have hzeroZ : ∑ i : Fin n, ((d * N i.val - D * w i : ℤ)) • T2 ^ (i : ℕ) = 0 := by
    have hstep : ∀ i : Fin n, (((d * N i.val - D * w i : ℤ) : ℂ)) • T2 ^ (i : ℕ)
        = (((d * N i.val : ℤ) : ℂ)) • T2 ^ (i : ℕ)
          - (((D * w i : ℤ) : ℂ)) • T2 ^ (i : ℕ) := by
      intro i
      rw [Int.cast_sub, sub_smul]
    have hC : ∑ i : Fin n, (((d * N i.val - D * w i : ℤ) : ℂ)) • T2 ^ (i : ℕ) = 0 := by
      rw [Finset.sum_congr rfl fun i _ => hstep i, Finset.sum_sub_distrib, ← hdl, ← hdr,
        smul_comm, sub_self]
    have hconv : ∀ i : Fin n, ((d * N i.val - D * w i : ℤ)) • T2 ^ (i : ℕ)
        = (((d * N i.val - D * w i : ℤ) : ℂ)) • T2 ^ (i : ℕ) :=
      fun i => (Int.cast_smul_eq_zsmul ℂ _ _).symm
    rw [Finset.sum_congr rfl fun i _ => hconv i]
    exact hC
  have hcoef : ∀ i : Fin n, d * N i.val - D * w i = 0 :=
    fun i => Fintype.linearIndependent_iff.mp hli _ hzeroZ i
  have hDw : ∀ i : Fin n, d * N i.val = D * w i := fun i => sub_eq_zero.mp (hcoef i)
  -- the Bézout combination transfers the divisibility
  have hd1 : d = ∑ i : Fin n, e i.val * (D * w i) + c * (d * D) := by
    have hd : d = d * (∑ i : Fin n, e i.val * N i.val + c * D) := by
      rw [hbezF, mul_one]
    have hsplit : d * (∑ i : Fin n, e i.val * N i.val + c * D)
        = ∑ i : Fin n, e i.val * (d * N i.val) + c * (d * D) := by
      rw [mul_add, Finset.mul_sum]
      have hterm : ∑ i : Fin n, d * (e i.val * N i.val)
          = ∑ i : Fin n, e i.val * (d * N i.val) :=
        Finset.sum_congr rfl fun i _ => by ring
      rw [hterm, show d * (c * D) = c * (d * D) from by ring]
    have hlast : ∑ i : Fin n, e i.val * (d * N i.val)
        = ∑ i : Fin n, e i.val * (D * w i) :=
      Finset.sum_congr rfl fun i _ => by rw [hDw i]
    calc d = d * (∑ i : Fin n, e i.val * N i.val + c * D) := hd
      _ = ∑ i : Fin n, e i.val * (D * w i) + c * (d * D) := by rw [hsplit, hlast]
  have hsum : ∑ i : Fin n, e i.val * (D * w i) = D * ∑ i : Fin n, e i.val * w i := by
    rw [Finset.sum_congr rfl fun i _ => show e i.val * (D * w i)
      = D * (e i.val * w i) from by ring, Finset.mul_sum]
  refine ⟨∑ i : Fin n, e i.val * w i + c * d, ?_⟩
  calc d = ∑ i : Fin n, e i.val * (D * w i) + c * (d * D) := hd1
    _ = D * (∑ i : Fin n, e i.val * w i + c * d) := by rw [hsum]; ring

end Order

/-! ### The Hecke packaging -/

section Hecke

open HeckeIndex

variable {k : ℤ} {n : ℕ}

/-- **The equality `D = I_k`** (the blueprint's `D_eq_Ik`, generic form).
At `n ≤ 4`: cyclicity of `𝕋 ⧸ ℤ[T₂]` (from `heckeTM_mul`) plus
`D • T₃ ∈ ℤ[T₂]` give `I_k ∣ D` (the surjection `ZMod D →+ G`); with the
landed `D ∣ I_k` and positivity of both, `D = I_k`.  The `hcard`
hypothesis is the index cardinality (b1's `index_eq_natCard`). -/
theorem D_eq_Ik_of_cyclic (hk : 1 ≤ k) (hn : 0 < n) (hn4 : n ≤ 4)
    (g : ℕ → CuspForm 𝒮ℒ k)
    (hg : LinearIndependent ℂ (fun i : Fin n => g i.val))
    (hdim : Module.finrank ℂ (CuspForm 𝒮ℒ k) = n)
    (hδ : ∀ j m : ℕ, j < n → m < n →
      (qExpansion 1 (g j)).coeff (m + 1) = if m = j then 1 else 0)
    (hint : ∀ j m : ℕ, j < n → ∃ z : ℤ, (qExpansion 1 (g j)).coeff m = (z : ℂ))
    (T2 T3 : Module.End ℂ (CuspForm 𝒮ℒ k)) (hT2 : T2 = heckeTM k 2)
    (hT3 : T3 = heckeTM k 3) (D Ik : ℤ) (hD : 0 < D) (hIk : 0 < Ik)
    (hDt : ((D : ℤ) : ℂ) • T3 ∈ t2Span T2 n)
    (hdvd : D ∣ Ik)
    (hcard : Nat.card ((heckeLattice k n).toAddSubgroup ⧸
      (t2Span T2 n).toAddSubgroup.addSubgroupOf (heckeLattice k n).toAddSubgroup)
      = Ik.natAbs) :
    D = Ik := by
  have htL : T3 ∈ (heckeLattice k n).toAddSubgroup := by
    rw [hT3]
    exact heckeTM_mem_lattice g hn hg hdim hδ hint 3 (by norm_num)
  have hDtn : ((D.toNat : ℕ) : ℤ) • T3 ∈ (t2Span T2 n).toAddSubgroup := by
    have e0 : ((D : ℤ) : ℂ) • T3 = (D : ℤ) • T3 := Int.cast_smul_eq_zsmul ℂ D T3
    have e1 : ((D.toNat : ℕ) : ℤ) = D := Int.toNat_of_nonneg hD.le
    rw [e1, ← e0]
    exact hDt
  have hgen : ∀ x ∈ (heckeLattice k n).toAddSubgroup,
      ∃ z : ℤ, x - z • T3 ∈ (t2Span T2 n).toAddSubgroup :=
    fun x hx => quotient_generated hk T2 T3 hT2 hT3 hn4 x hx
  have hraw := card_dvd_of_generator htL D.toNat hDtn hgen
  rw [hcard] at hraw
  -- mutual divisibility with positivity
  have hDn : D.toNat = D.natAbs := by
    have e1 : ((D.toNat : ℕ) : ℤ) = D := Int.toNat_of_nonneg hD.le
    have e2 : ((D.natAbs : ℕ) : ℤ) = D := Int.natAbs_of_nonneg hD.le
    exact Int.ofNat.inj (e1.trans e2.symm)
  rw [hDn] at hraw
  have h3 : D.natAbs ∣ Ik.natAbs := by
    obtain ⟨q, hq⟩ := hdvd
    exact ⟨q.natAbs, by rw [hq, Int.natAbs_mul]⟩
  have h2 : Ik.natAbs = D.natAbs := Nat.dvd_antisymm hraw h3
  calc D = ((D.natAbs : ℕ) : ℤ) := (Int.natAbs_of_nonneg hD.le).symm
    _ = ((Ik.natAbs : ℕ) : ℤ) := by exact_mod_cast h2.symm
    _ = Ik := Int.natAbs_of_nonneg hIk.le

/-- **The iff** (the blueprint's `heckeLattice_eq_t2Lattice_iff`):
`𝕋 = ℤ[T₂]` (as submodules) iff the index cardinality is `1`. -/
theorem heckeLattice_eq_t2Span_iff (T2 : Module.End ℂ (CuspForm 𝒮ℒ k))
    (c : ℕ) (hsub : t2Span T2 n ≤ heckeLattice k n)
    (hcard : Nat.card ((heckeLattice k n).toAddSubgroup ⧸
      (t2Span T2 n).toAddSubgroup.addSubgroupOf (heckeLattice k n).toAddSubgroup)
      = c) :
    heckeLattice k n = t2Span T2 n ↔ c = 1 := by
  rw [← hcard, iff_comm]
  exact (card_quotient_eq_one_iff
    ((Submodule.toAddSubgroup_le _ _).mpr hsub)).trans
    Submodule.toAddSubgroup_injective.eq_iff

/-- **The dim-2 equality**: `𝕋 = ℤ[T₂]` at `n = 2` unconditionally — both
lattices are `span ℤ {1, T₂}` (`T₁ = 1`).  No index, no minimal
polynomial, no Miller data. -/
theorem heckeLattice_eq_t2Span_two (T2 : Module.End ℂ (CuspForm 𝒮ℒ k))
    (hT2 : T2 = heckeTM k 2) : heckeLattice k 2 = t2Span T2 2 := by
  apply le_antisymm
  · rw [show heckeLattice k 2 = Submodule.span ℤ
      (Set.range fun j : Fin 2 => heckeTM k (j.val + 1)) from rfl,
    Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    change heckeTM k (j.val + 1) ∈ t2Span T2 2
    have hjn := j.isLt
    have hj : j.val = 0 ∨ j.val = 1 := by omega
    rcases hj with h0 | h1
    · rw [h0, show ((0 : ℕ) + 1) = 1 from rfl, heckeTM_id,
        show (LinearMap.id : Module.End ℂ (CuspForm 𝒮ℒ k)) = T2 ^ (0 : ℕ) from by
          rw [pow_zero, Module.End.one_eq_id]]
      exact pow_mem_t2Span T2 2 (by omega)
    · rw [h1, show ((1 : ℕ) + 1) = 2 from rfl, ← hT2]
      have hmem : (T2 : Module.End ℂ (CuspForm 𝒮ℒ k)) ^ (1 : ℕ) ∈ t2Span T2 2 :=
        pow_mem_t2Span T2 2 (by omega)
      rwa [pow_one] at hmem
  · rw [show t2Span T2 2 = Submodule.span ℤ
      (Set.range fun j : Fin 2 => T2 ^ (j : ℕ)) from rfl, Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    change T2 ^ (j : ℕ) ∈ heckeLattice k 2
    have hjn := j.isLt
    have hj : j.val = 0 ∨ j.val = 1 := by omega
    rcases hj with h0 | h1
    · rw [h0, pow_zero, Module.End.one_eq_id, ← heckeTM_id]
      exact Submodule.subset_span ⟨(0 : Fin 2), rfl⟩
    · rw [h1, pow_one, hT2]
      exact Submodule.subset_span ⟨(1 : Fin 2), rfl⟩

end Hecke

