import MathProof.Tau.LehmerPacked
import MathProof.Tau.LehmerUnbounded

/-!
# Lehmer nonvanishing past the 65536 wall — via Mordell

Iteration 6 kernel-verified `τ n ≠ 0` for `n ≤ 65536` and could not go past
(the packed-bignum slot base saturates; the 65536 decide itself needs ~63 GiB
of kernel heap).  Mordell's theorem (Iteration 7) makes the wall disappear:
nonvanishing is multiplicative over coprime factors, so Iteration 6's finite
verification certifies `τ n ≠ 0` on the *infinite* multiplicative semigroup
generated by the verified prime powers.

This module is the one-line instantiation of the light parametric theorem
`Ramanujan.tau_ne_zero_of_forall_prime_pow` (file `LehmerUnbounded.lean`) at
`B = 65536`.  Like `LehmerPacked`, it is **not** in the default/CI targets —
it imports the heavy kernel-decide module — and is verified on Modal.
-/

open Ramanujan

namespace Ramanujan

/-- **Lehmer nonvanishing on an unbounded index set, at `B = 65536`**: `τ n ≠ 0`
for every `n ≥ 1` all of whose prime-power divisors `p ^ a` are at most 65536.
Covers, for example, every squarefree product of the 6542 primes up to 65536 —
indices with up to 28 305 digits. -/
theorem tau_ne_zero_of_prime_pow_le_65536 {n : ℕ} (hn : 0 < n)
    (hmax : ∀ p a : ℕ, p.Prime → 0 < a → p ^ a ∣ n → p ^ a ≤ 65536) : tau n ≠ 0 :=
  tau_ne_zero_of_forall_prime_pow (fun _m h1 h2 => tau_ne_zero_of_le_65536 h1 h2) hn hmax

/-- The first index past the old wall: `τ(65519 · 65521) = τ 4292870399 ≠ 0`.
Both prime-power divisors are `≤ 65536` (verified by Iteration 6), but the
index `4 292 870 399` is 65 000 past it — unreachable by any direct kernel
computation at this slot base, free after Mordell. -/
theorem tau_of_65519_mul_65521_ne_zero : tau 4292870399 ≠ 0 := by
  refine tau_ne_zero_of_prime_pow_le_65536 (by norm_num) ?_
  intro p a hp ha hdvd
  have hq19 : (65519 : ℕ).Prime := by norm_num
  have hq21 : (65521 : ℕ).Prime := by norm_num
  have hpm : p ∣ 65519 * 65521 := (dvd_pow_self p ha.ne').trans hdvd
  rcases hp.dvd_mul.mp hpm with h | h
  · have hp19 : p = 65519 := by
      rcases hq19.eq_one_or_self_of_dvd p h with h1 | h2
      · exact absurd h1 hp.ne_one
      · exact h2
    have hcop : (p ^ a).Coprime 65521 :=
      ((Nat.coprime_primes hp hq21).mpr (by rw [hp19]; decide)).pow_left a
    have hdvd19 : p ^ a ∣ 65519 := hcop.dvd_of_dvd_mul_right hdvd
    have := Nat.le_of_dvd (by decide) hdvd19
    omega
  · have hp21 : p = 65521 := by
      rcases hq21.eq_one_or_self_of_dvd p h with h1 | h2
      · exact absurd h1 hp.ne_one
      · exact h2
    have hcop : (p ^ a).Coprime 65519 :=
      ((Nat.coprime_primes hp hq19).mpr (by rw [hp21]; decide)).pow_left a
    have hdvd21 : p ^ a ∣ 65521 := hcop.dvd_of_dvd_mul_left hdvd
    have := Nat.le_of_dvd (by decide) hdvd21
    omega

end Ramanujan
